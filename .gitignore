*.cdx.json

# ===== Archives =====
*.zip
*.tar.gz

# ===== Backup / temp source files =====
*.bak
*.bak-*
*.bak_*
*.before-*
*.before_*
.attic/
.architecture-security-backup-*/

# ===== PAYG migration backups — local only, never commit =====
.payg-*-backup-*/
.payg-*-backup-*/*.patch
.payg-scratch-*/
.payg-scratch-*.patch
.pingvertex-*-backup-*/
.pingvertex-repair*/

# ===== Python =====
__pycache__/
*.pyc

# ===== Stray files =====
get_constraint.sql

# Agent mTLS private keys (runtime-injected, never committed)
secrets/

# ===== Additional cleanup patterns =====
# Matches e.g. style.css.bak.20260915-232413 (uses .bak. rather than .bak- or .bak_)
*.bak.*
# UI backup dirs (e.g. .proxy-ui-backup-YYYYMMDD-HHMMSS)
.proxy-ui-backup-*/
# Scratch part directories
.scratch/
