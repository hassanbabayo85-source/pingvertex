+#[tokio::test]
+async fn verify_email_otp_e2e_registers_verifies_and_activates_user() {
+    let (app, user_repository, mailer) = build_test_app_with_email_verification();
+    let (username, email) = unique_user();
+
+    let register = post(
+        &app,
+        "/api/v1/auth/register",
+        register_payload(&username, &email, STRONG_PASSWORD),
+    )
+    .await;
+    assert_eq!(register.status(), StatusCode::CREATED);
+    assert!(register.headers().get(SET_COOKIE).is_none());
+
+    let before = user_repository
+        .find_by_email(&domain::Email::new(&email).unwrap())
+        .await
+        .unwrap()
+        .unwrap();
+    assert_eq!(before.status(), UserStatus::PendingVerification);
+    assert!(!before.is_email_verified());
+
+    let pending_login = post(
+        &app,
+        "/api/v1/auth/login",
+        login_payload(&email, STRONG_PASSWORD),
+    )
+    .await;
+    assert_eq!(pending_login.status(), StatusCode::BAD_REQUEST);
+    assert!(pending_login.headers().get(SET_COOKIE).is_none());
+    assert_eq!(read_json(pending_login).await["message"], "email verification required");
+
+    let code = mailer.latest_code();
+    assert_eq!(code.len(), 6);
+    assert!(code.bytes().all(|b| b.is_ascii_digit()));
+
+    let verify = post(
+        &app,
+        "/api/v1/auth/verify-email-otp",
+        json!({ "email": email, "code": code }),
+    )
+    .await;
+    assert_eq!(verify.status(), StatusCode::OK);
+    assert_eq!(read_json(verify).await["verified"], true);
+
+    let after = user_repository
+        .find_by_email(&domain::Email::new(&email).unwrap())
+        .await
+        .unwrap()
+        .unwrap();
+    assert_eq!(after.status(), UserStatus::Active);
+    assert!(after.is_email_verified());
+
+    let login = post(
+        &app,
+        "/api/v1/auth/login",
+        login_payload(&email, STRONG_PASSWORD),
+    )
+    .await;
+    assert_eq!(login.status(), StatusCode::OK);
+    assert!(login.headers().get(SET_COOKIE).is_some());
+}
