+struct CapturingVerificationMailer {
+    codes: Arc<std::sync::Mutex<Vec<String>>>,
+}
+
+#[async_trait]
+impl EmailVerificationMailer for CapturingVerificationMailer {
+    async fn send_verification_email(
+        &self,
+        _to: &domain::Email,
+        raw_token: &str,
+    ) -> Result<(), Box<dyn std::error::Error + Send + Sync>> {
+        self.codes.lock().unwrap().push(raw_token.to_string());
+        Ok(())
+    }
+}
+
+impl CapturingVerificationMailer {
+    fn latest_code(&self) -> String {
+        self.codes
+            .lock()
+            .unwrap()
+            .last()
+            .cloned()
+            .expect("verification email should have been sent")
+    }
+}
