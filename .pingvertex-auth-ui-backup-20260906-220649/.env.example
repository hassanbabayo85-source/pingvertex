# Copy this file to `.env` for local development:
#   cp .env.example .env
#
# `docker-compose.yml` reads POSTGRES_PASSWORD / GF_SECURITY_ADMIN_PASSWORD
# from your shell environment or this `.env` file (docker compose loads
# `.env` automatically for variable interpolation — this is separate from
# the `env_file: .env` lines inside the compose file, which only affect
# variables *inside* the api/worker/agent containers).
#
# If you don't set these, docker-compose.yml falls back to the
# well-known, publicly-documented dev defaults `postgres` / `admin`. That
# is fine for a laptop-only local stack, but:
#
#   ⚠️  NEVER deploy with only `docker-compose.yml`. Production MUST use:
#     docker compose -f docker-compose.yml -f docker-compose.prod.yml up -d
#   `docker-compose.prod.yml` refuses to boot if these are left unset —
#   it has no insecure fallback. This file/`.env` is for local dev only.

# --- Database ---
# Local dev default if unset: postgres
POSTGRES_PASSWORD=postgres

# --- Grafana ---
# Local dev default if unset: admin
GF_SECURITY_ADMIN_PASSWORD=admin

# --- Worker metrics endpoint auth (no insecure default — always required) ---
METRICS_TOKEN=change-me-local-dev-token

# --- SSRF guard (leave unset for normal use) ---
# Only ever set this to "true" together with ENVIRONMENT=development (or
# dev/test/local) for local testing against services on your Docker
# network (e.g. a mock target container). `validate_production_ssrf_config`
# now refuses to boot if PINGVERTEX_SSRF_ALLOW_PRIVATE=true and ENVIRONMENT
# is not explicitly one of those values — including when ENVIRONMENT is
# simply unset. See crates/shared/src/ssrf.rs.
# ENVIRONMENT=development
# PINGVERTEX_SSRF_ALLOW_PRIVATE=false
