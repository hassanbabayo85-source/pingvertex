    "uuid",
    "chrono",
    "macros"
] }

# --- Notification adapters ---
# SMTP email delivery (SmtpEmailNotificationService). tokio1-rustls-tls
# keeps us on the same TLS stack (rustls, no OpenSSL/system-cert dependency)
# as `worker`'s reqwest client below, for a consistent, easy-to-build-in-Docker
# TLS story across the whole workspace.
lettre = { version = "0.11", default-features = false, features = [
    "tokio1-rustls-tls",
    "smtp-transport",
    "builder",
] }
# Outbound webhook HTTP calls (WebhookNotificationService). Identical
# feature set to `crates/worker`'s reqwest, since both send SSRF-checked,
# DNS-pinned requests to user-supplied URLs via `shared::ssrf` and should
# behave identically (same TLS stack, same compression support).
reqwest = { version = "0.12", default-features = false, features = [
    "rustls-tls",
    "http2",
    "charset",
    "json",
    "gzip",
    "brotli",
    "zstd",
] }
# HMAC-SHA256 webhook payload signing (X-Webhook-Signature header).
hmac = "0.12"
sha2 = "0.10"
hex = "0.4"

# --- Status page: custom domain TXT-record ownership verification ---
hickory-resolver = "0.26.1"

# --- Status page: public endpoint response caching (Redis) ---
redis = { version = "1.5.0", features = ["tokio-comp", "connection-manager"] }

# --- Logo upload: S3-compatible object storage (S3LogoStorage) ---
# rustls-only, matching the rest of the workspace TLS policy.
rust-s3 = { version = "0.37.2", default-features = false, features = ["tokio-rustls-tls"] }
aes-gcm = { version = "0.10", features = ["zeroize"] }

[dev-dependencies]
serial_test = "3.1"
