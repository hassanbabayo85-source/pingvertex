<file path="migrations/0045_add_monitor_consecutive_counters.sql">
-- B23: Incident State Machine — consecutive failure/success tracking.
--
-- These counters live on `monitors` (not `incidents`) because they must
-- persist across the open/resolved boundary: e.g. a monitor recovers
-- (incident resolves, consecutive_successes resets) then starts failing
-- again — the new failure streak has nothing to do with the old,
-- already-closed incident row.
--
-- `record_check_outcome` (see PostgresMonitorRepository) updates these
-- atomically in a single UPDATE ... RETURNING, so concurrent check
-- results for the same monitor never read a stale count.
ALTER TABLE monitors
    ADD COLUMN IF NOT EXISTS consecutive_failures INTEGER NOT NULL DEFAULT 0;

ALTER TABLE monitors
    ADD COLUMN IF NOT EXISTS consecutive_successes INTEGER NOT NULL DEFAULT 0;
</file>

<file path="migrations/0046_add_incident_last_seen_at.sql">
-- B23: Incident State Machine — last_seen_at tracking.
--
-- `started_at` (existing column) never changes after an incident opens.
-- `last_seen_at` is advanced every time a failing check is evaluated
-- while the incident is still open, so the gap between the two reflects
-- how long the underlying problem has continued to reproduce.
ALTER TABLE incidents
    ADD COLUMN IF NOT EXISTS last_seen_at TIMESTAMPTZ;
</file>

<file path="migrations/0047_create_notification_outbox.sql">
-- B25 — Notification Outbox (Reliability Layer).
--
-- Stores notifications that must be delivered reliably. The actual
-- channel senders are intentionally NOT implemented in B25; this table
-- gives later workers (B26/B27) a durable queue to replace the
-- stub sender's no-op behavior.

CREATE TABLE IF NOT EXISTS notification_outbox (
    id UUID PRIMARY KEY,
    channel_id UUID NOT NULL REFERENCES notification_channels(id) ON DELETE CASCADE,
    event_kind TEXT NOT NULL,
    payload TEXT NOT NULL,
    idempotency_key TEXT NOT NULL UNIQUE,
    status TEXT NOT NULL DEFAULT 'pending'
        CHECK (status IN ('pending', 'processing', 'sent', 'failed')),
    attempts INTEGER NOT NULL DEFAULT 0 CHECK (attempts >= 0),
    retry_at TIMESTAMPTZ NOT NULL DEFAULT now(),
    processing_started_at TIMESTAMPTZ,
    error TEXT,
    created_at TIMESTAMPTZ NOT NULL DEFAULT now(),
    updated_at TIMESTAMPTZ NOT NULL DEFAULT now()
);

CREATE INDEX IF NOT EXISTS idx_notification_outbox_pending_retry
    ON notification_outbox (status, retry_at)
    WHERE status = 'pending';

CREATE INDEX IF NOT EXISTS idx_notification_outbox_processing_started
    ON notification_outbox (status, processing_started_at)
    WHERE status = 'processing';
</file>

<file path="migrations/0048_add_performance_indexes.sql">
-- B35 — PostgreSQL Performance Audit.

-- Fills specific gaps found during the audit. This is performance-only:
-- no data model or business-rule changes.

-- audit_log is tenant-scoped in application code (`list_by_tenant`) but
-- had no index on tenant_id. Also covers the append-only history view
-- sorted by created_at.
CREATE INDEX IF NOT EXISTS idx_audit_log_tenant_id
    ON audit_log (tenant_id);

CREATE INDEX IF NOT EXISTS idx_audit_log_actor_user_created_at
    ON audit_log (actor_user_id, created_at DESC);

-- `IncidentRepository::list_open_unacknowledged` is used by the
-- escalation worker and filters exactly these two NULL conditions while
-- ordering by started_at. The old `idx_incidents_resolved_at` could only
-- help with the `resolved_at IS NULL` half of that predicate.
CREATE INDEX IF NOT EXISTS idx_incidents_open_unacknowledged
    ON incidents (started_at ASC)
    WHERE resolved_at IS NULL AND acknowledged_at IS NULL;

-- `MaintenanceWindowRepository::list_active_by_monitor` filters by
-- monitor_id plus a time window. Previously there was no monitor_id
-- index on this table (only tenant_id), so every check-result evaluation
-- for a monitor could force a table scan.
CREATE INDEX IF NOT EXISTS idx_maintenance_windows_monitor_starts
    ON maintenance_windows (monitor_id, starts_at DESC);

-- `TenantRepository::find_by_owner_user_id` had no index.
CREATE INDEX IF NOT EXISTS idx_tenants_owner_user_id
    ON tenants (owner_user_id);

-- Known B34 issue: `find_all_referencing_monitor` uses the JSONB
-- containment operator `monitor_ids @> $1`. A GIN index turns that from
-- a sequential scan into an index scan. Performance-only follow-up.
CREATE INDEX IF NOT EXISTS idx_status_pages_monitor_ids_gin
    ON status_pages USING GIN (monitor_ids);
</file>

<file path="migrations/0049_add_billing_webhook_idempotency_status.sql">
-- B36 — Billing Webhook Idempotency hardening.
--
-- Prior to this migration `billing_webhook_idempotency` only recorded
-- that an event id had been seen. If subscription/audit processing
-- failed AFTER the row was inserted, the row stayed forever, and a
-- provider retry with the same event id was silently ignored — losing
-- the event permanently.
--
-- This adds a small state machine so retries after a failed processing
-- attempt can be reclaimed:
--   pending    -> processing -> processed
--   processing -> pending     (on application-level failure)
--   processing -> processing  (reclaimed only after a stale timeout)
--
-- `processed` is terminal. `processing_started_at` is the stale lease
-- timestamp used by `try_claim`.
ALTER TABLE billing_webhook_idempotency
    ADD COLUMN IF NOT EXISTS status TEXT NOT NULL DEFAULT 'pending'
        CHECK (status IN ('pending', 'processing', 'processed')),
    ADD COLUMN IF NOT EXISTS processing_started_at TIMESTAMPTZ,
    ADD COLUMN IF NOT EXISTS processed_at TIMESTAMPTZ;

CREATE INDEX IF NOT EXISTS idx_billing_webhook_idempotency_processing
    ON billing_webhook_idempotency (processing_started_at)
    WHERE status = 'processing';
</file>

<file path="migrations/0050_create_pricing_configs.sql">
CREATE TABLE pricing_configs (
    id UUID PRIMARY KEY,
