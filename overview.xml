<file path="migrations/0038_create_subscriptions.sql">
-- Subscriptions map a tenant to its current plan tier (B11 — Plan /
-- Subscription / Entitlement model).
--
-- Deliberately minimal: no trial/grace-period/expiry/cancellation
-- columns here — that lifecycle belongs to a later worker (B12), which
-- will ALTER this table when it needs to. A tenant with no row here is
-- resolved as being on the Free plan by `ResolveEntitlementsUseCase`
-- (application layer), not by a default row inserted here, so no
-- backfill is needed for existing tenants.
CREATE TABLE subscriptions (
    id UUID PRIMARY KEY,
    tenant_id UUID NOT NULL REFERENCES tenants(id) ON DELETE CASCADE,
    plan_tier TEXT NOT NULL,
    created_at TIMESTAMPTZ NOT NULL DEFAULT now(),
    updated_at TIMESTAMPTZ NOT NULL DEFAULT now(),

    CONSTRAINT chk_subscriptions_plan_tier
        CHECK (plan_tier IN ('free', 'tier_1', 'tier_5', 'tier_10', 'tier_20'))
);

-- Enforces one subscription per tenant and doubles as the lookup index
-- `find_by_tenant_id` relies on.
CREATE UNIQUE INDEX idx_subscriptions_tenant_id ON subscriptions (tenant_id);
</file>

<file path="migrations/0039_alter_subscriptions_add_lifecycle.sql">
-- B12 — Subscription Lifecycle (Trial, Grace Period, Expiry, Cancellation).
--
-- Extends B11's minimal subscriptions table. Existing rows default to
-- status = 'active' with no lifecycle dates set, which matches how they
-- were already being treated (a bare plan_tier row = a fully active
-- subscription) — so no separate backfill is required.
ALTER TABLE subscriptions
    ADD COLUMN status TEXT NOT NULL DEFAULT 'active',
    ADD COLUMN trial_ends_at TIMESTAMPTZ,
    ADD COLUMN grace_period_ends_at TIMESTAMPTZ,
    ADD COLUMN current_period_ends_at TIMESTAMPTZ,
    ADD COLUMN canceled_at TIMESTAMPTZ,
    ADD COLUMN cancel_at_period_end BOOLEAN NOT NULL DEFAULT FALSE,
    ADD CONSTRAINT chk_subscriptions_status
        CHECK (status IN ('trialing', 'active', 'past_due', 'expired', 'canceled'));
</file>

<file path="migrations/0040_create_checkout_sessions.sql">
-- B14 — Billing Provider Abstraction & Checkout.
--
-- Persists provider-agnostic checkout sessions so `/billing/checkout`
-- and `/billing/checkout/verify` are idempotent and auditable. No
-- provider-specific columns exist here: provider identity is just a
-- machine-readable string, and the provider checkout id is an opaque
-- TEXT.
CREATE TABLE checkout_sessions (
    id UUID PRIMARY KEY,
    tenant_id UUID NOT NULL REFERENCES tenants(id) ON DELETE CASCADE,
    plan_tier TEXT NOT NULL,
    status TEXT NOT NULL,
    provider TEXT NOT NULL,
    provider_checkout_id TEXT,
    created_at TIMESTAMPTZ NOT NULL DEFAULT now(),
    updated_at TIMESTAMPTZ NOT NULL DEFAULT now(),

    CONSTRAINT chk_checkout_sessions_plan_tier
        CHECK (plan_tier IN ('free', 'tier_1', 'tier_5', 'tier_10', 'tier_20')),
    CONSTRAINT chk_checkout_sessions_status
        CHECK (status IN ('pending', 'completed', 'failed'))
);

-- The verification endpoint looks sessions up by internal id, but an
-- index on tenant helps list/debug queries and ensures tenant isolation.
CREATE INDEX idx_checkout_sessions_tenant_id
    ON checkout_sessions (tenant_id);

-- A completed or pending session still has a unique provider checkout
-- reference, per provider. NULLs (not yet attached) are not indexed.
CREATE UNIQUE INDEX idx_checkout_sessions_provider_checkout_id
    ON checkout_sessions (provider, provider_checkout_id)
    WHERE provider_checkout_id IS NOT NULL;
</file>

