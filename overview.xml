[package]
name = "worker"
version.workspace = true
edition.workspace = true
license.workspace = true
authors.workspace = true

[dependencies]
application = { path = "../application" }
domain = { path = "../domain" }
infra = { path = "../infra" }
shared = { path = "../shared" }

tokio.workspace = true
tokio-util = "0.7"
uuid.workspace = true

tracing = "0.1"
tracing-subscriber = { version = "0.3", features = ["env-filter", "fmt", "json"] }

ipnet = "2"
reqwest = { version = "0.12", default-features = false, features = [
    "rustls-tls",
    "http2",
    "charset",
    "json",
    "gzip",
    "brotli",
    "zstd",
] }
metrics = "0.24.6"
metrics-exporter-prometheus = "0.18.3"
axum = "0.8.9"

# Sababbin dependencies don tantancewar assertion
serde_json = "1.0"
chrono = { workspace = true }
regex = "1"

# Percent-encoding for API flow placeholder resolution
# (placeholder_resolver.rs), pinned to match the version already used by
# domain/shared so the workspace does not end up with two `url` majors.
url = "2.5.8"

# TLS certificate inspection (SSL expiry monitoring). Versions pinned to
# match the rustls stack reqwest's "rustls-tls" feature already pulls in,
# so we don't end up with two separate rustls major versions in the tree.
tokio-rustls = "0.26"
rustls = { version = "0.23", default-features = false, features = ["ring", "std"] }
rustls-native-certs = "0.8"
x509-parser = "0.16"
async-trait.workspace = true
hickory-resolver = "0.26.1"
sqlx = { version = "0.8.6", features = ["postgres", "runtime-tokio", "tls-native-tls", "macros", "chrono", "uuid", "migrate", "runtime-tokio-rustls"] }

# Proxy-Authorization header generation for proxy check protocol verification.
base64 = "0.22"

[dev-dependencies]
async-trait = { workspace = true }
rcgen = "0.13"
time = "0.3"
# Used by crates/worker/src/config.rs's env-var-mutating unit tests, same
# as crates/infra already uses for its own env-var-mutating tests
# (S3Config, SmtpConfig).
serial_test = "3.1"
sqlx = { version = "0.8.6", features = ["runtime-tokio-rustls", "postgres", "uuid", "chrono", "migrate"] }
</file>

<file path="docker-compose.yml">
services:
  postgres:
    image: postgres:16.6
    container_name: uptime-monitor-postgres
    restart: unless-stopped
    environment:
      POSTGRES_USER: postgres
      POSTGRES_PASSWORD: ${POSTGRES_PASSWORD:-postgres}
      POSTGRES_DB: uptime_monitor
    ports:
      - "127.0.0.1:5433:5432"
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U postgres -d uptime_monitor"]
      interval: 10s
      timeout: 5s
      retries: 10
    volumes:
      - postgres_data:/var/lib/postgresql/data

  migrate:
    container_name: uptime-monitor-migrate
    working_dir: /app
    depends_on:
      postgres:
        condition: service_healthy
    environment:
      DATABASE_URL: postgres://postgres:${POSTGRES_PASSWORD:-postgres}@postgres:5432/uptime_monitor
    volumes:
      - .:/app
    command: >
      bash -c "
      export PATH=/usr/local/cargo/bin:/root/.cargo/bin:$PATH &&
      apt-get update &&
      apt-get install -y --no-install-recommends pkg-config libssl-dev ca-certificates &&
      cargo install sqlx-cli --no-default-features --features postgres &&
      sqlx database create || true &&
      sqlx migrate run --source migrations
      "

  api:
    build:
      context: .
      dockerfile: Dockerfile.api
    container_name: uptime-monitor-api
    restart: unless-stopped
    depends_on:
      postgres:
        condition: service_healthy
      migrate:
        condition: service_completed_successfully
    env_file:
      - .env
    environment:
      DATABASE_URL: postgres://postgres:${POSTGRES_PASSWORD:-postgres}@postgres:5432/uptime_monitor
      RUST_LOG: info
    ports:
      - "127.0.0.1:3000:3000"
      - "3443:3443"

  worker:
    build:
      context: .
      dockerfile: Dockerfile.worker
    container_name: uptime-monitor-worker
    restart: unless-stopped
    depends_on:
      postgres:
        condition: service_healthy
      migrate:
        condition: service_completed_successfully
    env_file:
      - .env
    environment:
      DATABASE_URL: postgres://postgres:${POSTGRES_PASSWORD:-postgres}@postgres:5432/uptime_monitor
      RUST_LOG: info
      METRICS_TOKEN: ${METRICS_TOKEN:?METRICS_TOKEN must be set for worker metrics}
    ports:
      - "127.0.0.1:3001:3001"


  prometheus:
    image: prom/prometheus:v2.54.1
    container_name: uptime-monitor-prometheus
    restart: unless-stopped
    depends_on:
      - api
      - worker
    volumes:
      - ./monitoring/prometheus.yml:/etc/prometheus/prometheus.yml:ro
      - ./monitoring/rules.yml:/etc/prometheus/rules.yml
    secrets:
      - metrics_token
    command:
      - --config.file=/etc/prometheus/prometheus.yml
    ports:
      - "127.0.0.1:9090:9090"

  grafana:
    image: grafana/grafana-oss:11.2.0
    container_name: uptime-monitor-grafana
    restart: unless-stopped
    depends_on:
      - prometheus
    environment:
      GF_SECURITY_ADMIN_USER: admin
      GF_SECURITY_ADMIN_PASSWORD: ${GF_SECURITY_ADMIN_PASSWORD:-admin}
    ports:
      - "127.0.0.1:3002:3000"

  alertmanager:
    image: prom/alertmanager:v0.27.0
    container_name: uptime-monitor-alertmanager
    restart: unless-stopped

    command:
      - "--config.file=/etc/alertmanager/alertmanager.yml"

    volumes:
      - ./monitoring/alertmanager.yml:/etc/alertmanager/alertmanager.yml

    ports:
      - "127.0.0.1:9093:9093"

  agent:
    build:
      context: .
      dockerfile: Dockerfile.agent
    container_name: uptime-monitor-agent
    restart: unless-stopped
    depends_on:
      api:
        condition: service_started
    env_file:
      - .env
    environment:
      AGENT_API_BASE_URL: https://api:3443/internal/v1
      RUST_LOG: info

volumes:
  postgres_data:

secrets:
  metrics_token:
    file: .metrics_token
</file>

