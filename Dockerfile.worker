FROM rust:1.89.0-slim-bookworm AS builder

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    pkg-config \
    libssl-dev \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

COPY Cargo.toml Cargo.lock ./
COPY apps ./apps
COPY crates ./crates
COPY migrations ./migrations

RUN cargo build --release -p worker

FROM debian:13.7-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    libssl3 \
    curl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY --from=builder /app/target/release/worker /usr/local/bin/worker

# Do not run the container as root — create a non-root user to reduce the
# blast radius if a container-escape vulnerability is ever found.
RUN groupadd -r app && useradd -r -g app -u 1000 appuser
USER appuser

EXPOSE 3001

# Liveness check — GET /health on the worker's metrics server (see
# crates/worker/src/metrics.rs).
HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 \
  CMD curl -fsS http://localhost:3001/health || exit 1

CMD ["worker"]
