FROM rust:1.89-slim AS builder

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    pkg-config \
    libssl-dev \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

COPY Cargo.toml Cargo.lock ./
COPY crates ./crates

RUN cargo build --release -p worker

FROM debian:trixie-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    libssl3 \
    curl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY --from=builder /app/target/release/worker /usr/local/bin/worker

# Kada a gudanar da container ɗin a matsayin root — ƙirƙiri wani
# non-root user domin rage blast radius idan aka sami wata
# container-escape vulnerability.
RUN groupadd -r app && useradd -r -g app -u 1000 appuser
USER appuser

EXPOSE 3001

# B38: liveness check — GET /health on the worker's metrics server (see
# crates/worker/src/metrics.rs).
HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 \
  CMD curl -fsS http://localhost:3001/health || exit 1

CMD ["worker"]
