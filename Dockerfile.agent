FROM rust:1.89-slim AS builder

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    pkg-config \
    libssl-dev \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

COPY Cargo.toml Cargo.lock ./
COPY crates ./crates

RUN cargo build --release -p agent

FROM debian:trixie-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    libssl3 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY --from=builder /app/target/release/agent /usr/local/bin/agent

RUN groupadd -r app && useradd -r -g app -u 1000 appuser

# mTLS client identity: this agent's own client cert/key and the CA
# cert are copied here so it can authenticate to the API over mTLS.
#
# --chown so appuser (not root) can read these at runtime; client-key.pem
# is chmod 600 so it is readable only by appuser, not world-readable.
COPY --chown=appuser:app certs/ca/ca-cert.pem certs/ca/ca-cert.pem
COPY --chown=appuser:app certs/agents/agent-us-east-1/client-cert.pem certs/agents/agent-us-east-1/client-cert.pem
COPY --chown=appuser:app certs/agents/agent-us-east-1/client-key.pem certs/agents/agent-us-east-1/client-key.pem
RUN chmod 600 certs/agents/agent-us-east-1/client-key.pem
COPY --chown=appuser:app data/geoip/GeoLite2-Country.mmdb data/geoip/GeoLite2-Country.mmdb
USER appuser

CMD ["agent"]
