global:
  resolve_timeout: 5m

route:
  receiver: default
  group_by: ['alertname']
  group_wait: 10s
  group_interval: 30s
  repeat_interval: 1h

receivers:
  - name: default
</file>

<file path="monitoring/rules.yml">
groups:
  - name: uptime
    rules:

      - alert: ApiDown
        expr: up{job="api"} == 0
        for: 1m

      - alert: WorkerDown
        expr: up{job="worker"} == 0
        for: 1m

      - alert: WorkerFailures
        expr: increase(worker_checks_total{result="failure"}[5m]) > 5
        for: 2m
</file>

<file path="Dockerfile.agent">
FROM rust:1.89-slim AS builder

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    pkg-config \
    libssl-dev \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

COPY Cargo.toml Cargo.lock ./
COPY crates ./crates

RUN cargo build --release -p agent

FROM debian:trixie-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    libssl3 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY --from=builder /app/target/release/agent /usr/local/bin/agent

RUN groupadd -r app && useradd -r -g app -u 1000 appuser

# mTLS client identity: this agent's own client cert/key and the CA
# cert are copied here so it can authenticate to the API over mTLS.
#
# --chown so appuser (not root) can read these at runtime; client-key.pem
# is chmod 600 so it is readable only by appuser, not world-readable.
COPY --chown=appuser:app certs/ca/ca-cert.pem certs/ca/ca-cert.pem
COPY --chown=appuser:app certs/agents/agent-us-east-1/client-cert.pem certs/agents/agent-us-east-1/client-cert.pem
COPY --chown=appuser:app certs/agents/agent-us-east-1/client-key.pem certs/agents/agent-us-east-1/client-key.pem
RUN chmod 600 certs/agents/agent-us-east-1/client-key.pem
COPY --chown=appuser:app data/geoip/GeoLite2-Country.mmdb data/geoip/GeoLite2-Country.mmdb
USER appuser

CMD ["agent"]
</file>

<file path="monitoring/prometheus.yml">
global:
  scrape_interval: 15s

scrape_configs:
  - job_name: api
    metrics_path: /metrics
    # /metrics yanzu yana buƙatar sirrin token (ba a buɗe wa kowa ba —
    # duba METRICS_TOKEN a .env). A saita wannan darajar iri ɗaya da
    # METRICS_TOKEN na api service.
    authorization:
      type: Bearer
      credentials_file: /run/secrets/metrics_token
    static_configs:
      - targets:
          - api:3000

  - job_name: worker
    metrics_path: /metrics
    static_configs:
      - targets:
          - worker:3001

alerting:
  alertmanagers:
    - static_configs:
        - targets:
            - alertmanager:9093

rule_files:
  - /etc/prometheus/rules.yml
</file>

<file path="Dockerfile.api">
FROM rust:1.89-slim AS builder

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    pkg-config \
    libssl-dev \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

COPY Cargo.toml Cargo.lock ./
COPY crates ./crates

RUN cargo build --release -p api

FROM debian:trixie-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    libssl3 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY --from=builder /app/target/release/api /usr/local/bin/api

# Kada a gudanar da container ɗin a matsayin root — ƙirƙiri wani
# non-root user domin rage blast radius idan aka sami wata
# container-escape vulnerability.
RUN groupadd -r app && useradd -r -g app -u 1000 appuser

# mTLS internal-CA / server identity: only the server's own cert/key and
# the CA cert are copied here. Agent client certs belong only in the
# agent image (Dockerfile.agent), never here.
#
# --chown so appuser (not root) can read these at runtime; server-key.pem
# is chmod 600 so it is readable only by appuser, not world-readable.
COPY --chown=appuser:app certs/ca/ca-cert.pem certs/ca/ca-cert.pem
COPY --chown=appuser:app certs/api/server-cert.pem certs/api/server-cert.pem
COPY --chown=appuser:app certs/api/server-key.pem certs/api/server-key.pem
RUN chmod 600 certs/api/server-key.pem

USER appuser

EXPOSE 3000
EXPOSE 3443

CMD ["api"]
</file>

