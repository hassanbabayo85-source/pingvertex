<file path="apps/dashboard/src/components/monitors/edit-monitor-dialog.tsx">
"use client";

import { useMemo, useState } from "react";
import { useRouter } from "next/navigation";
import { PencilLine } from "lucide-react";
import { useForm } from "react-hook-form";
import { zodResolver } from "@hookform/resolvers/zod";

import { Button } from "@/components/ui/button";
import {
  Dialog,
  DialogContent,
  DialogDescription,
  DialogHeader,
  DialogTitle,
} from "@/components/ui/dialog";
import { useUpdateMonitor } from "@/hooks/use-update-monitor";
import type { MonitorDto } from "@/lib/api";

import { MonitorForm } from "./monitor-form";
import {
  createMonitorSchema,
  type CreateMonitorValues,
} from "./monitor-schema";

type EditMonitorDialogProps = {
  monitor: MonitorDto;
};

export function EditMonitorDialog({ monitor }: EditMonitorDialogProps) {
  const [open, setOpen] = useState(false);
  const router = useRouter();

  const defaults = useMemo<CreateMonitorValues>(
    () => ({
      user_id: monitor.user_id,
      name: monitor.name,
      url: monitor.url,
      method: monitor.method,
      expected_status: monitor.expected_status,
      interval_seconds: monitor.interval_seconds,
      timeout_seconds: monitor.timeout_seconds,
      enabled: monitor.enabled,
      is_public: monitor.is_public,
    }),
    [monitor],
  );

  const form = useForm<CreateMonitorValues>({
    resolver: zodResolver(createMonitorSchema),
    defaultValues: defaults,
  });

  const mutation = useUpdateMonitor(() => {
    setOpen(false);
    form.reset(defaults);
    router.refresh();
  });

  return (
    <Dialog
      open={open}
      onOpenChange={(next) => {
        setOpen(next);
        if (!next) {
          form.reset(defaults);
        } else {
          form.reset(defaults);
        }
      }}
    >
      <Button type="button" variant="outline" onClick={() => setOpen(true)}>
        <PencilLine className="mr-2 h-4 w-4" />
        Edit Monitor
      </Button>

      <DialogContent className="sm:max-w-2xl">
        <DialogHeader>
          <DialogTitle>Edit Monitor</DialogTitle>
          <DialogDescription>
            Update the endpoint configuration used by the worker.
          </DialogDescription>
        </DialogHeader>

        <MonitorForm
          form={form}
          onSubmit={(values) =>
            mutation.mutate({ id: monitor.id, payload: values })
          }
          onCancel={() => setOpen(false)}
          loading={mutation.isPending}
          submitLabel="Save Changes"
        />
      </DialogContent>
    </Dialog>
  );
}
</file>

<file path="apps/dashboard/src/components/monitors/monitor-form.tsx">
"use client";

import type { UseFormReturn } from "react-hook-form";

import { Button } from "@/components/ui/button";
import { Input } from "@/components/ui/input";
import { Label } from "@/components/ui/label";
import { cn } from "@/lib/utils";

import type { CreateMonitorValues } from "./monitor-schema";

type MonitorFormProps = {
  form: UseFormReturn<CreateMonitorValues>;
  onSubmit: (values: CreateMonitorValues) => void;
  onCancel: () => void;
  loading: boolean;
  submitLabel?: string;
};

const fieldClassName =
  "mt-2 h-11 rounded-xl border bg-background px-4 shadow-none focus-visible:ring-2 focus-visible:ring-ring";

function FieldError({ message }: { message?: string }) {
  if (!message) return null;

  return <p className="mt-2 text-xs text-rose-500">{message}</p>;
}

export function MonitorForm({
  form,
  onSubmit,
  onCancel,
  loading,
  submitLabel = "Create Monitor",
}: MonitorFormProps) {
  const { register, formState } = form;
  const { errors } = formState;

  return (
    <form onSubmit={form.handleSubmit(onSubmit)} className="space-y-6">
      <input type="hidden" {...register("user_id")} />

      <div className="space-y-2">
        <Label htmlFor="name">Monitor name</Label>
        <Input
          id="name"
          placeholder="Google Production"
          className={cn(fieldClassName, errors.name && "border-rose-500")}
          {...register("name")}
          disabled={loading}
        />
        <FieldError message={errors.name?.message} />
      </div>

      <div className="space-y-2">
        <Label htmlFor="url">URL</Label>
        <Input
          id="url"
          placeholder="https://example.com"
          className={cn(fieldClassName, errors.url && "border-rose-500")}
          {...register("url")}
          disabled={loading}
        />
