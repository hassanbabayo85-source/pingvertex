# Build environment for Leptos (CSR) frontend
# Uses a modern Rust toolchain that supports edition2024
FROM rust:1.98-slim AS builder

# Install system dependencies needed for Rust crates and wasm optimization
RUN apt-get update && apt-get install -y \
    pkg-config \
    libssl-dev \
    binaryen \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Add wasm target (for the toolchain in this image)
RUN rustup target add wasm32-unknown-unknown

# Install trunk (for building Leptos apps)
RUN cargo install trunk --locked

WORKDIR /app
