            .clone()
            .oneshot(
                Request::builder()
                    .method(&quot;GET&quot;)
                    .uri(format!(&quot;/api/v1/public/heartbeat/{token}&quot;))
                    .body(Body::empty())
                    .unwrap(),
            )
            .await
            .unwrap();

        assert_eq!(
            response.status(),
            StatusCode::OK,
            &quot;attempt {attempt} within the limit should succeed&quot;
        );
