        );

        // Reset config, then increase cost_safety_buffer -&gt; adjusted costs increase
        let mut config2 = test_config();
        config2.cost_safety_buffer = Decimal::new(150, 2); // 1.50
        let higher_buffer_quote = calculate_price(input, &amp;config2).unwrap();
