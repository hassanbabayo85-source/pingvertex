<div class='file-header'>docker-compose.yml</div>
<pre><code>services:
  # ⚠️  DEVELOPMENT/LOCAL USE ONLY. The `POSTGRES_PASSWORD`/
  # `GF_SECURITY_ADMIN_PASSWORD` defaults below (`postgres`/`admin`) are
  # intentionally weak, predictable dev credentials and MUST NOT reach
  # production. `docker-compose.prod.yml` overrides both to fail closed
  # (`${VAR:?must be set}`) if unset — always deploy with:
  #   docker compose -f docker-compose.yml -f docker-compose.prod.yml up -d
  # Never run `docker compose up` with only this base file against a
  # production/internet-reachable host. See `.env.example` for the
  # variables to set for local development.
  postgres:
    image: postgres:16.6
    container_name: uptime-monitor-postgres
    restart: unless-stopped
    environment:
      POSTGRES_USER: postgres
      POSTGRES_PASSWORD: ${POSTGRES_PASSWORD:?POSTGRES_PASSWORD must be set}
      POSTGRES_DB: uptime_monitor
    ports:
      - &quot;127.0.0.1:5433:5432&quot;
    healthcheck:
      test: [&quot;CMD-SHELL&quot;, &quot;pg_isready -U postgres -d uptime_monitor&quot;]
      interval: 10s
      timeout: 5s
      retries: 10
    volumes:
      - postgres_data:/var/lib/postgresql/data

  redis:
    image: redis:7.4-alpine
    container_name: uptime-monitor-redis
    restart: unless-stopped
    healthcheck:
      test: [&quot;CMD&quot;, &quot;redis-cli&quot;, &quot;ping&quot;]
      interval: 10s
      timeout: 5s
      retries: 10
    volumes:
      - redis_data:/data

  migrate:
    build:
      context: .
      dockerfile: Dockerfile.migrate
    container_name: uptime-monitor-migrate
    working_dir: /app
    depends_on:
      postgres:
        condition: service_healthy
    environment:
      DATABASE_URL: postgres://postgres:${POSTGRES_PASSWORD:?POSTGRES_PASSWORD must be set}@postgres:5432/uptime_monitor
    entrypoint: [&quot;sh&quot;, &quot;-c&quot;]
    command:
      - &quot;sqlx database create || true &amp;&amp; sqlx migrate run --source migrations&quot;

  api:
    build:
      context: .
      dockerfile: Dockerfile.api
    container_name: uptime-monitor-api
    restart: unless-stopped
    depends_on:
      postgres:
        condition: service_healthy
      migrate:
        condition: service_completed_successfully
      redis:
        condition: service_healthy
    extra_hosts:
      - &quot;host.docker.internal:host-gateway&quot;
    env_file:
      - .env
    environment:
      DATABASE_URL: postgres://postgres:${POSTGRES_PASSWORD:?POSTGRES_PASSWORD must be set}@postgres:5432/uptime_monitor
      RUST_LOG: info
    ports:
      - &quot;127.0.0.1:3000:3000&quot;
      - &quot;3443:3443&quot;

  worker:
    build:
      context: .
      dockerfile: Dockerfile.worker
    container_name: uptime-monitor-worker
    restart: unless-stopped
    depends_on:
      postgres:
        condition: service_healthy
      migrate:
        condition: service_completed_successfully
      redis:
        condition: service_healthy
    extra_hosts:
      - &quot;host.docker.internal:host-gateway&quot;
    env_file:
      - .env
    environment:
      DATABASE_URL: postgres://postgres:${POSTGRES_PASSWORD:?POSTGRES_PASSWORD must be set}@postgres:5432/uptime_monitor
      RUST_LOG: info
      METRICS_TOKEN: ${METRICS_TOKEN:?METRICS_TOKEN must be set for worker metrics}
    ports:
