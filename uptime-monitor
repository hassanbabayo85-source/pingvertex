    async fn save(&amp;self, monitor: &amp;Monitor) -&gt; RepoResult&lt;()&gt; {
        let mut tx = self.pool.begin().await?;
        Self::insert_or_replace(&amp;mut tx, monitor).await?;
        tx.commit().await?;
        Ok(())
    }

    async fn update(&amp;self, monitor: &amp;Monitor) -&gt; RepoResult&lt;()&gt; {
