.trend-chart {
  display: block;
  width: 100%;
  height: 120px;
  color: var(--accent);
}

.trend-line {
  vector-effect: non-scaling-stroke;
}

.trend-axis {
  display: flex;
  justify-content: space-between;
  padding-top: var(--space-2);
  color: var(--ink-faint);
  font-family: var(--font-mono);
  font-size: 0.625rem;
}

.trend-empty {
  display: flex;
  min-height: 132px;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: var(--space-1);
  margin-top: var(--space-3);
  border: 1px dashed var(--border-strong);
  border-radius: var(--radius-sm);
  color: var(--ink-muted);
  text-align: center;
  font-size: 0.8125rem;
}

.trend-empty small {
  color: var(--ink-faint);
}

.monitor-table-wrap {
  overflow-x: auto;
  border: 1px solid var(--border);
  border-radius: var(--radius-md);
  background: var(--surface);
}

.dashboard-monitor-table {
  min-width: 640px;
  border: 0;
}

.dashboard-monitor-table th,
.dashboard-monitor-table td {
  padding: 0.75rem 1rem;
}

.dashboard-monitor-table th {
  white-space: nowrap;
}

.dashboard-monitor-table tbody tr:last-child td {
  border-bottom: 0;
}

.monitor-link,
.incident-link {
  color: var(--ink);
  font-weight: 600;
}

.monitor-link:hover,
.incident-link:hover {
  color: var(--accent);
  text-decoration: none;
}

.data-cell {
  font-family: var(--font-mono);
  font-size: 0.75rem;
  font-variant-numeric: tabular-nums;
}

.muted-cell {
  color: var(--ink-faint);
}

.dashboard-empty {
  display: flex;
  align-items: center;
  text-align: center;
  flex-direction: column;
  gap: var(--space-2);
  padding: var(--space-7) var(--space-5);
  border: 1px dashed var(--border-strong);
  border-radius: var(--radius-md);
  background: var(--surface);
}

.dashboard-empty h3 {
  font-size: 1rem;
}

.dashboard-empty p {
  max-width: 480px;
  font-size: 0.8125rem;
}

.dashboard-empty .btn {
  margin-top: var(--space-2);
}

.dashboard-empty.compact {
  align-items: flex-start;
  text-align: left;
  padding: var(--space-5);
}

.incident-list {
  list-style: none;
  overflow: hidden;
  border: 1px solid var(--border);
  border-radius: var(--radius-md);
  background: var(--surface);
}

.incident-item + .incident-item {
  border-top: 1px solid var(--border);
}

.incident-link {
  display: flex;
  align-items: center;
  gap: var(--space-3);
  padding: var(--space-3) var(--space-4);
}

.incident-marker {
  width: 8px;
  height: 8px;
  flex: 0 0 8px;
  border-radius: 50%;
  background: var(--down);
}

.incident-copy {
  display: flex;
  min-width: 0;
  flex: 1;
  flex-direction: column;
  gap: 2px;
}

.incident-copy strong {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.incident-copy small {
  color: var(--ink-faint);
  font-family: var(--font-mono);
  font-size: 0.6875rem;
  font-weight: 400;
}

.incident-arrow {
  color: var(--ink-faint);
  font-size: 1rem;
}

.dashboard-data-note {
  color: var(--ink-faint);
  font-size: 0.6875rem;
  line-height: 1.5;
}

@media (max-width: 1100px) {
  .dashboard-trend-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
}

@media (max-width: 900px) {
  .metric-strip {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  .dashboard-trend-grid {
    grid-template-columns: 1fr;
  }
}

@media (max-width: 600px) {
  .app-main {
    padding: var(--space-5) var(--space-3);
  }

  .dashboard-page-header {
    align-items: flex-start;
  }

  .dashboard-page-header h1 {
    font-size: 1.5rem;
  }

  .metric-strip {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .metric-card {
    min-height: 104px;
  }
}

@media (max-width: 375px) {
  .metric-strip {
    grid-template-columns: 1fr;
  }

  .dashboard-page-header {
    flex-direction: column;
    align-items: stretch;
  }

  .dashboard-page-header .btn {
    width: 100%;
  }

  .dashboard-trend-card {
    padding: var(--space-3);
  }
}


/* ---------- Phase 4 — monitor detail/form polish ---------- */
.monitor-detail {
  display: flex;
  flex-direction: column;
  gap: var(--space-4);
  max-width: 1200px;
}

.monitor-identity {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--space-4);
}

.monitor-identity h2 { margin: 2px 0 2px; }
.monitor-status { flex: 0 0 auto; }

.eyebrow {
  display: block;
  color: var(--ink-faint);
  font-size: 0.7rem;
  font-weight: 700;
  letter-spacing: 0.08em;
  text-transform: uppercase;
}

.muted { color: var(--ink-muted); font-size: 0.8125rem; }
.mono, code { font-family: var(--font-mono); font-size: 0.82em; }

.section-heading {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: var(--space-3);
  margin-bottom: var(--space-3);
}

.section-heading h2 { margin-bottom: 0; }

.monitor-health-metrics {
  grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
  margin-bottom: 0;
}

.performance-bars {
  display: flex;
  flex-direction: column;
  gap: 7px;
}

.performance-row {
  display: grid;
  grid-template-columns: 28px 1fr 72px;
  align-items: center;
  gap: 8px;
  min-height: 24px;
}

.performance-index {
  color: var(--ink-faint);
  font: 0.7rem var(--font-mono);
  text-align: right;
}

.performance-track {
  height: 8px;
  overflow: hidden;
  background: var(--surface-sunken);
  border-radius: 999px;
}

.performance-fill {
  height: 100%;
  min-width: 2px;
  border-radius: inherit;
  background: var(--accent);
}

.performance-up { background: var(--up); }
.performance-down { background: var(--down); }
.performance-value {
  color: var(--ink-muted);
  font: 0.72rem var(--font-mono);
  text-align: right;
}

.list-stack {
  display: flex;
  flex-direction: column;
  gap: 0;
  border: 1px solid var(--border);
  border-radius: var(--radius-md);
  overflow: hidden;
}

.list-row {
  display: flex;
  justify-content: space-between;
  gap: var(--space-4);
  padding: var(--space-3) var(--space-4);
  background: var(--surface);
  border-bottom: 1px solid var(--border);
}

.list-row:last-child { border-bottom: 0; }

.escalation-steps {
  margin: var(--space-2) 0 0 var(--space-5);
  color: var(--ink-muted);
  font-size: 0.8rem;
}

.monitor-subform { margin-top: var(--space-4); }
.form-section { margin-bottom: 0; }
.monitor-form { gap: var(--space-4); }
.monitor-form .form-section h2 { margin-bottom: var(--space-3); }
.form-help { margin: 0 0 var(--space-2); }
.form-error-message {
  margin: -4px 0 var(--space-2);
  color: var(--down);
  font-size: 0.78rem;
}
.form-actions {
  display: flex;
  justify-content: flex-end;
  gap: var(--space-2);
}

@media (max-width: 640px) {
  .monitor-identity { align-items: flex-start; flex-direction: column; }
  .performance-row { grid-template-columns: 22px 1fr 62px; }
  .channel-form { align-items: stretch; }
  .channel-form input, .channel-form select { width: 100%; }
}



/* Phase 5: restrained, reusable UX primitives. */
.table-scroll {
  width: 100%;
  overflow-x: auto;
  -webkit-overflow-scrolling: touch;
}
.table-scroll table {
  min-width: 620px;
}
.secret-box {
  position: relative;
}
.secret-box code {
  max-height: 8rem;
  overflow: auto;
}
.row-actions {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  flex-wrap: wrap;
  gap: var(--space-2);
}
.empty-state {
  padding: var(--space-5);
  text-align: center;
}
.empty-state h2,
.empty-state h3,
.empty-state p {
  margin-bottom: var(--space-2);
}
.performance-bars {
  overflow-x: auto;
}
.performance-row {
  min-width: 520px;
}
@media (max-width: 640px) {
  .row-actions {
    justify-content: flex-start;
  }
}

/* ---------- Realtime reliability ---------- */

.network-status {
  position: sticky;
  top: 0;
  z-index: 20;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: var(--space-2);
  min-height: 34px;
  padding: 0.45rem var(--space-4);
  border-bottom: 1px solid var(--border);
  background: var(--surface);
  color: var(--ink-muted);
  font-size: 0.75rem;
  font-weight: 600;
}

.network-status-offline {
  color: var(--down);
  background: var(--surface);
}

.network-status-dot {
  width: 7px;
  height: 7px;
  flex: 0 0 auto;
  border-radius: 50%;
  background: currentColor;
}

.dashboard-refresh-error {
  align-items: center;
}

@media (prefers-reduced-motion: reduce) {
  .network-status-dot {
    animation: none;
  }
}

/* ---------- Phase 7 accessibility / interaction hardening ---------- */

button, .btn, .sidebar-group a, .sidebar-signout, .icon-button {
  min-height: 40px;
}

@media (max-width: 720px) {
  button, .btn, .sidebar-group a, .sidebar-signout, .icon-button {
    min-height: 44px;
  }

  .dialog-actions {
    justify-content: stretch;
  }

  .dialog-actions &gt; * {
    flex: 1 1 140px;
  }
}


/* ---------- Proxy Checker ---------- */

.proxy-check-page { max-width: 1180px; }

.proxy-input-card { gap: var(--space-4); }
.proxy-input-tabs {
  display: flex;
  gap: var(--space-2);
  align-items: center;
  flex-wrap: wrap;
}
.proxy-input-tabs &gt; button,
.proxy-file-button { width: auto; }
.proxy-input-tabs &gt; button.active,
.proxy-filters &gt; button.active {
  background: var(--accent-soft);
  border-color: var(--accent);
  color: var(--accent);
}
.proxy-file-button {
  position: relative;
  overflow: hidden;
  cursor: pointer;
}
.proxy-file-button input[type=&quot;file&quot;] {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  opacity: 0;
  cursor: pointer;
}
.proxy-input-meta {
  display: flex;
  justify-content: space-between;
  gap: var(--space-3);
  color: var(--ink-muted);
  font-size: 0.8125rem;
  font-family: var(--font-mono);
}
.proxy-inline-error { color: var(--down); }
.proxy-progress-card { margin-top: var(--space-5); }
.proxy-progress-track {
  width: 100%;
  height: 10px;
  overflow: hidden;
  background: var(--surface-sunken);
  border-radius: 999px;
  border: 1px solid var(--border);
}
.proxy-progress-fill {
  height: 100%;
  background: var(--accent);
  border-radius: inherit;
  transition: width 0.2s ease;
}
.proxy-progress-stats {
  display: grid;
  grid-template-columns: repeat(5, minmax(90px, 1fr));
  gap: var(--space-3);
  margin-top: var(--space-3);
  color: var(--ink-muted);
  font-size: 0.8125rem;
}
.proxy-progress-stats strong {
  color: var(--ink);
  font-family: var(--font-mono);
  font-variant-numeric: tabular-nums;
}
.proxy-actions,
.proxy-export-actions {
  display: flex;
  gap: var(--space-2);
  flex-wrap: wrap;
}
.proxy-summary {
  display: grid;
  grid-template-columns: repeat(5, minmax(130px, 1fr));
  gap: var(--space-3);
  margin: var(--space-5) 0;
}
.proxy-summary-card {
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: var(--radius-md);
  box-shadow: var(--shadow-card);
  padding: var(--space-4);
}
.proxy-summary-card span {
  display: block;
  color: var(--ink-muted);
  font-size: 0.72rem;
  font-weight: 600;
  letter-spacing: 0.04em;
}
.proxy-summary-card strong {
  display: block;
  margin-top: var(--space-1);
  font-family: var(--font-mono);
  font-size: 1.5rem;
  font-variant-numeric: tabular-nums;
}
.proxy-summary-card strong.up { color: var(--up); }
.proxy-summary-card strong.down { color: var(--down); }
.proxy-results-card { overflow: hidden; }
.proxy-filters {
  display: flex;
  gap: var(--space-2);
  flex-wrap: wrap;
  margin-bottom: var(--space-4);
}
.proxy-filters button { padding: 0.4rem 0.7rem; }
.proxy-results-table { min-width: 900px; }
.proxy-results-table td { white-space: nowrap; }
.proxy-results-table td:last-child {
  max-width: 300px;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.proxy-results-table .up { color: var(--up); font-weight: 600; }
.proxy-results-table .down { color: var(--down); font-weight: 600; }

@media (max-width: 900px) {
  .proxy-summary { grid-template-columns: repeat(2, minmax(130px, 1fr)); }
  .proxy-progress-stats { grid-template-columns: repeat(2, 1fr); }
}
