<div class='file-block' id='file-1015'>
<div class='file-header'>migrations/0030_add_tenant_id_to_resources.sql</div>
<pre><code>-- Add tenant_id to every tenant-isolated resource table.
--
-- gen_random_uuid() is built into PostgreSQL 16 core, so no
-- CREATE EXTENSION pgcrypto is needed here.

-- ---------------------------------------------------------------------
-- 1. Add nullable tenant_id columns first, so all tables can be
--    backfilled before the NOT NULL constraints are applied.
-- ---------------------------------------------------------------------
ALTER TABLE monitors
    ADD COLUMN tenant_id UUID;

ALTER TABLE api_flows
    ADD COLUMN tenant_id UUID;

ALTER TABLE proxy_check_jobs
    ADD COLUMN IF NOT EXISTS tenant_id UUID;

ALTER TABLE notification_channels
    ADD COLUMN tenant_id UUID;

ALTER TABLE status_pages
    ADD COLUMN tenant_id UUID;

ALTER TABLE escalation_policies
    ADD COLUMN tenant_id UUID;

ALTER TABLE maintenance_windows
    ADD COLUMN tenant_id UUID;

-- ---------------------------------------------------------------------
-- 2. Create one default tenant for every existing user.
--    `username` is nullable, so fall back to `email` for the tenant name.
-- ---------------------------------------------------------------------
INSERT INTO tenants (id, name, owner_user_id, created_at)
SELECT
    gen_random_uuid(),
    COALESCE(users.username, users.email),
    users.id,
    users.created_at
FROM users;

-- ---------------------------------------------------------------------
-- 3. Make each user the Owner of their default tenant.
-- ---------------------------------------------------------------------
INSERT INTO tenant_memberships (tenant_id, user_id, role, invited_at, joined_at)
SELECT
    tenants.id,
    tenants.owner_user_id,
    &#x27;Owner&#x27;,
    tenants.created_at,
    tenants.created_at
FROM tenants;

-- ---------------------------------------------------------------------
-- 4. Backfill tenant_id for resources that already carry user_id.
-- ---------------------------------------------------------------------
UPDATE monitors m
SET tenant_id = t.id
FROM tenants t
WHERE t.owner_user_id = m.user_id;

UPDATE proxy_check_jobs pcj
SET tenant_id = t.id
FROM tenants t
WHERE t.owner_user_id = pcj.user_id;

UPDATE notification_channels nc
SET tenant_id = t.id
FROM tenants t
WHERE t.owner_user_id = nc.user_id;

UPDATE status_pages sp
SET tenant_id = t.id
FROM tenants t
WHERE t.owner_user_id = sp.user_id;

UPDATE escalation_policies ep
SET tenant_id = t.id
FROM tenants t
WHERE t.owner_user_id = ep.user_id;

-- ---------------------------------------------------------------------
-- 5. Backfill tenant_id for resources that only carry monitor_id.
--    They are resolved through monitors.user_id -&gt; tenants.owner_user_id.
-- ---------------------------------------------------------------------
UPDATE api_flows af
SET tenant_id = t.id
FROM tenants t
JOIN monitors m ON m.user_id = t.owner_user_id
WHERE af.monitor_id = m.id;

UPDATE maintenance_windows mw
SET tenant_id = t.id
FROM tenants t
JOIN monitors m ON m.user_id = t.owner_user_id
WHERE mw.monitor_id = m.id;

-- ---------------------------------------------------------------------
-- 6. Now enforce NOT NULL, FK, and indexes on all seven tables.
-- ---------------------------------------------------------------------
ALTER TABLE monitors ALTER COLUMN tenant_id SET NOT NULL;
ALTER TABLE monitors
    ADD CONSTRAINT fk_monitors_tenant
    FOREIGN KEY (tenant_id) REFERENCES tenants(id);
CREATE INDEX idx_monitors_tenant_id ON monitors (tenant_id);

ALTER TABLE api_flows ALTER COLUMN tenant_id SET NOT NULL;
ALTER TABLE api_flows
    ADD CONSTRAINT fk_api_flows_tenant
    FOREIGN KEY (tenant_id) REFERENCES tenants(id);
CREATE INDEX idx_api_flows_tenant_id ON api_flows (tenant_id);

ALTER TABLE proxy_check_jobs ALTER COLUMN tenant_id SET NOT NULL;

DO $$
BEGIN
    IF NOT EXISTS (
        SELECT 1
        FROM pg_constraint
        WHERE conname = &#x27;fk_proxy_check_jobs_tenant&#x27;
          AND conrelid = &#x27;proxy_check_jobs&#x27;::regclass
    ) THEN
        ALTER TABLE proxy_check_jobs
            ADD CONSTRAINT fk_proxy_check_jobs_tenant
            FOREIGN KEY (tenant_id) REFERENCES tenants(id);
    END IF;
END;
$$;

-- Defense in depth: a job&#x27;s user must actually belong to its tenant.
DO $$
BEGIN
    IF NOT EXISTS (
        SELECT 1
        FROM pg_constraint
        WHERE conname = &#x27;fk_proxy_check_jobs_tenant_user&#x27;
          AND conrelid = &#x27;proxy_check_jobs&#x27;::regclass
    ) THEN
        ALTER TABLE proxy_check_jobs
            ADD CONSTRAINT fk_proxy_check_jobs_tenant_user
            FOREIGN KEY (tenant_id, user_id)
            REFERENCES tenant_memberships (tenant_id, user_id);
    END IF;
END;
$$;

CREATE INDEX IF NOT EXISTS proxy_check_jobs_tenant_idx
    ON proxy_check_jobs (tenant_id, created_at DESC);

ALTER TABLE notification_channels ALTER COLUMN tenant_id SET NOT NULL;
ALTER TABLE notification_channels
    ADD CONSTRAINT fk_notification_channels_tenant
    FOREIGN KEY (tenant_id) REFERENCES tenants(id);
CREATE INDEX idx_notification_channels_tenant_id ON notification_channels (tenant_id);

ALTER TABLE status_pages ALTER COLUMN tenant_id SET NOT NULL;
ALTER TABLE status_pages
    ADD CONSTRAINT fk_status_pages_tenant
    FOREIGN KEY (tenant_id) REFERENCES tenants(id);
CREATE INDEX idx_status_pages_tenant_id ON status_pages (tenant_id);

ALTER TABLE escalation_policies ALTER COLUMN tenant_id SET NOT NULL;
ALTER TABLE escalation_policies
    ADD CONSTRAINT fk_escalation_policies_tenant
    FOREIGN KEY (tenant_id) REFERENCES tenants(id);
CREATE INDEX idx_escalation_policies_tenant_id ON escalation_policies (tenant_id);

ALTER TABLE maintenance_windows ALTER COLUMN tenant_id SET NOT NULL;
ALTER TABLE maintenance_windows
    ADD CONSTRAINT fk_maintenance_windows_tenant
    FOREIGN KEY (tenant_id) REFERENCES tenants(id);
CREATE INDEX idx_maintenance_windows_tenant_id ON maintenance_windows (tenant_id);
</code></pre>
</div>
<div class='file-block' id='file-1016'>
<div class='file-header'>migrations/0031_create_api_keys.sql</div>
<pre><code>-- Feature 10: API Keys &amp; Scoped Permissions.
--
-- Tenant-wide (Model A): ownership is tracked via `user_id` purely as an
-- audit trail of who created the key (see `ApiKey`&#x27;s doc comment in
-- domain), NOT as an access-control gate — every application-layer query
-- against this table filters by `tenant_id`, never by `user_id`.
CREATE TABLE api_keys (
    id UUID PRIMARY KEY,
    tenant_id UUID NOT NULL REFERENCES tenants(id) ON DELETE CASCADE,

    -- Audit trail only (who created this key) — NOT used for access
    -- control. See the table-level comment above.
    user_id UUID NOT NULL REFERENCES users(id) ON DELETE CASCADE,

    name TEXT NOT NULL,

    -- Plaintext lookup portion of the raw key (e.g. &quot;pv_3f9a2c1e...&quot;).
    -- Argon2 hashes are salted and therefore cannot be looked up by
    -- equality, so `ApiKeyAuthMiddleware` finds the row via this indexed,
    -- unique, non-secret prefix first, then verifies the caller&#x27;s FULL raw
    -- key against `hashed_key` below.
    key_prefix TEXT NOT NULL,

    -- Argon2 hash (via PasswordHasher/Argon2PasswordHasher) of the full
    -- raw key. The raw key itself is never stored anywhere and is shown
    -- to the caller exactly once, at creation time.
    hashed_key TEXT NOT NULL,

    -- Scope strings, e.g. &#x27;monitor:read&#x27;, &#x27;monitor:write&#x27; — see
    -- `domain::enums::ApiKeyScope`. Stored as TEXT[] rather than a join
    -- table since scopes are small, fixed-cardinality, and always read/
    -- written together with the rest of the key.
    scopes TEXT[] NOT NULL,

    created_at TIMESTAMPTZ NOT NULL DEFAULT now(),

    -- NULL means the key never expires.
    expires_at TIMESTAMPTZ,

    -- Updated best-effort by `ApiKeyAuthMiddleware` on every successful
    -- authentication. NULL until first use.
    last_used_at TIMESTAMPTZ,

    CONSTRAINT chk_api_keys_scopes_not_empty CHECK (array_length(scopes, 1) &gt; 0)
);

-- Enforces global prefix uniqueness (required — this is the column
-- `find_by_prefix` looks up on) and doubles as the lookup index itself.
CREATE UNIQUE INDEX idx_api_keys_key_prefix ON api_keys (key_prefix);

-- Used by `ListApiKeysUseCase` (`list_by_tenant`) and by
-- `DeleteApiKeyUseCase`&#x27;s same-tenant authorization check.
CREATE INDEX idx_api_keys_tenant_id ON api_keys (tenant_id);
</code></pre>
</div>
