<pre><code>use crate::auth::api;
use leptos::prelude::*;
use leptos::task::spawn_local;
use leptos_router::hooks::{use_navigate, use_query_map};

#[component]
pub fn ResetPasswordPage() -&gt; impl IntoView {
    let query = use_query_map();
    let token = move || query.get().get(&quot;token&quot;).unwrap_or_default();
    let new_password = RwSignal::new(String::new());
    let confirm_password = RwSignal::new(String::new());
    let error = RwSignal::new(None::&lt;String&gt;);
    let navigate = use_navigate();

    let on_submit = move |ev: leptos::ev::SubmitEvent| {
        ev.prevent_default();
        let token_val = token();
        let new_password_val = new_password.get();
        let confirm_password_val = confirm_password.get();
        let navigate = navigate.clone();

        if new_password_val != confirm_password_val {
            error.set(Some(&quot;Passwords do not match&quot;.to_string()));
            return;
        }

        spawn_local(async move {
            match api::reset_password(&amp;token_val, &amp;new_password_val).await {
                Ok(()) =&gt; navigate(&quot;/login&quot;, Default::default()),
                Err(e) =&gt; error.set(Some(e)),
            }
        });
    };

    view! {
        &lt;div class=&quot;auth-shell&quot;&gt;
            &lt;div class=&quot;auth-card&quot;&gt;
                &lt;div class=&quot;auth-brand&quot;&gt;
                    &lt;span class=&quot;auth-brand-mark&quot;&gt;&lt;span class=&quot;pulse-dot&quot;&gt;&lt;/span&gt;&lt;/span&gt;
                    &lt;span class=&quot;auth-brand-name&quot;&gt;&quot;PingVertex&quot;&lt;/span&gt;
                &lt;/div&gt;
                &lt;h1&gt;&quot;Set a new password&quot;&lt;/h1&gt;

                &lt;form on:submit=on_submit class=&quot;auth-form&quot;&gt;
                    &lt;div class=&quot;field&quot;&gt;
                        &lt;label for=&quot;new-password&quot;&gt;&quot;New password&quot;&lt;/label&gt;
                        &lt;input type=&quot;password&quot; id=&quot;new-password&quot; autocomplete=&quot;new-password&quot; prop:value=new_password on:input=move |ev| new_password.set(event_target_value(&amp;ev)) required/&gt;
                    &lt;/div&gt;
                    &lt;div class=&quot;field&quot;&gt;
                        &lt;label for=&quot;confirm-password&quot;&gt;&quot;Confirm new password&quot;&lt;/label&gt;
                        &lt;input type=&quot;password&quot; id=&quot;confirm-password&quot; autocomplete=&quot;new-password&quot; prop:value=confirm_password on:input=move |ev| confirm_password.set(event_target_value(&amp;ev)) required/&gt;
                    &lt;/div&gt;
                    &lt;button type=&quot;submit&quot; class=&quot;btn btn-primary btn-block&quot;&gt;&quot;Reset password&quot;&lt;/button&gt;
                &lt;/form&gt;

                {move || error.get().map(|e| view! { &lt;div class=&quot;form-error&quot;&gt;{e}&lt;/div&gt; })}

                &lt;div class=&quot;auth-links&quot;&gt;
                    &lt;a href=&quot;/login&quot;&gt;&quot;Back to sign in&quot;&lt;/a&gt;
                &lt;/div&gt;
            &lt;/div&gt;
        &lt;/div&gt;
    }
}
