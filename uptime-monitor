        assert!(is_allowed_proxy_port(8080));
        assert!(is_allowed_proxy_port(8081));
        assert!(is_allowed_proxy_port(8000));
        assert!(is_allowed_proxy_port(8443));
        assert!(is_allowed_proxy_port(8888));
        assert!(is_allowed_proxy_port(9050));
