    ) -&gt; PaymentProviderResult&lt;RefundDetails&gt; {
        Err(std::io::Error::other(&quot;refunds are not supported by this billing provider&quot;).into())
    }
}

#[async_trait]
impl&lt;T&gt; PaymentProvider for Arc&lt;T&gt;
where
    T: PaymentProvider + Send + Sync + ?Sized,
{
