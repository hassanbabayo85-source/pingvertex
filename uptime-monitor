<div class='file-block' id='file-964'>
<div class='file-header'>deny.toml</div>
<pre><code>[advisories]
# The workspace&#x27;s resolved graph currently contains Leptos 0.7.x.
# Its transitive `paste` and `proc-macro-error2` dependencies are reported
# as unmaintained by RustSec and have no direct patched release available.
# Current upstream Leptos also still references these crates, so this is
# tracked as an upstream maintenance warning rather than hidden as an
# unknown vulnerability. Keep the warning visible in cargo-deny output.
unmaintained = &quot;workspace&quot;

ignore = [
    &quot;RUSTSEC-2026-0194&quot;,
    &quot;RUSTSEC-2026-0195&quot;,
]

[licenses]
allow = [
    &quot;MIT&quot;,
    &quot;Apache-2.0&quot;,
    &quot;BSD-3-Clause&quot;,
    &quot;ISC&quot;,
    &quot;Unicode-DFS-2016&quot;,
    &quot;MPL-2.0&quot;,
    &quot;Zlib&quot;,
    &quot;Unicode-3.0&quot;,
    &quot;0BSD&quot;,
    &quot;CC0-1.0&quot;,
    &quot;CDLA-Permissive-2.0&quot;,
    &quot;BSL-1.0&quot;,
]

[bans]
multiple-versions = &quot;warn&quot;
wildcards = &quot;warn&quot;

[sources]
unknown-registry = &quot;deny&quot;
unknown-git = &quot;deny&quot;
</code></pre>
