  local name=&quot;$1&quot; url=&quot;$2&quot; tries=60
  echo &quot;  waiting for $name at $url ...&quot;
  for i in $(seq 1 $tries); do
    if curl -fsS &quot;$url&quot; &gt;/dev/null 2&gt;&amp;1; then ok &quot;$name healthy after ${i}s&quot;; return 0; fi
    sleep 1
  done
  fail &quot;$name never became healthy after ${tries}s&quot;
