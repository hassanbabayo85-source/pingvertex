    #[allow(clippy::too_many_arguments)]
    pub fn new(
        id: InvitationId,
        tenant_id: TenantId,
        email: String,
        role: Role,
        token_prefix: String,
        token_hash: String,
        expires_at: DateTime&lt;Utc&gt;,
        created_at: DateTime&lt;Utc&gt;,
    ) -&gt; Self {
