                                                    .collect_view()}
                                            }
                                        })
                                    }}
                                &lt;/section&gt;

                                &lt;section class=&quot;card&quot;&gt;
                                    &lt;h2&gt;&quot;Browsers &amp; devices&quot;&lt;/h2&gt;

                                    {move || {
                                        browsers.get().map(|data| {
                                            view! {
                                                &lt;div&gt;
                                                    {data
                                                        .browsers
                                                        .into_iter()
                                                        .map(|item| {
                                                            view! {
                                                                &lt;div class=&quot;list-row&quot;&gt;
                                                                    &lt;span&gt;
                                                                        {item
                                                                            .browser_name
                                                                            .unwrap_or_else(
                                                                                || &quot;Unknown&quot;.into()
                                                                            )}
                                                                    &lt;/span&gt;

                                                                    &lt;strong&gt;
                                                                        {item.session_count}
                                                                    &lt;/strong&gt;
                                                                &lt;/div&gt;
                                                            }
