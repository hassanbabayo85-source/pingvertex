            },
            NavItem {
                label: &quot;Maintenance windows&quot;,
                href: &quot;/maintenance&quot;,
                status: NavStatus::Available,
            },
            NavItem {
                label: &quot;Escalation policies&quot;,
                href: &quot;/escalation-policies&quot;,
                status: NavStatus::Available,
            },
        ],
    },
    NavGroup {
        label: &quot;USER EXPERIENCE&quot;,
        items: &amp;[
            NavItem {
                label: &quot;Real User Monitoring&quot;,
                href: &quot;/rum&quot;,
                status: NavStatus::Available,
            },
            NavItem {
                label: &quot;RUM sites&quot;,
                href: &quot;/rum/sites&quot;,
                status: NavStatus::Available,
