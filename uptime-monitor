#[tokio::test]
async fn create_webhook_channel_returns_signing_secret_once_then_hides_it() {
    let app = build_test_app();
    let user_id = Uuid::new_v4();
    let monitor_id = create_monitor(&amp;app, user_id).await;

    let response = create_channel(
        &amp;app,
