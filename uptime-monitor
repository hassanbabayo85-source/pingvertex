    pub expires_at: Option&lt;DateTime&lt;Utc&gt;&gt;,
    pub last_used_at: Option&lt;DateTime&lt;Utc&gt;&gt;,
}

impl From&lt;ApiKey&gt; for ApiKeySummaryResponse {
    fn from(api_key: ApiKey) -&gt; Self {
