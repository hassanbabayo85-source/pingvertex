#[async_trait]
impl NotificationService for NoopNotificationService {
    async fn notify(
        &amp;self,
        _channel: &amp;NotificationChannel,
        _event: &amp;NotificationEvent,
    ) -&gt; NotifyResult {
        Ok(())
    }
}
