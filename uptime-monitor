impl ProxyCheckJobRow {
    fn into_domain(self) -&gt; RepoResult&lt;ProxyCheckJob&gt; {
        Ok(ProxyCheckJob::from_persisted(
            ProxyCheckJobId(self.id),
            UserId(self.user_id),
            TenantId(self.tenant_id),
            job_status_from_db(&amp;self.status)?,
            self.created_at,
            self.started_at,
            self.heartbeat_at,
            self.worker_id,
            self.completed_at,
            self.canceled_at,
