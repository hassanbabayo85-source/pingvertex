fn env_or_usize(key: &amp;str, default: usize) -&gt; usize {
    env::var(key)
        .ok()
        .and_then(|value| value.trim().parse::&lt;usize&gt;().ok())
        .filter(|value| *value &gt; 0)
        .unwrap_or(default)
}

