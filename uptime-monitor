    malicious_client
        .get(format!(&quot;{}/api/v1/auth/me&quot;, base))
        .header(&quot;Cookie&quot;, format!(&quot;access_token={}&quot;, pending_token))
        .send()
        .await
        .unwrap();
    let resp = get(&amp;malicious_client, &amp;format!(&quot;{}/api/v1/auth/me&quot;, base)).await;
    assert_eq!(resp.status(), reqwest::StatusCode::UNAUTHORIZED);
}

