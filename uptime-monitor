      });
      po.observe({ type: &quot;layout-shift&quot;, buffered: true });
    });
  }

  function readVitals() {
    return {
      lcp_ms: vitals.lcp,
      inp_ms: vitals.inpMax,
      cls: vitals.clsSum &gt; 0 ? Math.round(vitals.clsSum * 1000) / 1000 : null,
