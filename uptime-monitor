        )];
        let ctx = make_ctx(200, &quot;Hello, world!&quot;);
        let (passed, _) = evaluate_assertions(&amp;assertions, &amp;ctx);
        assert!(passed);
    }

    #[test]
    fn test_multiple_assertions_all_pass() {
        let assertions = vec![
            make_assertion(
                ResponsePart::StatusCode,
                AssertionOperator::Equals,
                None,
                Some(&quot;200&quot;),
            ),
            make_assertion(
                ResponsePart::Json,
                AssertionOperator::Equals,
                Some(&quot;$.status&quot;),
                Some(&quot;ok&quot;),
