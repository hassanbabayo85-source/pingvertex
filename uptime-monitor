    pub cert_days_remaining: Option&lt;i64&gt;,

    pub country_code: Option&lt;String&gt;,
}

impl Check {
    #[allow(clippy::too_many_arguments)]
    pub fn new(
        id: CheckId,
        monitor_id: MonitorId,
        region: RegionCode,
