    view! {
        &lt;div class=&quot;auth-shell&quot;&gt;
            &lt;div class=&quot;auth-card&quot;&gt;
                &lt;div class=&quot;auth-brand&quot;&gt;
                    &lt;span class=&quot;auth-brand-mark&quot;&gt;&lt;span class=&quot;pulse-dot&quot;&gt;&lt;/span&gt;&lt;/span&gt;
                    &lt;span class=&quot;auth-brand-name&quot;&gt;&quot;PingVertex&quot;&lt;/span&gt;
                &lt;/div&gt;
                &lt;h1&gt;&quot;Create your account&quot;&lt;/h1&gt;
                &lt;p class=&quot;auth-subtitle&quot;&gt;&quot;Start watching your services in minutes.&quot;&lt;/p&gt;

                {move || {
                    if success.get() {
                        view! {
                            &lt;p class=&quot;auth-success&quot;&gt;&quot;Account created. Check your email for the 6-digit verification code, then &quot; &lt;a href=&quot;/verify-email&quot;&gt;&quot;verify your email&quot;&lt;/a&gt; &quot;.&quot;&lt;/p&gt;
                        }.into_any()
                    } else {
                        view! {
