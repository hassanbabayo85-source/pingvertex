pub async fn list_maintenance_windows(
    State(state): State&lt;AppState&gt;,
    Extension(user): Extension&lt;AuthenticatedUser&gt;,
    Path(monitor_id): Path&lt;String&gt;,
) -&gt; Result&lt;Json&lt;Vec&lt;MaintenanceWindowResponse&gt;&gt;, ApiError&gt; {
