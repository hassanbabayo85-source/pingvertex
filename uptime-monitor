    InMemoryPendingAuthCache,
&gt; {
    LoginUserUseCase::new(
        MockUserRepository { user },
        Argon2PasswordHasher,
        JsonWebTokenService::new(&quot;test-secret&quot;),
        UuidIdGenerator,
        InMemoryPendingAuthCache,
    )
}

