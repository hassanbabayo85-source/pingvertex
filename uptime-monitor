<pre><code>use std::error::Error;

use application::ports::CheckRepository;
use application::ports::check_repository::CheckFilters;
use async_trait::async_trait;
use chrono::{DateTime, Utc};
use domain::shared::ids::{CheckId, MonitorId, TenantId};
use domain::{Check, CheckStatus, ErrorType, RegionCode};
use sqlx::{FromRow, PgPool};
use uuid::Uuid;

type RepoResult&lt;T&gt; = Result&lt;T, Box&lt;dyn Error + Send + Sync&gt;&gt;;

/// B34: hard ceiling on `list_by_monitor`&#x27;s unfiltered result set. This
/// endpoint has no caller-supplied limit/offset (unlike
/// `list_by_monitor_paginated`), and is reachable from the unauthenticated
/// public status endpoints (`get_public_status`, `public_status_page`),
/// so it must never be allowed to scan/return a monitor&#x27;s entire check
/// history. 1000 most-recent checks is far more than any of its current
/// callers (latest-check + uptime-percentage calculation, multi-region
/// incident evaluation) need.
const LIST_BY_MONITOR_LIMIT: i64 = 1000;

/// Number of bind parameters written per check row by the multi-row
/// INSERT in `insert_chunk`. Must match the column list in that query.
const COLUMNS_PER_CHECK: usize = 12;

/// H15: safe ceiling on rows per multi-row INSERT statement.
///
/// PostgreSQL hard-limits a single statement to 65,535 bind parameters.
/// At `COLUMNS_PER_CHECK` (12) params/row that ceiling is ~5,461 rows —
/// past that, `execute` returns an error and (before this change) the
/// *entire* batch was lost, because the old implementation issued one
/// unbounded multi-row INSERT for whatever slice `save_batch` was given.
///
/// `scheduler.rs::process_sweep` calls `save_batch` once per sweep tick
/// with every monitor that came due in that tick, with no caller-side
/// cap on how large that slice can get. 500 rows/chunk (500 * 12 = 6,000
/// params) stays far below the PostgreSQL limit, keeps each statement&#x27;s
/// text size and lock/transaction time bounded, and still cuts DB
/// round-trips by ~500x versus one INSERT per check. If a chunk fails,
/// only that chunk&#x27;s checks are lost — not the whole sweep.
const MAX_BATCH_ROWS: usize = 500;

#[derive(Debug, Clone)]
pub struct PostgresCheckRepository {
    pool: PgPool,
}

impl PostgresCheckRepository {
    pub fn new(pool: PgPool) -&gt; Self {
        Self { pool }
    }

    /// Inserts one chunk (&lt;= `MAX_BATCH_ROWS` rows) via a single
    /// multi-row INSERT. A multi-row INSERT is one SQL statement, so
    /// PostgreSQL commits or rejects the whole chunk atomically — there
    /// is no partial-row failure *within* a chunk.
    async fn insert_chunk(&amp;self, checks: &amp;[Check]) -&gt; RepoResult&lt;()&gt; {
        if checks.is_empty() {
            return Ok(());
        }

        let mut query = String::from(
            &quot;INSERT INTO checks (id,monitor_id,region,status,http_status,response_time_ms,error_type,error_message,checked_at,cert_expires_at,cert_days_remaining,country_code) VALUES &quot;,
        );
        let mut params: Vec&lt;String&gt; = Vec::with_capacity(checks.len());
        for i in 0..checks.len() {
            let base = i * COLUMNS_PER_CHECK;
            params.push(format!(
                &quot;(${},${},${},${},${},${},${},${},${},${},${},${})&quot;,
                base + 1,
                base + 2,
                base + 3,
                base + 4,
                base + 5,
                base + 6,
                base + 7,
                base + 8,
                base + 9,
                base + 10,
                base + 11,
                base + 12
            ));
        }
        query.push_str(&amp;params.join(&quot;,&quot;));

        let mut q = sqlx::query(&amp;query);
        for check in checks {
            let row = CheckRow::from_domain(check);
            q = q
                .bind(row.id)
                .bind(row.monitor_id)
                .bind(row.region)
                .bind(row.status)
                .bind(row.http_status)
                .bind(row.response_time_ms)
                .bind(row.error_type)
                .bind(row.error_message)
                .bind(row.checked_at)
                .bind(row.cert_expires_at)
                .bind(row.cert_days_remaining)
                .bind(row.country_code);
        }

        q.execute(&amp;self.pool).await?;
        Ok(())
    }
}

#[derive(Debug, Clone, FromRow)]
struct CheckRow {
    id: Uuid,
    monitor_id: Uuid,
    region: String,
    status: i16,
    http_status: Option&lt;i32&gt;,
    response_time_ms: i64,
    error_type: String,
    error_message: Option&lt;String&gt;,
    checked_at: DateTime&lt;Utc&gt;,
    cert_expires_at: Option&lt;DateTime&lt;Utc&gt;&gt;,
    cert_days_remaining: Option&lt;i64&gt;,
    country_code: Option&lt;String&gt;,
}

impl CheckRow {
    fn from_domain(check: &amp;Check) -&gt; Self {
        Self {
            id: check.id.0,
            monitor_id: check.monitor_id.0,
            region: check.region.to_string(),
            status: if matches!(check.status, CheckStatus::Up) {
                1
            } else {
                0
            },
            http_status: check.status_code.map(i32::from),
            response_time_ms: check.latency_ms as i64,
            error_type: format!(&quot;{:?}&quot;, check.error_type),
            error_message: check.error_message.clone(),
            checked_at: check.checked_at,
            cert_expires_at: check.cert_expires_at,
            cert_days_remaining: check.cert_days_remaining,
            country_code: check.country_code.clone(),
        }
    }

    fn into_domain(self) -&gt; RepoResult&lt;Check&gt; {
        let status = if self.status == 1 {
            CheckStatus::Up
        } else {
            CheckStatus::Down
        };

        let error_type = match self.error_type.as_str() {
            &quot;None&quot; =&gt; ErrorType::None,
            &quot;Dns&quot; =&gt; ErrorType::Dns,
            &quot;Timeout&quot; =&gt; ErrorType::Timeout,
            &quot;Connection&quot; =&gt; ErrorType::Connection,
            &quot;Ssl&quot; =&gt; ErrorType::Ssl,
            &quot;Http4xx&quot; =&gt; ErrorType::Http4xx,
            &quot;Http5xx&quot; =&gt; ErrorType::Http5xx,
            _ =&gt; ErrorType::Unknown,
        };

        let region = RegionCode::new(self.region)?;

        Ok(Check {
            id: CheckId(self.id),
            monitor_id: MonitorId(self.monitor_id),
            region,
            status,
            status_code: self.http_status.map(|v| v as u16),
            latency_ms: self.response_time_ms as u128,
            error_type,
            error_message: self.error_message,
            checked_at: self.checked_at,
            cert_expires_at: None,
            cert_days_remaining: None,
            country_code: None,
        }
        .with_cert_info(self.cert_expires_at, self.cert_days_remaining)
        .with_country_code(self.country_code))
    }
}

#[async_trait]
impl CheckRepository for PostgresCheckRepository {
    async fn save(&amp;self, check: &amp;Check) -&gt; RepoResult&lt;()&gt; {
        self.save_batch(std::slice::from_ref(check)).await
    }

    /// H15: chunks the input into bounded-size multi-row INSERTs (see
    /// `MAX_BATCH_ROWS`). Each chunk is attempted independently — a
    /// failure in one chunk does not prevent the remaining chunks from
    /// being attempted (best-effort; checks are telemetry data, and
    /// losing an entire sweep&#x27;s checks because one chunk failed would be
    /// a worse outcome than losing just that chunk). The first error
    /// encountered, if any, is returned to the caller after every chunk
    /// has been attempted, so callers still observe and log the failure.
    async fn save_batch(&amp;self, checks: &amp;[Check]) -&gt; RepoResult&lt;()&gt; {
        if checks.is_empty() {
            return Ok(());
        }

        let mut first_err: Option&lt;Box&lt;dyn Error + Send + Sync&gt;&gt; = None;

        for chunk in checks.chunks(MAX_BATCH_ROWS) {
            if let Err(err) = self.insert_chunk(chunk).await
                &amp;&amp; first_err.is_none()
            {
                first_err = Some(err);
            }
        }

        match first_err {
            Some(err) =&gt; Err(err),
            None =&gt; Ok(()),
        }
    }

    /// AUDIT ISSUE #1 fix: `checks`&#x27; PRIMARY KEY has been the composite
    /// `(id, checked_at)` since migration 0061 partitioned the table by
    /// `checked_at` — `id` alone is no longer guaranteed unique at the
    /// database level. This query now filters on both columns so it can
    /// never match more than one row, matching the trait&#x27;s documented
    /// canonical identity.
    async fn find_by_id(
        &amp;self,
        id: CheckId,
        checked_at: DateTime&lt;Utc&gt;,
    ) -&gt; RepoResult&lt;Option&lt;Check&gt;&gt; {
        let row = sqlx::query_as::&lt;_, CheckRow&gt;(
            r#&quot;
            SELECT
                id,
                monitor_id,
                region,
                status,
                http_status,
                response_time_ms,
                error_type,
                error_message,
                checked_at,
                cert_expires_at,
                cert_days_remaining,
                country_code
            FROM checks
            WHERE id = $1
              AND checked_at = $2
            &quot;#,
        )
        .bind(id.0)
        .bind(checked_at)
        .fetch_optional(&amp;self.pool)
        .await?;

        match row {
            Some(row) =&gt; Ok(Some(row.into_domain()?)),
            None =&gt; Ok(None),
        }
    }

    /// B34: now bounded by `LIST_BY_MONITOR_LIMIT` (most-recent-first) —
    /// see the constant&#x27;s doc comment. Previously unbounded, which meant
    /// a monitor with a long check history caused every call site
    /// (including the unauthenticated public status endpoints) to scan
    /// and materialize its ENTIRE history on every request.
    async fn list_by_monitor(&amp;self, monitor_id: MonitorId) -&gt; RepoResult&lt;Vec&lt;Check&gt;&gt; {
        let rows = sqlx::query_as::&lt;_, CheckRow&gt;(
            r#&quot;
            SELECT
                id,
                monitor_id,
                region,
                status,
                http_status,
                response_time_ms,
                error_type,
                error_message,
                checked_at,
                cert_expires_at,
                cert_days_remaining,
                country_code
            FROM checks
            WHERE monitor_id = $1
            ORDER BY checked_at DESC, id DESC
            LIMIT $2
