                &quot;A&#x27;s site&quot;.to_string(),
                &quot;a.example.com&quot;.to_string(),
            )
            .await
            .unwrap();
        create
            .execute(
                tenant_b,
                &quot;B&#x27;s site&quot;.to_string(),
                &quot;b.example.com&quot;.to_string(),
            )
            .await
            .unwrap();

        let list = ListRumSitesUseCase::new(repo);
        let sites = list.execute(tenant_a).await.unwrap();

        assert_eq!(sites.len(), 1);
        assert_eq!(sites[0].tenant_id, tenant_a);
    }
}
