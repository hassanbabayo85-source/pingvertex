    source_id UUID NOT NULL,
    created_at TIMESTAMPTZ NOT NULL DEFAULT now(),
    CONSTRAINT chk_invoice_lines_type CHECK (line_type IN (&#x27;subscription&#x27;,&#x27;addon&#x27;,&#x27;payg_usage&#x27;,&#x27;credit&#x27;,&#x27;refund&#x27;,&#x27;tax&#x27;)),
