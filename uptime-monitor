    NavGroup {
        label: &quot;TOOLS&quot;,
        items: &amp;[NavItem {
            label: &quot;Proxy Checker&quot;,
            href: &quot;/proxy-check&quot;,
            status: NavStatus::Available,
        }],
    },
    NavGroup {
        label: &quot;MONITORING&quot;,
        items: &amp;[
            NavItem {
                label: &quot;Monitors&quot;,
                href: &quot;/monitors&quot;,
                status: NavStatus::Available,
            },
            NavItem {
                label: &quot;Incidents&quot;,
                href: &quot;/monitors&quot;,
