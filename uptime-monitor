                                                        .collect_view()}
                                                &lt;/div&gt;
                                            }
                                        })
                                    }}
                                &lt;/section&gt;

                            &lt;/div&gt;

                            &lt;div class=&quot;feature-grid&quot;&gt;

                                &lt;section class=&quot;card&quot;&gt;
                                    &lt;h2&gt;&quot;Geography&quot;&lt;/h2&gt;

                                    {move || {
                                        geo
                                            .get()
                                            .into_iter()
                                            .map(|item| {
                                                view! {
                                                    &lt;div class=&quot;list-row&quot;&gt;
                                                        &lt;span&gt;
                                                            {item
                                                                .country_code
                                                                .unwrap_or_else(
                                                                    || &quot;Unknown&quot;.into()
