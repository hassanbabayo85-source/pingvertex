  --surface: #ffffff;
  --surface-sunken: #f0f2f5;
  --border: #e1e4ea;
  --border-strong: #c7ccd6;
  --ink: #12151c;
  --ink-muted: #5b6472;
  --ink-faint: #8991a0;

  --accent: #4338ca;
  --accent-hover: #372fb0;
  --accent-soft: #eef0fe;

  --up: #12855a;
  --up-soft: #e5f6ef;
  --down: #c2311f;
  --down-soft: #fbeae8;
  --degraded: #9a6300;
  --degraded-soft: #fbf1dd;
  --neutral: #6b7280;
  --neutral-soft: #eef0f3;

  --radius-sm: 4px;
  --radius-md: 6px;
  --shadow-card: 0 1px 2px rgba(18, 21, 28, 0.05);

  --space-1: 4px;
  --space-2: 8px;
  --space-3: 12px;
  --space-4: 16px;
  --space-5: 24px;
  --space-6: 32px;
  --space-7: 48px;
}

/* ---------- Reset &amp; base ---------- */

* { margin: 0; padding: 0; box-sizing: border-box; }

html { -webkit-text-size-adjust: 100%; }

body {
  font-family: var(--font-sans);
  background-color: var(--bg);
  color: var(--ink);
  font-size: 15px;
  line-height: 1.5;
  -webkit-font-smoothing: antialiased;
}

h1, h2, h3 { font-weight: 600; letter-spacing: -0.01em; color: var(--ink); }
h1 { font-size: 1.625rem; }
h2 { font-size: 1.0625rem; margin-bottom: var(--space-3); }

a { color: var(--accent); text-decoration: none; }
a:hover { text-decoration: underline; }

p { color: var(--ink-muted); }

:focus-visible {
  outline: 2px solid var(--accent);
  outline-offset: 2px;
}

@media (prefers-reduced-motion: reduce) {
  *, *::before, *::after { animation-duration: 0.001ms !important; transition-duration: 0.001ms !important; }
}

/* ---------- Buttons &amp; form controls (generic, so undecorated &lt;button&gt; tags
   across the app still look designed) ---------- */

button, .btn {
  font-family: var(--font-sans);
  font-size: 0.875rem;
  font-weight: 500;
  background-color: var(--surface);
  color: var(--ink);
  border: 1px solid var(--border-strong);
  border-radius: var(--radius-sm);
  padding: 0.5rem 0.875rem;
  cursor: pointer;
