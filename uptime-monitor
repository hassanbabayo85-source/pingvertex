        .clone()
        .oneshot(
            Request::builder()
                .method(&quot;GET&quot;)
                .uri(format!(&quot;/api/v1/monitors/{monitor_id}&quot;))
                .header(&quot;authorization&quot;, auth_header(user_id))
                .body(Body::empty())
