<div class='file-block' id='file-965'>
<div class='file-header'>docker-compose.e2e.yml</div>
<pre><code># E2E test overlay for docker-compose.yml (Worker B39).
# - migrate: image added to satisfy compose validation, command no-ops.
# - api/worker: SMTP/BILLING configured for Mailpit/fake billing.
# - worker: PINGVERTEX_SSRF_ALLOW_PRIVATE=true (test-only).
# - worker: METRICS_TOKEN set for TASK A worker metrics auth test.
services:
  mock-target:
    image: nginx:1.27.4-alpine
    container_name: uptime-monitor-e2e-mock-target
    restart: &quot;no&quot;

  mailpit:
    image: axllent/mailpit:v1.20.3
    container_name: uptime-monitor-e2e-mailpit
    restart: &quot;no&quot;
    ports:
      - &quot;127.0.0.1:8025:8025&quot;

  api:
    environment:
      SMTP_HOST: mailpit
      SMTP_PORT: &quot;1025&quot;
      SMTP_USERNAME: &quot;&quot;
      SMTP_PASSWORD: &quot;&quot;
      SMTP_FROM_ADDRESS: alerts@e2e.invalid
      SMTP_FROM_NAME: PingVertex E2E
      SMTP_STARTTLS: &quot;false&quot;
      SMTP_ALLOW_EMPTY_CREDENTIALS: &quot;true&quot;
      BILLING_PROVIDER: fake
      BILLING_WEBHOOK_SECRET: ${BILLING_WEBHOOK_SECRET:-e2e-test-webhook-secret}

  worker:
    environment:
      INCIDENT_FAILURE_THRESHOLD: &quot;1&quot;
      INCIDENT_RECOVERY_THRESHOLD: &quot;1&quot;
      SMTP_HOST: mailpit
      SMTP_PORT: &quot;1025&quot;
      SMTP_USERNAME: &quot;&quot;
      SMTP_PASSWORD: &quot;&quot;
      SMTP_FROM_ADDRESS: alerts@e2e.invalid
      SMTP_FROM_NAME: PingVertex E2E
      SMTP_STARTTLS: &quot;false&quot;
      SMTP_ALLOW_EMPTY_CREDENTIALS: &quot;true&quot;
      # ENVIRONMENT must be explicitly set here: `validate_production_ssrf_config`
      # now fails closed (refuses to boot) when PINGVERTEX_SSRF_ALLOW_PRIVATE=true
      # unless ENVIRONMENT is explicitly &quot;development&quot;/&quot;dev&quot;/&quot;test&quot;/&quot;local&quot; —
      # an unset ENVIRONMENT is no longer treated as safe. This is a real,
      # intentional test-only value, not the account role &quot;Member&quot;/etc.
      ENVIRONMENT: &quot;test&quot;
      PINGVERTEX_SSRF_ALLOW_PRIVATE: &quot;true&quot;
      METRICS_TOKEN: e2e-worker-metrics-token
</code></pre>
