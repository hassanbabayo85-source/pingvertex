    let result = worker::flow_executor::execute_flow_with_resolver(&amp;f, &amp;client, &amp;resolver).await;

    assert!(!result.passed);
    assert!(
        result.outcomes[0]
            .error
            .as_deref()
            .unwrap_or(&quot;&quot;)
            .contains(&quot;maximum permitted size&quot;)
    );
