                                    }}
                                &lt;/section&gt;

                                &lt;section class=&quot;card&quot;&gt;
                                    &lt;h2&gt;&quot;Sessions&quot;&lt;/h2&gt;

                                    {move || {
                                        sessions.get().map(|data| {
                                            view! {
                                                &lt;div&gt;
                                                    &lt;p&gt;
                                                        {data.session_count}
                                                        &quot; sessions&quot;
                                                    &lt;/p&gt;

                                                    &lt;p&gt;
                                                        {data
                                                            .avg_page_views_per_session
                                                            .map(|v| format!(&quot;{v:.2}&quot;))
                                                            .unwrap_or_else(
                                                                || &quot;—&quot;.into()
                                                            )}
                                                        &quot; avg page views/session&quot;
                                                    &lt;/p&gt;

                                                    &lt;p&gt;
