<pre><code>use serde::{Deserialize, Serialize};

use super::permission::Permission;

/// Coarse-grained role for authorization.
///
/// Roles are mapped to permissions in application policy code.
/// Keep the mapping explicit and testable.
#[derive(Debug, Clone, Copy, PartialEq, Eq, Hash, Serialize, Deserialize)]
#[serde(rename_all = &quot;PascalCase&quot;)]
pub enum Role {
    Member,
    Admin,
    Owner,
    Auditor,
    Viewer,
}

impl Role {
    pub fn permissions(self) -&gt; &amp;&#x27;static [Permission] {
        use Permission::*;

        match self {
            Role::Member =&gt; &amp;[
                ViewOwnProfile,
                UpdateOwnProfile,
                ChangeOwnPassword,
                ViewMonitor,
                ViewIncident,
                ViewSupportTickets,
                CreateSupportTicket,
                ReplySupportTicket,
            ],
            Role::Admin =&gt; &amp;[
                ViewOwnProfile,
                UpdateOwnProfile,
                ChangeOwnPassword,
                ViewMonitor,
                CreateMonitor,
                UpdateMonitor,
                DeleteMonitor,
                PauseMonitor,
                ViewIncident,
                AcknowledgeIncident,
                ResolveIncident,
                ViewTenantSettings,
                UpdateTenantSettings,
                ManageUsers,
                ManageApiKeys,
                ViewSupportTickets,
                CreateSupportTicket,
                ReplySupportTicket,
                ManageSupportTicketStatus,
            ],
            Role::Owner =&gt; &amp;[
                ViewOwnProfile,
                UpdateOwnProfile,
                ChangeOwnPassword,
                ViewMonitor,
                CreateMonitor,
                UpdateMonitor,
                DeleteMonitor,
                PauseMonitor,
                ViewIncident,
                AcknowledgeIncident,
                ResolveIncident,
                ViewTenantSettings,
                UpdateTenantSettings,
                ManageUsers,
                ManageApiKeys,
                ManageBilling,
                ViewSupportTickets,
                CreateSupportTicket,
                ReplySupportTicket,
                ManageSupportTicketStatus,
            ],
            Role::Auditor =&gt; &amp;[
                ViewOwnProfile,
                ViewMonitor,
                ViewIncident,
                ViewTenantSettings,
                ViewSupportTickets,
            ],
            Role::Viewer =&gt; &amp;[
                ViewOwnProfile,
                ViewMonitor,
                ViewIncident,
                ViewSupportTickets,
            ],
        }
    }

    pub fn has_permission(self, permission: Permission) -&gt; bool {
        self.permissions().contains(&amp;permission)
    }
}

#[cfg(test)]
mod tests {
    use super::*;

    #[test]
    fn viewer_has_only_read_permissions() {
        let perms = Role::Viewer.permissions();
        assert!(perms.contains(&amp;Permission::ViewOwnProfile));
        assert!(perms.contains(&amp;Permission::ViewMonitor));
        assert!(perms.contains(&amp;Permission::ViewIncident));
        assert!(!perms.contains(&amp;Permission::CreateMonitor));
        assert!(!perms.contains(&amp;Permission::UpdateMonitor));
        assert!(!perms.contains(&amp;Permission::DeleteMonitor));
        assert!(!perms.contains(&amp;Permission::ManageUsers));
        assert!(!perms.contains(&amp;Permission::ManageApiKeys));
    }

    #[test]
    fn admin_can_manage_users() {
        assert!(Role::Admin.has_permission(Permission::ManageUsers));
    }

    #[test]
    fn owner_can_manage_users_and_billing() {
        assert!(Role::Owner.has_permission(Permission::ManageUsers));
        assert!(Role::Owner.has_permission(Permission::ManageBilling));
    }

    #[test]
    fn member_does_not_have_manage_users() {
        assert!(!Role::Member.has_permission(Permission::ManageUsers));
    }
}
</code></pre>
