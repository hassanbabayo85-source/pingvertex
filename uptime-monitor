    let c = calls.clone();
    let first = uc
        .execute(input.clone(), move || {
            let c = c.clone();
            async move {
                c.fetch_add(1, Ordering::SeqCst);
                Ok::&lt;_, &amp;&#x27;static str&gt;(())
            }
        })
        .await
        .unwrap();

    let c = calls.clone();
    let second = uc
        .execute(input, move || {
            let c = c.clone();
            async move {
