<div class='file-block' id='file-1046'>
<div class='file-header'>migrations/0061_partition_checks_by_checked_at.sql</div>
<pre><code>-- H15 Task B: partition `checks` by month on `checked_at`.
--
-- Preconditions verified before writing this migration (dev-DB check on
-- 2026-08-29): both `checks` and `diagnostic_reports` were confirmed
-- EMPTY (0 rows) in this environment, and there is no production
-- deployment yet (confirmed with the project owner) — so this migration
-- performs a direct drop-and-recreate of `checks` rather than a
-- dual-write/backfill migration. The safety check below makes that
-- assumption explicit and fails loudly instead of silently discarding
-- data if this is ever run against a database that is no longer empty.
--
-- Composite primary key: PostgreSQL requires a partitioned table&#x27;s
-- primary key (and anything referencing it) to include the partition
-- key column, hence PRIMARY KEY (id, checked_at) instead of just (id).
-- Migration 0060 already prepared `diagnostic_reports` for this by
-- adding `check_checked_at` and pointing its FK at the composite key.
--
-- Partitioning scheme: RANGE partitioning by month on `checked_at`,
-- with a DEFAULT partition to catch any row outside the explicitly
-- created monthly ranges (so an insert can never fail for lack of a
-- partition). Monthly partitions are created here for a rolling window
-- (2 months back through 3 months ahead of the date this migration was
-- written). Creating future months&#x27; partitions ahead of time on an
-- ongoing basis is an OPERATIONAL TASK NOT SOLVED BY THIS MIGRATION —
-- flagged in HANDOVER.md for the next worker (e.g. a scheduled job that
-- creates next month&#x27;s partition a few weeks in advance).

DO $$
DECLARE
    checks_rows bigint;
    reports_rows bigint;
BEGIN
    SELECT count(*) INTO checks_rows FROM checks;
    SELECT count(*) INTO reports_rows FROM diagnostic_reports;

    IF checks_rows &lt;&gt; 0 OR reports_rows &lt;&gt; 0 THEN
        RAISE EXCEPTION
            &#x27;Refusing to run: checks has % row(s) and diagnostic_reports has % row(s). &#x27;
            &#x27;This migration drops and recreates checks assuming both tables are empty &#x27;
            &#x27;(verified true when this migration was written). If real data now exists, &#x27;
            &#x27;this migration must be replaced with a dual-write + backfill migration &#x27;
            &#x27;instead of being run as-is.&#x27;,
            checks_rows, reports_rows;
    END IF;
END $$;

-- Detach the FK from diagnostic_reports so `checks` can be freely
-- restructured underneath it.
ALTER TABLE diagnostic_reports
    DROP CONSTRAINT diagnostic_reports_check_id_checked_at_fkey;

-- Drop the old, unpartitioned checks table. Safe: verified empty above,
-- and the FK that referenced it was just dropped. No views depend on
-- checks (verified via pg_views before writing this migration).
DROP TABLE checks;

-- Recreate `checks` as a table partitioned by RANGE on `checked_at`.
-- Column list, types, nullability, and defaults match the table this
-- replaces exactly (verified via \d checks before writing this).
CREATE TABLE checks (
    id UUID NOT NULL,
    monitor_id UUID NOT NULL,
    status SMALLINT NOT NULL,
    http_status INTEGER,
    response_time_ms BIGINT,
    error_type TEXT,
    checked_at TIMESTAMPTZ NOT NULL DEFAULT NOW(),
    error_message TEXT,
    cert_expires_at TIMESTAMPTZ,
    cert_days_remaining BIGINT,
    region TEXT NOT NULL DEFAULT &#x27;us-east&#x27;,
    country_code VARCHAR(2),
    PRIMARY KEY (id, checked_at)
) PARTITION BY RANGE (checked_at);

ALTER TABLE checks
    ADD CONSTRAINT checks_monitor_id_fkey
    FOREIGN KEY (monitor_id) REFERENCES monitors (id) ON DELETE CASCADE;

-- Same index names and shapes as before partitioning. On a partitioned
-- table these are created automatically on every partition (&quot;global
-- looking&quot;, per-partition in reality) — no per-partition index
-- maintenance is needed here.
CREATE INDEX idx_checks_monitor_id
    ON checks (monitor_id);

CREATE INDEX idx_checks_checked_at
    ON checks (checked_at DESC);

CREATE INDEX idx_checks_monitor_checked_at
    ON checks (monitor_id, checked_at DESC);

-- Monthly partitions: 2 months back through 3 months ahead of the date
-- this migration was written (2026-08-29), plus a DEFAULT partition for
-- anything outside that window so writes never fail for lack of a
-- partition.
CREATE TABLE checks_p2026_06 PARTITION OF checks
    FOR VALUES FROM (&#x27;2026-06-01T00:00:00+00&#x27;) TO (&#x27;2026-07-01T00:00:00+00&#x27;);

CREATE TABLE checks_p2026_07 PARTITION OF checks
    FOR VALUES FROM (&#x27;2026-07-01T00:00:00+00&#x27;) TO (&#x27;2026-08-01T00:00:00+00&#x27;);

CREATE TABLE checks_p2026_08 PARTITION OF checks
    FOR VALUES FROM (&#x27;2026-08-01T00:00:00+00&#x27;) TO (&#x27;2026-09-01T00:00:00+00&#x27;);

CREATE TABLE checks_p2026_09 PARTITION OF checks
    FOR VALUES FROM (&#x27;2026-09-01T00:00:00+00&#x27;) TO (&#x27;2026-10-01T00:00:00+00&#x27;);

CREATE TABLE checks_p2026_10 PARTITION OF checks
    FOR VALUES FROM (&#x27;2026-10-01T00:00:00+00&#x27;) TO (&#x27;2026-11-01T00:00:00+00&#x27;);

CREATE TABLE checks_p2026_11 PARTITION OF checks
    FOR VALUES FROM (&#x27;2026-11-01T00:00:00+00&#x27;) TO (&#x27;2026-12-01T00:00:00+00&#x27;);

CREATE TABLE checks_default PARTITION OF checks DEFAULT;

-- Re-point diagnostic_reports&#x27; FK at the new, partitioned checks table.
-- checks&#x27; new PRIMARY KEY (id, checked_at) already provides the unique
-- index this composite FK needs as a target.
ALTER TABLE diagnostic_reports
    ADD CONSTRAINT diagnostic_reports_check_id_checked_at_fkey
    FOREIGN KEY (check_id, check_checked_at)
    REFERENCES checks (id, checked_at)
    ON DELETE CASCADE;
</code></pre>
</div>
<div class='file-block' id='file-1047'>
<div class='file-header'>migrations/0062_create_rum_tables.sql</div>
<pre><code>-- RUM (Real User Monitoring) foundation.
--
-- Every table below carries `tenant_id` directly (denormalized from
-- `rum_sites`, not joined) so that every ingestion/dashboard query and
-- every row-level check can filter on tenant_id without a join, matching
-- the pattern used elsewhere in this schema for high-volume tables
-- (see `checks`). This is a deliberate defense-in-depth choice: even if
-- an application-layer bug fetched the wrong `site_id`, the tenant_id
-- column is still there as a second, independent filter.
--
-- `rum_sites.site_key` is the PUBLIC, non-secret identifier handed to the
-- browser SDK (Task D) to tag outgoing events. It must never be treated
-- as a credential: it identifies *which* site the data belongs to, not
-- *who* is allowed to see it. Nothing in this schema stores a secret
-- alongside it.

CREATE TABLE IF NOT EXISTS rum_sites (
    id UUID PRIMARY KEY,
    tenant_id UUID NOT NULL REFERENCES tenants(id) ON DELETE CASCADE,

    -- Public, non-secret identifier sent by the browser SDK on every
    -- ingested event. Safe to embed in page source.
    site_key TEXT NOT NULL,

    name TEXT NOT NULL,

    -- Registrable domain the SDK is expected to run on (e.g.
    -- &quot;app.example.com&quot;). Used by the ingestion handler as a sanity/
    -- allow-list check on the Origin/Referer of incoming beacons; it is
    -- not a security boundary by itself (Origin headers are
    -- client-supplied) but narrows accidental cross-site ingestion.
    domain TEXT NOT NULL,

    created_at TIMESTAMPTZ NOT NULL DEFAULT now(),
    updated_at TIMESTAMPTZ NOT NULL DEFAULT now()
);

CREATE UNIQUE INDEX IF NOT EXISTS idx_rum_sites_site_key
    ON rum_sites (site_key);

CREATE INDEX IF NOT EXISTS idx_rum_sites_tenant_id
    ON rum_sites (tenant_id);

-- Sessions: one row per browser tab-session the SDK observes. Deliberately
-- thin — no cookies, no IP address, no user identity. `session_key` is a
-- random, client-generated, non-PII value used only to group page views
-- and errors together for a single visit.
CREATE TABLE IF NOT EXISTS rum_sessions (
    id UUID PRIMARY KEY,
    tenant_id UUID NOT NULL REFERENCES tenants(id) ON DELETE CASCADE,
    site_id UUID NOT NULL REFERENCES rum_sites(id) ON DELETE CASCADE,

    session_key TEXT NOT NULL,

    browser_name TEXT,
    browser_version TEXT,
    os_name TEXT,
    device_type TEXT, -- &#x27;desktop&#x27; | &#x27;mobile&#x27; | &#x27;tablet&#x27; | &#x27;other&#x27;

    -- Optional coarse geography. Populated only if the existing
    -- geo-IP infrastructure (see data/geoip/) is wired in by the
    -- ingestion handler (Task C) — country-level only, never city/lat-lon,
    -- and never derived from anything the browser sends directly.
    country_code CHAR(2),

    started_at TIMESTAMPTZ NOT NULL DEFAULT now(),
    last_seen_at TIMESTAMPTZ NOT NULL DEFAULT now()
);

CREATE INDEX IF NOT EXISTS idx_rum_sessions_tenant_site
    ON rum_sessions (tenant_id, site_id);

CREATE INDEX IF NOT EXISTS idx_rum_sessions_site_key
    ON rum_sessions (site_id, session_key);

CREATE INDEX IF NOT EXISTS idx_rum_sessions_started_at
    ON rum_sessions (site_id, started_at);

-- Page views + performance timing + Core Web Vitals for that view.
-- One row per page load/navigation observed by the SDK.
CREATE TABLE IF NOT EXISTS rum_page_views (
    id UUID PRIMARY KEY,
    tenant_id UUID NOT NULL REFERENCES tenants(id) ON DELETE CASCADE,
    site_id UUID NOT NULL REFERENCES rum_sites(id) ON DELETE CASCADE,
    session_id UUID NOT NULL REFERENCES rum_sessions(id) ON DELETE CASCADE,

    -- Path only (no scheme/host/query string) — see Task D: the SDK
    -- strips query strings before sending, since they can carry secrets
    -- or PII (tokens, emails, etc. are a common query-param pattern).
    path TEXT NOT NULL,
    referrer_path TEXT,

    ttfb_ms INTEGER,
    fcp_ms INTEGER,
    lcp_ms INTEGER,
    inp_ms INTEGER,
    cls DOUBLE PRECISION,
    load_time_ms INTEGER,

    created_at TIMESTAMPTZ NOT NULL DEFAULT now()
);

CREATE INDEX IF NOT EXISTS idx_rum_page_views_tenant_site
    ON rum_page_views (tenant_id, site_id);

-- Primary access pattern for dashboards: &quot;this site, this time range&quot;.
CREATE INDEX IF NOT EXISTS idx_rum_page_views_site_created_at
    ON rum_page_views (site_id, created_at);

CREATE INDEX IF NOT EXISTS idx_rum_page_views_session_id
    ON rum_page_views (session_id);

-- &quot;Slow pages&quot; / per-path aggregation.
CREATE INDEX IF NOT EXISTS idx_rum_page_views_site_path
    ON rum_page_views (site_id, path);

CREATE TABLE IF NOT EXISTS rum_js_errors (
    id UUID PRIMARY KEY,
    tenant_id UUID NOT NULL REFERENCES tenants(id) ON DELETE CASCADE,
    site_id UUID NOT NULL REFERENCES rum_sites(id) ON DELETE CASCADE,
    session_id UUID NOT NULL REFERENCES rum_sessions(id) ON DELETE CASCADE,
    page_view_id UUID REFERENCES rum_page_views(id) ON DELETE CASCADE,

    -- Truncated by the domain layer before persistence (see
    -- RumJsError::MAX_MESSAGE_LEN). This value originates in the
    -- visitor&#x27;s browser and is NEVER trusted as safe HTML — the
    -- dashboard API (Task F) must render it as plain text only.
    message TEXT NOT NULL,
    source TEXT,
    line_number INTEGER,
    column_number INTEGER,

    created_at TIMESTAMPTZ NOT NULL DEFAULT now()
);

CREATE INDEX IF NOT EXISTS idx_rum_js_errors_tenant_site
    ON rum_js_errors (tenant_id, site_id);

CREATE INDEX IF NOT EXISTS idx_rum_js_errors_site_created_at
    ON rum_js_errors (site_id, created_at);

CREATE TABLE IF NOT EXISTS rum_resource_errors (
    id UUID PRIMARY KEY,
    tenant_id UUID NOT NULL REFERENCES tenants(id) ON DELETE CASCADE,
    site_id UUID NOT NULL REFERENCES rum_sites(id) ON DELETE CASCADE,
    session_id UUID NOT NULL REFERENCES rum_sessions(id) ON DELETE CASCADE,
    page_view_id UUID REFERENCES rum_page_views(id) ON DELETE CASCADE,

    -- Also browser-controlled, untrusted, plain-text-only on render.
    resource_url TEXT NOT NULL,
    resource_type TEXT, -- &#x27;script&#x27; | &#x27;stylesheet&#x27; | &#x27;image&#x27; | &#x27;fetch&#x27; | &#x27;other&#x27;
    status_code INTEGER,

    created_at TIMESTAMPTZ NOT NULL DEFAULT now()
);

CREATE INDEX IF NOT EXISTS idx_rum_resource_errors_tenant_site
    ON rum_resource_errors (tenant_id, site_id);

CREATE INDEX IF NOT EXISTS idx_rum_resource_errors_site_created_at
    ON rum_resource_errors (site_id, created_at);
</code></pre>
</div>
<div class='file-block' id='file-1048'>
<div class='file-header'>migrations/0063_add_unique_constraint_rum_sessions.sql</div>
<pre><code>-- Task C (RUM ingestion) needs to find-or-create a session by
