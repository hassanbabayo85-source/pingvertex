<pre><code>use std::error::Error;

use chrono::Utc;

use crate::{
    ports::{PasswordHasher, PendingAuthCache, UserRepository},
    use_cases::session_invalidation::{
        SESSION_INVALIDATION_TTL_SECONDS, session_invalidated_at_cache_key,
    },
};

use domain::{PasswordHash, UserId};

const MIN_PASSWORD_LENGTH: usize = 12;
const MAX_PASSWORD_LENGTH: usize = 128;

fn validate_password(password: &amp;str) -&gt; Result&lt;(), &amp;&#x27;static str&gt; {
    if password.chars().count() &gt; MAX_PASSWORD_LENGTH {
        return Err(&quot;password must not exceed 128 characters&quot;);
    }
    if password.trim().is_empty() {
        return Err(&quot;password must not be empty&quot;);
    }
    if password.chars().count() &lt; MIN_PASSWORD_LENGTH {
        return Err(&quot;password must be at least 12 characters long&quot;);
    }
    if !password.chars().any(|c| c.is_ascii_uppercase()) {
        return Err(&quot;password must contain at least one uppercase letter&quot;);
    }
    if !password.chars().any(|c| c.is_ascii_lowercase()) {
        return Err(&quot;password must contain at least one lowercase letter&quot;);
    }
    if !password.chars().any(|c| c.is_ascii_digit()) {
        return Err(&quot;password must contain at least one digit&quot;);
    }
    if !password.chars().any(|c| !c.is_ascii_alphanumeric()) {
        return Err(&quot;password must contain at least one special character&quot;);
    }
    Ok(())
}

#[derive(Debug)]
pub enum ChangePasswordError {
    InvalidCurrentPassword,
    WeakPassword(&amp;&#x27;static str),
    Internal(Box&lt;dyn Error + Send + Sync&gt;),
}

impl std::fmt::Display for ChangePasswordError {
    fn fmt(&amp;self, f: &amp;mut std::fmt::Formatter&lt;&#x27;_&gt;) -&gt; std::fmt::Result {
        match self {
            Self::InvalidCurrentPassword =&gt; write!(f, &quot;invalid current password&quot;),
            Self::WeakPassword(msg) =&gt; write!(f, &quot;{msg}&quot;),
            Self::Internal(_) =&gt; write!(f, &quot;failed to change password&quot;),
        }
    }
}

impl Error for ChangePasswordError {}

/// Changes a user&#x27;s password after verifying their current password.
///
/// On success:
///   1. a &quot;session invalidated before now&quot; marker is written to
///      `PendingAuthCache` (Redis) so `jwt_auth` starts rejecting every
///      session JWT that was issued before this moment;
///   2. the user&#x27;s password hash is replaced.
///
/// The Redis write is security-critical and is performed BEFORE the
/// durable password change, identical to `ResetPasswordUseCase`: if it
/// fails, the whole operation fails before the password is changed, so a
/// Redis outage can never leave a stale session usable after a
/// successful password change (no fail-open window).
pub struct ChangePasswordUseCase&lt;R, H, C&gt; {
    user_repository: R,
    password_hasher: H,
    pending_auth_cache: C,
}

impl&lt;R, H, C&gt; ChangePasswordUseCase&lt;R, H, C&gt;
where
    R: UserRepository,
    H: PasswordHasher,
    C: PendingAuthCache,
{
    pub fn new(user_repository: R, password_hasher: H, pending_auth_cache: C) -&gt; Self {
        Self {
            user_repository,
            password_hasher,
            pending_auth_cache,
        }
    }

    pub async fn execute(
        &amp;self,
        user_id: UserId,
        current_password: String,
        new_password: String,
    ) -&gt; Result&lt;(), ChangePasswordError&gt; {
        validate_password(&amp;new_password).map_err(ChangePasswordError::WeakPassword)?;

        let mut user = self
            .user_repository
            .find_by_id(&amp;user_id)
            .await
            .map_err(ChangePasswordError::Internal)?
            .ok_or_else(|| {
                ChangePasswordError::Internal(Box::new(std::io::Error::new(
                    std::io::ErrorKind::NotFound,
                    &quot;user not found&quot;,
                )))
            })?;

        let valid = self
            .password_hasher
            .verify(&amp;current_password, user.password_hash().as_str())
            .await
            .unwrap_or(false);

        if !valid {
            return Err(ChangePasswordError::InvalidCurrentPassword);
        }

        let now = Utc::now();

        let hashed = self
            .password_hasher
            .hash(&amp;new_password)
            .await
            .map_err(ChangePasswordError::Internal)?;

        let password_hash =
            PasswordHash::new(hashed).map_err(|e| ChangePasswordError::Internal(Box::new(e)))?;

        // SEC: session invalidation is a mandatory security precondition.
        // Do this BEFORE changing the durable password so a Redis outage
        // cannot leave the old session valid after a successful change.
        // Mirrors ResetPasswordUseCase&#x27;s ordering/error-handling exactly
        // (see HANDOVER.md, MATSALA 1 / H1 — this was previously a
        // silent `let _ = ...` that discarded the Redis error, which is
        // the fail-open bug this fix closes).
        self.pending_auth_cache
            .set(
                &amp;session_invalidated_at_cache_key(user_id),
                &amp;now.timestamp().to_string(),
                SESSION_INVALIDATION_TTL_SECONDS,
            )
            .await
            .map_err(ChangePasswordError::Internal)?;

        user.set_password_hash(password_hash, now);

        self.user_repository
            .update(&amp;user)
            .await
            .map_err(ChangePasswordError::Internal)?;

        Ok(())
    }
}
