    let over_limit_response = app
        .clone()
        .oneshot(
            Request::builder()
                .method(&quot;GET&quot;)
                .uri(format!(&quot;/api/v1/public/heartbeat/{token}&quot;))
                .body(Body::empty())
                .unwrap(),
        )
        .await
        .unwrap();

    assert_eq!(over_limit_response.status(), StatusCode::TOO_MANY_REQUESTS);
