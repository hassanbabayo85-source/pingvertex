    const MAX_REQUESTS_PER_WINDOW: usize = 6;

    let app = build_test_app();
    let user_id = Uuid::new_v4();

    let created = create_heartbeat_monitor(&amp;app, user_id, &quot;Nightly Backup Job&quot;).await;
