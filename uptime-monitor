    ) -&gt; RepoResult&lt;u64&gt; {
        let result = sqlx::query(
            r#&quot;
            DELETE FROM checks
            WHERE id IN (
                SELECT c.id
                FROM checks c
                JOIN monitors m ON c.monitor_id = m.id
                WHERE m.tenant_id = $1
                  AND c.checked_at &lt; $2
                LIMIT $3
