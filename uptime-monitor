/// (cookie) AND the caller&#x27;s current password.
pub async fn change_password(current_password: &amp;str, new_password: &amp;str) -&gt; Result&lt;(), String&gt; {
    let body = json!({
        &quot;current_password&quot;: current_password,
        &quot;new_password&quot;: new_password,
