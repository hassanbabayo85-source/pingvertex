<pre><code>use chrono::{DateTime, Utc};
use domain::{CheckStatus, Incident, Monitor};
use serde::Serialize;

/// Summary counts of monitors for a tenant&#x27;s dashboard.
#[derive(Debug, Clone, Serialize)]
pub struct MonitorSummary {
    pub total: u32,
    pub up: u32,
    pub down: u32,
