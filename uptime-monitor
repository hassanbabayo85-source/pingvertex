<pre><code>use crate::checker::CheckOutcome;
use domain::{Monitor, RegionCode};
use reqwest::Client;
use serde::{Deserialize, Serialize};
use uuid::Uuid;

#[derive(Debug, Deserialize)]
struct ClaimResponse {
    checks: Vec&lt;ClaimedCheck&gt;,
}

#[derive(Debug, Deserialize)]
pub struct ClaimedCheck {
    pub check_id: Uuid,
    pub monitor: Monitor,
    pub region: RegionCode,
}

#[derive(Debug, Serialize)]
struct SubmitResultRequest {
    check_id: Uuid,
    monitor_id: Uuid,
    region: String,
    success: bool,
    status_code: Option&lt;u16&gt;,
    latency_ms: u128,
    error: Option&lt;String&gt;,
    country_code: Option&lt;String&gt;,
}

pub async fn claim_checks(
    client: &amp;Client,
    api_base: &amp;str,
    agent_id: &amp;str,
    agent_region: &amp;str,
) -&gt; anyhow::Result&lt;Vec&lt;ClaimedCheck&gt;&gt; {
    let url = format!(&quot;{api_base}/agents/{agent_id}/checks/claim&quot;);

    let resp = client
        .post(url)
        .header(&quot;X-Agent-Region&quot;, agent_region)
        .send()
        .await?
        .error_for_status()?;

    let body: ClaimResponse = resp.json().await?;
    Ok(body.checks)
}

pub async fn submit_result(
    client: &amp;Client,
    api_base: &amp;str,
    agent_id: &amp;str,
    agent_region: &amp;str,
    check_id: Uuid,
    monitor_id: Uuid,
    result: CheckOutcome,
) -&gt; anyhow::Result&lt;()&gt; {
    let url = format!(&quot;{api_base}/agents/{agent_id}/results&quot;);

    let payload = SubmitResultRequest {
        check_id,
        monitor_id,
        region: result.region,
        success: result.success,
        status_code: result.status_code,
        latency_ms: result.latency_ms,
        error: result.error,
        country_code: result.country_code,
    };

    client
        .post(url)
        .header(&quot;X-Agent-Region&quot;, agent_region)
        .json(&amp;payload)
        .send()
        .await?
        .error_for_status()?;

    Ok(())
}
