#[component]
pub fn StatusPagesPage() -&gt; impl IntoView {
    let pages = RwSignal::new(Vec::&lt;api::StatusPage&gt;::new());
    let monitors = RwSignal::new(Vec::&lt;monitoring::Monitor&gt;::new());
    let loading = RwSignal::new(true);
