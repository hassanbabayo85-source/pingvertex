        FOREIGN KEY (monitor_id, tenant_id)
        REFERENCES monitors (id, tenant_id)
        ON DELETE CASCADE
);

CREATE INDEX idx_subscribers_monitor_id ON subscribers (monitor_id);
CREATE INDEX idx_subscribers_tenant_id ON subscribers (tenant_id);
</code></pre>
</div>
<div class='file-block' id='file-1052'>
<div class='file-header'>migrations/0067_drop_redundant_escalation_policies_monitor_fk.sql</div>
<pre><code>-- Follow-up to 0065 (SEC-P0-3 tenant-integrity migration).
--
-- 0065 added the new composite FK
-- `fk_escalation_policies_monitor_tenant (monitor_id, tenant_id)` on
-- escalation_policies, but — unlike api_flows, maintenance_windows, and
