<pre><code>use application::ports::{ReservationOutcome, WalletRepoResult, WalletRepository};
use async_trait::async_trait;
use chrono::{DateTime, Datelike, Utc};
use domain::{
    AutoTopUpAttempt, CreditReservation, Wallet, WalletNotification, WalletSettings,
    WalletTopUpSession, WalletTransaction, WalletTransactionType,
};
use std::collections::HashMap;
use std::sync::{Arc, Mutex};
use uuid::Uuid;

#[derive(Clone)]
struct Promo {
    id: Uuid,
    tenant_id: Uuid,
    remaining: i64,
    expires_at: DateTime&lt;Utc&gt;,
}

type WalletTransactions = Vec&lt;WalletTransaction&gt;;
type WalletReservations = HashMap&lt;Uuid, CreditReservation&gt;;

#[derive(Clone, Default)]
pub struct InMemoryWalletRepository {
    inner: Arc&lt;Mutex&lt;HashMap&lt;Uuid, (Wallet, WalletTransactions, WalletReservations)&gt;&gt;&gt;,
    settings: Arc&lt;Mutex&lt;HashMap&lt;Uuid, WalletSettings&gt;&gt;&gt;,
    promos: Arc&lt;Mutex&lt;Vec&lt;Promo&gt;&gt;&gt;,
    sessions: Arc&lt;Mutex&lt;HashMap&lt;String, WalletTopUpSession&gt;&gt;&gt;,
    attempts: Arc&lt;Mutex&lt;Vec&lt;AutoTopUpAttempt&gt;&gt;&gt;,
    notifications: Arc&lt;Mutex&lt;Vec&lt;WalletNotification&gt;&gt;&gt;,
    claims: Arc&lt;Mutex&lt;HashMap&lt;Uuid, (Uuid, DateTime&lt;Utc&gt;)&gt;&gt;&gt;,
    refunds: Arc&lt;Mutex&lt;HashMap&lt;String, domain::WalletRefundRequest&gt;&gt;,&gt;
}

#[async_trait]
impl WalletRepository for InMemoryWalletRepository {
    async fn get_or_create(&amp;self, tenant_id: Uuid, currency: &amp;str) -&gt; WalletRepoResult&lt;Wallet&gt; {
        let mut g = self.inner.lock().unwrap();
        let (wallet, _, _) = g.entry(tenant_id).or_insert_with(|| (
            Wallet::new(Uuid::new_v4(), tenant_id, currency),
            Vec::new(),
            HashMap::new(),
        ));
        Ok(wallet.clone())
    }

    async fn list_transactions(&amp;self, tenant_id: Uuid, limit: u32) -&gt; WalletRepoResult&lt;Vec&lt;WalletTransaction&gt;&gt; {
        let g = self.inner.lock().unwrap();
        Ok(g.get(&amp;tenant_id).map(|(_, txs, _)| txs.iter().rev().take(limit.min(100) as usize).cloned().collect()).unwrap_or_default())
    }

    async fn reserve(&amp;self, tenant_id: Uuid, amount_units: i64, operation: &amp;str, request_id: &amp;str, expires_at: DateTime&lt;Utc&gt;) -&gt; WalletRepoResult&lt;ReservationOutcome&gt; {
        if amount_units &lt;= 0 || request_id.trim().is_empty() { return Err(&quot;invalid reservation&quot;.into()); }
        let mut g = self.inner.lock().unwrap();
        let (wallet, _, reservations) = g.get_mut(&amp;tenant_id).ok_or(&quot;wallet not found&quot;)?;
        if let Some(existing) = reservations.values().find(|r| r.request_id == request_id) {
            return Ok(ReservationOutcome { reservation: existing.clone(), created: false });
        }
        let reserved = reservations.values().filter(|r| r.status == CreditReservation::PENDING &amp;&amp; r.expires_at &gt; Utc::now()).map(|r| r.amount_units).sum::&lt;i64&gt;();
        if wallet.balance_units - reserved &lt; amount_units { return Err(&quot;insufficient wallet balance&quot;.into()); }
        let r = CreditReservation {
            id: Uuid::new_v4(), wallet_id: wallet.id, amount_units,
            status: CreditReservation::PENDING.to_owned(), operation: operation.to_owned(),
            request_id: request_id.to_owned(), expires_at, created_at: Utc::now(), updated_at: Utc::now()
        };
        reservations.insert(r.id, r.clone());
        Ok(ReservationOutcome { reservation: r, created: true })
    }

    async fn capture(&amp;self, reservation_id: Uuid) -&gt; WalletRepoResult&lt;WalletTransaction&gt; {
        let mut g = self.inner.lock().unwrap();
        for (wallet, txs, reservations) in g.values_mut() {
            if let Some(r) = reservations.get_mut(&amp;reservation_id) {
                if r.status == CreditReservation::CAPTURED {
                    return txs.iter().find(|t| t.idempotency_key == format!(&quot;reservation:{reservation_id}&quot;)).cloned().ok_or_else(|| &quot;captured ledger entry missing&quot;.into());
                }
                if r.status != CreditReservation::PENDING || r.expires_at &lt;= Utc::now() { return Err(&quot;reservation is not capturable&quot;.into()); }
                if wallet.balance_units &lt; r.amount_units { return Err(&quot;insufficient wallet balance&quot;.into()); }

                let amount = r.amount_units;
                let tenant_id = wallet.tenant_id;
                let operation = r.operation.clone();
                wallet.balance_units -= amount;
                wallet.updated_at = Utc::now();
                r.status = CreditReservation::CAPTURED.to_owned();
                r.updated_at = Utc::now();

                drop(g);
                // Promo consumption is synchronized separately. The wallet balance
                // was already atomically reduced under the repository mutex.
                let mut remaining = amount;
                let mut promos = self.promos.lock().unwrap();
                let now = Utc::now();
                promos.retain(|p| p.remaining &gt; 0 &amp;&amp; p.expires_at &gt; now);
                for p in promos.iter_mut().filter(|p| p.tenant_id == wallet.tenant_id) {
                    if remaining == 0 { break; }
                    let used = p.remaining.min(remaining);
                    p.remaining -= used;
                    remaining -= used;
                }
                drop(promos);
                let mut g = self.inner.lock().unwrap();
                let (wallet, txs, _) = g.get_mut(&amp;tenant_id).unwrap();
                let tx = WalletTransaction {
                    id: Uuid::new_v4(), tenant_id: wallet.tenant_id, wallet_id: wallet.id,
                    transaction_type: WalletTransactionType::Debit, amount_units: -amount,
                    balance_after_units: wallet.balance_units, idempotency_key: format!(&quot;reservation:{reservation_id}&quot;),
                    reference_type: Some(&quot;credit_reservation&quot;.to_owned()),
                    reference_id: Some(reservation_id.to_string()), description: Some(operation),
                    created_at: Utc::now()
                };
                txs.push(tx.clone());
                return Ok(tx);
            }
        }
        Err(&quot;reservation not found&quot;.into())
    }

    async fn release(&amp;self, reservation_id: Uuid) -&gt; WalletRepoResult&lt;()&gt; {
        let mut g = self.inner.lock().unwrap();
        for (_, _, reservations) in g.values_mut() {
            if let Some(r) = reservations.get_mut(&amp;reservation_id) {
                if r.status == CreditReservation::PENDING { r.status = CreditReservation::RELEASED.to_owned(); r.updated_at = Utc::now(); }
                return Ok(());
            }
        }
        Err(&quot;reservation not found&quot;.into())
    }

    async fn credit(&amp;self, tenant_id: Uuid, amount_units: i64, transaction_type: WalletTransactionType, idempotency_key: &amp;str, description: Option&lt;&amp;str&gt;) -&gt; WalletRepoResult&lt;WalletTransaction&gt; {
        if amount_units &lt;= 0 || idempotency_key.trim().is_empty() { return Err(&quot;invalid credit&quot;.into()); }
        let mut g = self.inner.lock().unwrap();
        let (wallet, txs, _) = g.get_mut(&amp;tenant_id).ok_or(&quot;wallet not found&quot;)?;
        if let Some(existing) = txs.iter().find(|t| t.idempotency_key == idempotency_key) { return Ok(existing.clone()); }
        wallet.balance_units = wallet.balance_units.checked_add(amount_units).ok_or(&quot;wallet balance overflow&quot;)?;
        wallet.updated_at = Utc::now();
        let tx = WalletTransaction {
            id: Uuid::new_v4(), tenant_id, wallet_id: wallet.id, transaction_type,
            amount_units, balance_after_units: wallet.balance_units, idempotency_key: idempotency_key.to_owned(),
            reference_type: None, reference_id: None, description: description.map(str::to_owned), created_at: Utc::now()
        };
        txs.push(tx.clone());
        Ok(tx)
    }

    async fn create_top_up_session(&amp;self, session: &amp;WalletTopUpSession) -&gt; WalletRepoResult&lt;()&gt; {
        let mut g = self.sessions.lock().unwrap();
        if g.values().any(|x| x.provider == session.provider &amp;&amp; x.provider_checkout_id == session.provider_checkout_id &amp;&amp; x.tenant_id != session.tenant_id) {
            return Err(&quot;provider checkout already belongs to another tenant&quot;.into());
        }
        g.insert(session.provider_checkout_id.clone(), session.clone());
        Ok(())
    }

    async fn find_top_up_session(&amp;self, tenant_id: Uuid, provider_checkout_id: &amp;str) -&gt; WalletRepoResult&lt;Option&lt;WalletTopUpSession&gt;&gt; {
        Ok(self.sessions.lock().unwrap().get(provider_checkout_id).filter(|x| x.tenant_id == tenant_id).cloned())
    }

    async fn complete_top_up_session(&amp;self, tenant_id: Uuid, provider_checkout_id: &amp;str, provider_payment_id: &amp;str) -&gt; WalletRepoResult&lt;Option&lt;WalletTopUpSession&gt;&gt; {
        let mut g = self.sessions.lock().unwrap();
        let Some(s) = g.get_mut(provider_checkout_id) else { return Ok(None); };
        if s.tenant_id != tenant_id { return Ok(None); }
        if s.status == WalletTopUpSession::COMPLETED { return Ok(Some(s.clone())); }
        s.status = WalletTopUpSession::COMPLETED.to_owned();
        s.provider_payment_id = Some(provider_payment_id.to_owned());
        s.updated_at = Utc::now();
        Ok(Some(s.clone()))
    }

    async fn refundable_top_up(&amp;self, tenant_id: Uuid, provider_payment_id: &amp;str, amount_units: i64) -&gt; WalletRepoResult&lt;Option&lt;WalletTopUpSession&gt;&gt; {
        Ok(self.sessions.lock().unwrap().values().find(|s| s.tenant_id == tenant_id &amp;&amp; s.provider_payment_id.as_deref() == Some(provider_payment_id) &amp;&amp; s.status == WalletTopUpSession::COMPLETED &amp;&amp; s.amount_units.saturating_sub(s.refunded_amount_units) &gt;= amount_units).cloned())
    }

    async fn record_verified_refund(&amp;self, tenant_id: Uuid, provider_payment_id: &amp;str, amount_units: i64, provider_refund_id: &amp;str) -&gt; WalletRepoResult&lt;bool&gt; {
        {
            let g=self.inner.lock().unwrap();
            if g.get(&amp;tenant_id).map(|(_,txs,_)| txs.iter().any(|t| t.reference_type.as_deref()==Some(&quot;provider_refund&quot;) &amp;&amp; t.reference_id.as_deref()==Some(provider_refund_id))).unwrap_or(false) {
                return Ok(true);
            }
        }
        let mut g=self.sessions.lock().unwrap();
        let Some(s)=g.values_mut().find(|s| s.tenant_id==tenant_id &amp;&amp; s.provider_payment_id.as_deref()==Some(provider_payment_id) &amp;&amp; s.status==WalletTopUpSession::COMPLETED) else { return Ok(false); };
        if amount_units &lt;= 0 || s.refunded_amount_units.saturating_add(amount_units) &gt; s.amount_units { return Ok(false); }
        s.refunded_amount_units += amount_units;
        s.updated_at=Utc::now();
        drop(g);
        let _=self.credit(tenant_id, amount_units, WalletTransactionType::Refund, &amp;format!(&quot;refund:{provider_refund_id}&quot;), Some(&quot;Verified payment refund&quot;)).await?;
        let mut refunds=self.refunds.lock().unwrap();
        if let Some(r)=refunds.values_mut().find(|r| r.tenant_id==tenant_id &amp;&amp; r.provider_refund_id.as_deref()==Some(provider_refund_id)) {
            r.status=&quot;COMPLETED&quot;.to_owned();
            r.updated_at=Utc::now();
        }
        Ok(true)
    }

    async fn create_refund_request(&amp;self, request: &amp;domain::WalletRefundRequest) -&gt; WalletRepoResult&lt;Option&lt;domain::WalletRefundRequest&gt;&gt; {
        let mut g=self.refunds.lock().unwrap();
        if let Some(existing)=g.get(&amp;request.idempotency_key) { return Ok(Some(existing.clone())); }
        g.insert(request.idempotency_key.clone(),request.clone());
        Ok(Some(request.clone()))
    }

    async fn set_refund_provider_id(&amp;self, tenant_id: Uuid, idempotency_key: &amp;str, provider_refund_id: &amp;str) -&gt; WalletRepoResult&lt;()&gt; {
        let mut g=self.refunds.lock().unwrap();
        if let Some(r)=g.get_mut(idempotency_key) {
            if r.tenant_id==tenant_id &amp;&amp; r.provider_refund_id.is_none() {
                r.provider_refund_id=Some(provider_refund_id.to_owned());
                r.status=&quot;SUBMITTED&quot;.to_owned();
                r.updated_at=Utc::now();
            }
        }
        Ok(())
    }

    async fn claim_auto_top_up(&amp;self, tenant_id: Uuid, lease_id: Uuid, lease_for: std::time::Duration) -&gt; WalletRepoResult&lt;bool&gt; {
        let mut g=self.claims.lock().unwrap();
        let now=Utc::now();
        if let Some((_,until))=g.get(&amp;tenant_id) {
            if *until &gt; now { return Ok(false); }
        }
        g.insert(tenant_id,(lease_id,now+chrono::Duration::from_std(lease_for).unwrap_or(chrono::Duration::seconds(60))));
        Ok(true)
    }

    async fn release_auto_top_up(&amp;self, tenant_id: Uuid, lease_id: Uuid) -&gt; WalletRepoResult&lt;()&gt; {
        let mut g=self.claims.lock().unwrap();
        if g.get(&amp;tenant_id).map(|x|x.0)==Some(lease_id) { g.remove(&amp;tenant_id); }
        Ok(())
    }

    async fn record_auto_top_up_attempt(&amp;self, attempt: &amp;AutoTopUpAttempt) -&gt; WalletRepoResult&lt;()&gt; {
        let mut g = self.attempts.lock().unwrap();
        if !g.iter().any(|x| x.id == attempt.id) { g.push(attempt.clone()); }
        Ok(())
    }

    async fn get_settings(&amp;self, tenant_id: Uuid) -&gt; WalletRepoResult&lt;WalletSettings&gt; {
        let mut g = self.settings.lock().unwrap();
        Ok(g.entry(tenant_id).or_insert_with(|| {
            let mut s = WalletSettings::default(); s.tenant_id = tenant_id; s
        }).clone())
    }

    async fn update_settings(&amp;self, settings: &amp;WalletSettings) -&gt; WalletRepoResult&lt;WalletSettings&gt; {
        if settings.critical_balance_threshold_units &gt; settings.low_balance_threshold_units ||
           settings.auto_top_up_amount_units &lt;= 0 || settings.daily_top_up_limit_units &lt;= 0 ||
           settings.monthly_top_up_limit_units &lt;= 0 || !(0..=10).contains(&amp;settings.retry_limit) {
            return Err(&quot;invalid wallet settings&quot;.into());
        }
        self.settings.lock().unwrap().insert(settings.tenant_id, settings.clone());
        Ok(settings.clone())
    }

    async fn expire_credit(&amp;self, tenant_id: Uuid, amount_units: i64, idempotency_key: &amp;str, description: Option&lt;&amp;str&gt;) -&gt; WalletRepoResult&lt;Option&lt;WalletTransaction&gt;&gt; {
        if amount_units &lt;= 0 { return Ok(None); }
        let mut g = self.inner.lock().unwrap();
        let (wallet, txs, _) = g.get_mut(&amp;tenant_id).ok_or(&quot;wallet not found&quot;)?;
        if let Some(x) = txs.iter().find(|t| t.idempotency_key == idempotency_key) { return Ok(Some(x.clone())); }
        let debit = amount_units.min(wallet.balance_units);
        if debit == 0 { return Ok(None); }
        wallet.balance_units -= debit;
        wallet.updated_at = Utc::now();
        let tx = WalletTransaction {
            id: Uuid::new_v4(), tenant_id, wallet_id: wallet.id, transaction_type: WalletTransactionType::Expiration,
            amount_units: -debit, balance_after_units: wallet.balance_units, idempotency_key: idempotency_key.to_owned(),
            reference_type: Some(&quot;promotional_credit&quot;.to_owned()), reference_id: None,
            description: description.map(str::to_owned), created_at: Utc::now()
        };
        txs.push(tx.clone());
        Ok(Some(tx))
    }

    async fn grant_promotional_credit(&amp;self, tenant_id: Uuid, amount_units: i64, expires_at: DateTime&lt;Utc&gt;, idempotency_key: &amp;str, description: Option&lt;&amp;str&gt;) -&gt; WalletRepoResult&lt;WalletTransaction&gt; {
        if expires_at &lt;= Utc::now() { return Err(&quot;promotional credit already expired&quot;.into()); }
        let tx = self.credit(tenant_id, amount_units, WalletTransactionType::PromotionalCredit, idempotency_key, description).await?;
        let mut promos = self.promos.lock().unwrap();
        if !promos.iter().any(|p| p.tenant_id == tenant_id &amp;&amp; p.id == tx.id) {
            promos.push(Promo { id: tx.id, tenant_id, remaining: amount_units, expires_at });
        }
        Ok(tx)
    }

    async fn expire_promotional_credits(&amp;self, limit: u32) -&gt; WalletRepoResult&lt;u64&gt; {
        let now = Utc::now();
        let mut promos = self.promos.lock().unwrap();
        let ids: Vec&lt;_&gt; = promos.iter().filter(|p| p.expires_at &lt;= now &amp;&amp; p.remaining &gt; 0).take(limit.min(500) as usize).map(|p| (p.id,p.tenant_id,p.remaining)).collect();
        drop(promos);
        let mut n=0;
        for (id,tenant,remaining) in ids {
            let _ = self.expire_credit(tenant, remaining, &amp;format!(&quot;expiration:{id}&quot;), Some(&quot;Promotional credit expired&quot;)).await?;
            let mut promos=self.promos.lock().unwrap();
            if let Some(p)=promos.iter_mut().find(|p| p.id==id) { p.remaining=0; }
            n+=1;
        }
        Ok(n)
    }

    async fn auto_top_up_candidates(&amp;self, limit: u32) -&gt; WalletRepoResult&lt;Vec&lt;domain::AutoTopUpCandidate&gt;&gt; {
        let settings=self.settings.lock().unwrap().clone();
        let attempts=self.attempts.lock().unwrap().clone();
        let wallets=self.inner.lock().unwrap().values().map(|(w,_,_)|w.clone()).collect::&lt;Vec&lt;_&gt;&gt;();
        let today=Utc::now().date_naive();
        let month=Utc::now().month();
        let mut out=Vec::new();
        for w in wallets {
            let Some(s)=settings.get(&amp;w.tenant_id) else { continue; };
            if !s.auto_top_up_enabled || w.balance_units &gt;= s.auto_top_up_threshold_units { continue; }
            let daily=attempts.iter().filter(|a|a.tenant_id==w.tenant_id &amp;&amp; a.attempted_at.date_naive()==today &amp;&amp; a.status==&quot;SUCCEEDED&quot;).map(|a|a.amount_units).sum();
            let monthly=attempts.iter().filter(|a|a.tenant_id==w.tenant_id &amp;&amp; a.attempted_at.month()==month &amp;&amp; a.attempted_at.year()==Utc::now().year() &amp;&amp; a.status==&quot;SUCCEEDED&quot;).map(|a|a.amount_units).sum();
            let daily_attempts=attempts.iter().filter(|a|a.tenant_id==w.tenant_id &amp;&amp; a.attempted_at.date_naive()==today).count() as i32;
            out.push(domain::AutoTopUpCandidate{tenant_id:w.tenant_id,balance_units:w.balance_units,settings:s.clone(),daily_spend_units:daily,monthly_spend_units:monthly,daily_attempts});
            if out.len() &gt;= limit as usize { break; }
        }
        Ok(out)
    }

    async fn record_balance_notification(&amp;self, tenant_id:Uuid,event_type:&amp;str,dedupe_key:&amp;str,message:&amp;str)-&gt;WalletRepoResult&lt;bool&gt;{
        let mut g=self.notifications.lock().unwrap();
        if g.iter().any(|n|n.tenant_id==tenant_id &amp;&amp; n.event_type==event_type &amp;&amp; n.dedupe_key==dedupe_key){return Ok(false);}
        g.push(WalletNotification{id:Uuid::new_v4(),tenant_id,event_type:event_type.to_owned(),dedupe_key:dedupe_key.to_owned(),message:message.to_owned(),read_at:None,email_sent_at:None,email_processing_at:None,created_at:Utc::now()});
        Ok(true)
    }

    async fn list_balance_notifications(&amp;self, tenant_id:Uuid, limit:u32)-&gt;WalletRepoResult&lt;Vec&lt;WalletNotification&gt;&gt;{
        Ok(self.notifications.lock().unwrap().iter().rev().filter(|n|n.tenant_id==tenant_id).take(limit.min(100) as usize).cloned().collect())
    }

    async fn claim_pending_email_notifications(&amp;self, limit:u32)-&gt;WalletRepoResult&lt;Vec&lt;WalletNotification&gt;&gt;{
        let mut g=self.notifications.lock().unwrap();
        let now=Utc::now();
        let mut out=Vec::new();
        for n in g.iter_mut().filter(|n|n.email_sent_at.is_none() &amp;&amp; n.email_processing_at.is_none()).take(limit.min(100) as usize) {
            n.email_processing_at=Some(now);
            out.push(n.clone());
        }
        Ok(out)
    }

    async fn mark_balance_notification_emailed(&amp;self, id:Uuid)-&gt;WalletRepoResult&lt;bool&gt;{
        let mut g=self.notifications.lock().unwrap();
        if let Some(n)=g.iter_mut().find(|n|n.id==id &amp;&amp; n.email_sent_at.is_none()){
            n.email_sent_at=Some(Utc::now());
            n.email_processing_at=None;
            return Ok(true);
        }
        Ok(false)
    }
}
