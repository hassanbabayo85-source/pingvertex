                }}
                &lt;section class=&quot;card&quot;&gt;
                    &lt;div class=&quot;section-heading&quot;&gt;&lt;h2&gt;&quot;Pending&quot;&lt;/h2&gt;&lt;span class=&quot;muted&quot;&gt;&quot;Expired invitations are handled by the server.&quot;&lt;/span&gt;&lt;/div&gt;
                    {move || if invitations.get().is_empty() {
