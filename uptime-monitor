    let fetched = read_json(get_response).await;
    assert_eq!(
        fetched[&quot;kind&quot;], &quot;Tcp&quot;,
        &quot;the kind switch must survive a fresh GET, not just the PUT response body&quot;
    );
    assert_eq!(fetched[&quot;tcp_port&quot;], 5432);
}

