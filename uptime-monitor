        let query = format!(
            &quot;SELECT {MONITOR_COLUMNS} FROM monitors WHERE user_id = $1 ORDER BY created_at DESC&quot;
        );
        let monitor_rows = sqlx::query_as::&lt;_, MonitorRow&gt;(&amp;query)
            .bind(user_id.0)
            .fetch_all(&amp;self.pool)
            .await?;
        if monitor_rows.is_empty() {
