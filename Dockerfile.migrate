FROM rust:1.99.0-slim-bookworm AS builder
USER root
ENV PATH="/usr/local/cargo/bin:$PATH"

WORKDIR /build

RUN apt-get update && apt-get install -y --no-install-recommends \
    pkg-config \
    libssl-dev \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

RUN /usr/local/cargo/bin/cargo install sqlx-cli --version 0.8.3 --no-default-features --features postgres

FROM debian:13.1-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    libssl3 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY --from=builder /usr/local/cargo/bin/sqlx /usr/local/bin/sqlx
COPY migrations ./migrations

RUN groupadd -r app && useradd -r -g app -u 1000 appuser
USER appuser

ENTRYPOINT ["sqlx"]
CMD ["migrate", "run", "--source", "migrations"]
