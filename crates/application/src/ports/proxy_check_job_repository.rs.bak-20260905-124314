use async_trait::async_trait;
use std::sync::Arc;

use domain::entities::{ProxyCheckJob, ProxyEntry};
use domain::enums::ProxyScheme;
use domain::shared::ids::{ProxyCheckJobId, TenantId, UserId};

use crate::ports::monitor_repository::{QuotaCheckOutcome, RepoResult};

#[derive(Debug, Clone, Copy, PartialEq, Eq)]
pub enum ProxyResultStatusFilter {
    Working,
    Failed,
}

#[async_trait]
pub trait ProxyCheckJobRepository: Send + Sync {
    async fn save_job(&self, job: &ProxyCheckJob, entries: &[ProxyEntry]) -> RepoResult<()>;

    async fn save_job_if_within_quota(
        &self,
        job: &ProxyCheckJob,
        entries: &[ProxyEntry],
        user_id: UserId,
        tenant_id: TenantId,
        limit: usize,
    ) -> RepoResult<QuotaCheckOutcome>;

    /// Atomically claims a pending job. Exactly one concurrent caller can win.
    async fn try_mark_running(&self, id: ProxyCheckJobId, worker_id: &str) -> RepoResult<bool>;

    async fn heartbeat(&self, id: ProxyCheckJobId, worker_id: &str) -> RepoResult<bool>;

    /// Requeues stale jobs up to `max_retries`; jobs at the retry ceiling are failed.
    async fn recover_stale_jobs(
        &self,
        stale_before: chrono::DateTime<chrono::Utc>,
        max_retries: u32,
    ) -> RepoResult<u64>;

    async fn update_job(&self, job: &ProxyCheckJob) -> RepoResult<()>;

    async fn find_job_by_id(
        &self,
        id: ProxyCheckJobId,
        tenant_id: TenantId,
    ) -> RepoResult<Option<ProxyCheckJob>>;

    async fn find_jobs_by_user_id(
        &self,
        user_id: UserId,
        tenant_id: TenantId,
    ) -> RepoResult<Vec<ProxyCheckJob>>;

    async fn find_jobs_by_tenant_id(&self, tenant_id: TenantId) -> RepoResult<Vec<ProxyCheckJob>>;

    async fn update_entry(&self, entry: &ProxyEntry, tenant_id: TenantId) -> RepoResult<()>;

    async fn find_entries_by_job_id(
        &self,
        job_id: ProxyCheckJobId,
        tenant_id: TenantId,
    ) -> RepoResult<Vec<ProxyEntry>>;

    async fn list_entries(
        &self,
        job_id: ProxyCheckJobId,
        tenant_id: TenantId,
        offset: u32,
        limit: u32,
        status: Option<ProxyResultStatusFilter>,
        scheme: Option<ProxyScheme>,
        working_only: bool,
    ) -> RepoResult<(Vec<ProxyEntry>, u32)>;

    async fn cancel_job(&self, id: ProxyCheckJobId, tenant_id: TenantId) -> RepoResult<bool>;

    async fn find_pending_jobs(&self, limit: usize) -> RepoResult<Vec<ProxyCheckJob>>;
}

#[async_trait]
impl<T> ProxyCheckJobRepository for Arc<T>
where
    T: ProxyCheckJobRepository + Send + Sync + ?Sized,
{
    async fn save_job(&self, job: &ProxyCheckJob, entries: &[ProxyEntry]) -> RepoResult<()> {
        (**self).save_job(job, entries).await
    }
    async fn save_job_if_within_quota(
        &self,
        job: &ProxyCheckJob,
        entries: &[ProxyEntry],
        user_id: UserId,
        tenant_id: TenantId,
        limit: usize,
    ) -> RepoResult<QuotaCheckOutcome> {
        (**self)
            .save_job_if_within_quota(job, entries, user_id, tenant_id, limit)
            .await
    }
    async fn try_mark_running(&self, id: ProxyCheckJobId, worker_id: &str) -> RepoResult<bool> {
        (**self).try_mark_running(id, worker_id).await
    }
    async fn heartbeat(&self, id: ProxyCheckJobId, worker_id: &str) -> RepoResult<bool> {
        (**self).heartbeat(id, worker_id).await
    }
    async fn recover_stale_jobs(
        &self,
        stale_before: chrono::DateTime<chrono::Utc>,
        max_retries: u32,
    ) -> RepoResult<u64> {
        (**self).recover_stale_jobs(stale_before, max_retries).await
    }
    async fn update_job(&self, job: &ProxyCheckJob) -> RepoResult<()> {
        (**self).update_job(job).await
    }
    async fn find_job_by_id(
        &self,
        id: ProxyCheckJobId,
        tenant_id: TenantId,
    ) -> RepoResult<Option<ProxyCheckJob>> {
        (**self).find_job_by_id(id, tenant_id).await
    }
    async fn find_jobs_by_user_id(
        &self,
        user_id: UserId,
        tenant_id: TenantId,
    ) -> RepoResult<Vec<ProxyCheckJob>> {
        (**self).find_jobs_by_user_id(user_id, tenant_id).await
    }
    async fn find_jobs_by_tenant_id(&self, tenant_id: TenantId) -> RepoResult<Vec<ProxyCheckJob>> {
        (**self).find_jobs_by_tenant_id(tenant_id).await
    }
    async fn update_entry(&self, entry: &ProxyEntry, tenant_id: TenantId) -> RepoResult<()> {
        (**self).update_entry(entry, tenant_id).await
    }
    async fn find_entries_by_job_id(
        &self,
        job_id: ProxyCheckJobId,
        tenant_id: TenantId,
    ) -> RepoResult<Vec<ProxyEntry>> {
        (**self).find_entries_by_job_id(job_id, tenant_id).await
    }
    async fn list_entries(
        &self,
        job_id: ProxyCheckJobId,
        tenant_id: TenantId,
        offset: u32,
        limit: u32,
        status: Option<ProxyResultStatusFilter>,
        scheme: Option<ProxyScheme>,
        working_only: bool,
    ) -> RepoResult<(Vec<ProxyEntry>, u32)> {
        (**self)
            .list_entries(
                job_id,
                tenant_id,
                offset,
                limit,
                status,
                scheme,
                working_only,
            )
            .await
    }
    async fn cancel_job(&self, id: ProxyCheckJobId, tenant_id: TenantId) -> RepoResult<bool> {
        (**self).cancel_job(id, tenant_id).await
    }
    async fn find_pending_jobs(&self, limit: usize) -> RepoResult<Vec<ProxyCheckJob>> {
        (**self).find_pending_jobs(limit).await
    }
}
