.monitor-detail .monitor-health-metrics .metric-card:hover {
  transform: translateY(-2px);
  box-shadow: 0 12px 25px rgba(30,35,70,.075);
}

.monitor-detail .monitor-health-metrics .metric-card .card-label,
.monitor-detail .monitor-health-metrics .metric-card label {
  color: #8a91a1;
  font-size: .62rem;
  font-weight: 800;
  letter-spacing: .075em;
  text-transform: uppercase;
}

.monitor-detail .monitor-health-metrics .metric-card .card-value {
  margin-top: 8px;
  color: #202535;
  font-size: 1.15rem;
  font-weight: 800;
  letter-spacing: -.025em;
}

/* Detail sections */

.monitor-detail > .data-section {
  padding: 21px;
  border-radius: 16px;
  border: 1px solid #e6e8ee;
  background: #fff;
  box-shadow: 0 7px 22px rgba(30,35,70,.04);
}

.monitor-detail > .data-section .section-heading {
  margin-bottom: 15px;
}

.monitor-detail > .data-section .section-heading h2 {
  margin: 0;
  color: #252a38;
  font-size: .95rem;
  font-weight: 800;
  letter-spacing: -.02em;
}

.monitor-detail > .data-section .section-heading .muted {
  font-size: .68rem;
}

/* Performance */

.monitor-detail .performance-bars {
  padding: 7px 0 2px;
  gap: 8px;
}

.monitor-detail .performance-row {
  min-height: 30px;
  grid-template-columns: 30px 1fr 82px;
  gap: 10px;
}

.monitor-detail .performance-index {
  color: #a1a7b4;
  font-size: .61rem;
}

.monitor-detail .performance-track {
  height: 8px;
  overflow: hidden;
  border-radius: 999px;
  background: #f0f1f5;
}

.monitor-detail .performance-fill {
  min-width: 3px;
  height: 100%;
  border-radius: inherit;
  opacity: .9;
  transition: width .25s ease;
}

.monitor-detail .performance-value {
  color: #626a7a;
  font-size: .66rem;
}

/* Tables */

.monitor-detail table {
  width: 100%;
}

.monitor-detail table thead th {
  height: 43px;
  padding: 0 12px;
  background: #fafbfe;
  color: #8b92a2;
  border-bottom: 1px solid #e9ebf0;
  font-size: .61rem;
  font-weight: 800;
  letter-spacing: .07em;
  text-transform: uppercase;
  white-space: nowrap;
}

.monitor-detail table tbody td {
  padding: 12px;
  border-bottom: 1px solid #f0f1f4;
  color: #4b5262;
  font-size: .72rem;
}

.monitor-detail table tbody tr:hover {
  background: #fbfbff;
}

.monitor-detail table tbody tr:last-child td {
  border-bottom: 0;
}

.monitor-detail .mono {
  font-family: var(--font-mono);
  font-size: .66rem;
}

/* Notification creation */

.monitor-detail .channel-form {
  margin-top: 17px;
  padding: 14px;
  border-radius: 12px;
  border: 1px dashed #d9dce5;
  background: #fafbfe;
}

.monitor-detail .channel-form input,
.monitor-detail .channel-form select {
  min-height: 40px;
  border-radius: 9px;
  border-color: #dfe2e9;
  background: #fff;
}

.monitor-detail .channel-form .btn {
  min-height: 40px;
  border-radius: 9px;
  font-weight: 750;
}

.monitor-detail .list-stack {
  gap: 8px;
}

.monitor-detail .list-row {
  padding: 14px 15px;
  border: 1px solid #e7e9ef;
  border-radius: 11px;
  background: #fafbfe;
}

.monitor-detail .list-row strong {
  color: #303646;
  font-size: .76rem;
}

.monitor-detail .list-row .muted {
  margin-top: 3px;
  font-size: .67rem;
}

.monitor-detail .escalation-steps {
  margin: 10px 0 0 18px;
  color: #737b8c;
  font-size: .67rem;
  line-height: 1.8;
}

/* Empty states */

.monitor-detail .empty-state,
.monitor-detail .error-state {
  border-radius: 12px;
}

.monitor-detail .empty-state {
  min-height: 130px;
  background:
    radial-gradient(circle at center, rgba(103,92,224,.035), transparent 65%);
}

/* Alerts */

.monitor-detail .alert,
.monitor-form-page .alert {
  border-radius: 10px;
  font-size: .73rem;
}

/* ---------- Shared loading state ---------- */

.monitor-detail .loading,
.monitor-form-page .loading {
  min-height: 140px;
  display: grid;
  place-items: center;
  border: 1px dashed #dfe2e9;
  border-radius: 14px;
  background: #fbfcfe;
  color: #858d9d;
  font-size: .75rem;
}

/* ---------- Mobile ---------- */

@media (max-width: 980px) {
  .monitor-detail .monitor-health-metrics {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }
}

@media (max-width: 720px) {
  .monitors-page > .page-header,
  .monitor-form-page > .page-header,
  .monitor-detail > .page-header {
    padding: 19px;
    border-radius: 14px;
  }

  .monitors-page table {
    min-width: 850px;
  }

  .monitors-page .monitor-table-wrap {
    overflow-x: auto;
  }

  .monitor-form .form-section,
  .monitor-detail > .data-section {
    padding: 17px;
    border-radius: 13px;
  }

  .monitor-form-page > .page-header h1 {
    font-size: 1.55rem;
  }

  .monitor-detail > .page-header {
    align-items: flex-start;
  }

  .monitor-detail .monitor-health-metrics {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .monitor-detail .monitor-identity .muted {
    white-space: normal;
  }

  .monitor-detail .performance-row {
    min-width: 420px;
  }

  .monitor-detail .table-responsive {
    overflow-x: auto;
  }

  .monitor-form .form-actions {
