}

.monitor-detail .monitor-health-metrics .metric-card {
  min-height: 112px;
  padding: 17px;
  border-radius: 14px;
  border: 1px solid #e5e7ee;
  background: #fff;
  box-shadow: 0 7px 20px rgba(30,35,70,.04);
