}

.monitor-detail .monitor-identity h2 {
  margin: 3px 0 5px;
  font-size: 1.25rem;
  letter-spacing: -.035em;
}

.monitor-detail .monitor-identity .muted {
  max-width: 800px;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.monitor-detail .monitor-status {
  position: relative;
  z-index: 2;
}

/* Detail metric cards */

.monitor-detail .monitor-health-metrics {
  display: grid;
  grid-template-columns: repeat(5, minmax(0, 1fr));
