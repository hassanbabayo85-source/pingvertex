.auth-preview-card {
  display: flex;
  border-radius: 16px;
  overflow: hidden;
  background: #fff;
  border: 1px solid rgba(15, 23, 42, 0.08);
  box-shadow: 0 30px 60px rgba(15, 23, 42, 0.14);
}

.auth-preview-sidebar {
  width: 118px;
  flex: none;
  background: #171b2b;
  padding: 16px 12px;
  display: flex;
  flex-direction: column;
  gap: 10px;
}

.auth-preview-sidebar-brand {
  color: #fff;
  font-size: 11px;
  font-weight: 700;
  margin-bottom: 8px;
  letter-spacing: -0.01em;
}

.auth-preview-nav-item {
  font-size: 10.5px;
  color: rgba(255, 255, 255, 0.55);
  padding: 6px 8px;
  border-radius: 6px;
}

.auth-preview-nav-active {
  background: rgba(99, 102, 241, 0.35);
  color: #fff;
}

.auth-preview-main {
  flex: 1;
  min-width: 0;
  padding: 16px 18px 18px;
}

.auth-preview-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 10px;
}

.auth-preview-heading {
  font-size: 12.5px;
  font-weight: 700;
  color: #111827;
}

.auth-preview-range {
  font-size: 10px;
  color: #9ca3af;
}

.auth-preview-status {
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 10px 12px;
  border-radius: 10px;
  background: rgba(34, 197, 94, 0.08);
  margin-bottom: 12px;
}

.auth-preview-status-dot {
  width: 18px;
  height: 18px;
  flex: none;
  border-radius: 50%;
  background: #22c55e;
}

.auth-preview-status-copy {
  min-width: 0;
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 2px;
}

.auth-preview-status-copy strong {
  font-size: 10.5px;
  color: #111827;
}

.auth-preview-status-copy small {
  font-size: 9.5px;
  color: #6b7280;
}

.auth-preview-status-pct {
  font-size: 10.5px;
  font-weight: 700;
  color: #16a34a;
  white-space: nowrap;
}

.auth-preview-graph {
  width: 100%;
  height: 40px;
  margin-bottom: 12px;
}

.auth-preview-graph polyline {
  fill: none;
  stroke: #22c55e;
  stroke-width: 2;
  stroke-linecap: round;
  stroke-linejoin: round;
}

.auth-preview-services {
  display: flex;
  flex-direction: column;
  gap: 8px;
}

.auth-preview-service {
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: 10.5px;
  color: #374151;
}

.auth-preview-pill {
  padding: 2px 8px;
  border-radius: 999px;
  background: rgba(34, 197, 94, 0.14);
  color: #16a34a;
  font-weight: 700;
  font-size: 9.5px;
}

.auth-preview-stat {
  position: absolute;
  top: -18px;
  right: -16px;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 2px;
  padding: 12px 16px;
  border-radius: 14px;
  background: #fff;
  border: 1px solid rgba(15, 23, 42, 0.08);
  box-shadow: 0 18px 40px rgba(15, 23, 42, 0.14);
}

.auth-preview-stat-value {
  font-size: 15px;
  font-weight: 800;
  color: #4f46e5;
}

.auth-preview-stat-label {
  font-size: 9px;
  color: #9ca3af;
}

.auth-preview-toast {
  position: absolute;
  left: -18px;
  bottom: -22px;
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 12px 16px;
  border-radius: 14px;
  background: #fff;
  border: 1px solid rgba(15, 23, 42, 0.08);
  box-shadow: 0 18px 40px rgba(15, 23, 42, 0.14);
  max-width: 240px;
}

.auth-preview-toast-icon {
  display: grid;
  place-items: center;
  width: 26px;
  height: 26px;
  flex: none;
  border-radius: 50%;
  background: rgba(34, 197, 94, 0.14);
  color: #16a34a;
}

.auth-preview-toast-icon svg {
  width: 15px;
  height: 15px;
}

.auth-preview-toast-copy strong {
  display: block;
  font-size: 11.5px;
  color: #111827;
}

.auth-preview-toast-copy small {
  font-size: 10px;
  color: #6b7280;
}

/* ---- Sign-in card wrapper ---- */

.auth-card-wrap {
  position: relative;
  z-index: 1;
  width: 100%;
  display: flex;
  justify-content: center;
}

.auth-card-brand {
  display: none;
  align-items: center;
  justify-content: center;
  gap: 11px;
  margin-bottom: 24px;
}

/* ---- Inputs with leading icon + trailing toggle ---- */

.input-wrap {
  position: relative;
  display: flex;
  align-items: center;
}

.input-wrap input {
  width: 100%;
  padding-left: 42px;
}

.input-wrap.has-toggle input {
  padding-right: 42px;
}

.input-icon {
  position: absolute;
  left: 13px;
  display: grid;
  place-items: center;
  color: #9ca3af;
  pointer-events: none;
}

.input-icon-svg {
  width: 17px;
  height: 17px;
}

.input-toggle {
  position: absolute;
  right: 6px;
  display: grid;
  place-items: center;
  width: 32px;
  height: 32px;
  padding: 0;
  min-height: 0;
  border: none;
  background: transparent;
  color: #9ca3af;
  cursor: pointer;
  border-radius: 8px;
}

.input-toggle:hover {
  background: rgba(15, 23, 42, 0.05);
  color: #4b5563;
}

.input-toggle svg {
  width: 17px;
  height: 17px;
}

.auth-form .btn-primary {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
}

.auth-form .btn-primary svg {
  width: 16px;
  height: 16px;
}

/* ---- Responsive: reveal the desktop split + preview ---- */

@media (min-width: 960px) {
  .auth-shell {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    gap: 72px;
    max-width: 1180px;
    margin: 0 auto;
    padding: 48px 40px;
  }

  .auth-visual {
    flex: 1 1 560px;
    padding-bottom: 56px;
  }

  .auth-preview {
    display: block;
    margin-top: 40px;
  }

  .auth-card-wrap {
    flex: 1 1 440px;
    max-width: 460px;
  }

  .auth-card-brand {
    display: flex;
  }
}

@media (max-width: 520px) {
  .auth-shell {
    padding: 20px 16px 40px;
    gap: 28px;
  }

  .auth-visual-title {
    font-size: 30px;
  }

  .auth-feature-grid {
    gap: 12px;
    margin-bottom: 24px;
  }

  .auth-feature h3 {
    font-size: 11.5px;
  }

  .auth-feature p {
    font-size: 11px;
  }

  .auth-feature-icon {
    width: 34px;
    height: 34px;
    margin-bottom: 8px;
  }

  .auth-card {
    padding: 28px 22px;
    border-radius: 20px;
  }

  .auth-card h1 {
    font-size: 28px;
  }
}

@media (prefers-reduced-motion: reduce) {
  .input-toggle {
    transition: none;
  }
}
