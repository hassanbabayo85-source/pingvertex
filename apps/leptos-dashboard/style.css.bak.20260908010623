/* ========================================================================
   PINGVERTEX PREMIUM UI
   Global redesign for the complete Leptos frontend.
   ======================================================================== */

:root {
  --pv-bg: #f6f7fb;
  --pv-surface: #ffffff;
  --pv-surface-soft: #fafbff;

  --pv-border: #e7e9f0;
  --pv-border-strong: #d9dce7;

  --pv-text: #111827;
  --pv-muted: #667085;
  --pv-faint: #98a2b3;

  --pv-primary: #5b5cf0;
  --pv-primary-2: #4648d9;
  --pv-primary-soft: #f0f0ff;

  --pv-success: #12a56a;
  --pv-success-soft: #eaf9f2;

  --pv-danger: #e5484d;
  --pv-danger-soft: #fff0f1;

  --pv-warning: #d98b19;
  --pv-warning-soft: #fff7e8;

  --pv-radius: 14px;
  --pv-radius-sm: 10px;

  --pv-shadow:
    0 1px 2px rgba(16,24,40,.03),
    0 10px 28px rgba(16,24,40,.045);

  --pv-shadow-hover:
    0 8px 30px rgba(16,24,40,.08);
}


/* ========================================================================
   BASE
   ======================================================================== */

html,
body {
  background: var(--pv-bg);
}

body {
  color: var(--pv-text);
  font-size: 14px;

  background:
    radial-gradient(
      circle at 85% -10%,
      rgba(91,92,240,.07),
      transparent 28rem
    ),
    var(--pv-bg);
}


/* ========================================================================
   APP SHELL
   ======================================================================== */

.app-shell {
  min-height: 100vh;
}

.app-content {
  min-width: 0;
}

.app-main {
  width: 100%;
  max-width: 1480px;

  padding:
    30px
    clamp(20px, 3vw, 42px)
    52px;
}


/* ========================================================================
   SIDEBAR
   ======================================================================== */

.sidebar {
  width: 252px;
  min-width: 252px;

  padding: 16px 12px 14px;

  gap: 14px;

  background:
    radial-gradient(
      circle at 15% 0%,
      rgba(91,92,240,.18),
      transparent 20rem
    ),
    linear-gradient(
      180deg,
      #0d1224 0%,
      #090e1b 100%
    );

  border-right:
    1px solid rgba(255,255,255,.075);

  box-shadow:
    12px 0 36px rgba(9,14,27,.07);
}

.sidebar-brand {
  min-height: 58px;

  padding:
    4px
    7px
    14px;

  border-bottom-color:
    rgba(255,255,255,.08);
}

.brand-link {
  display: inline-flex;
  align-items: center;

  gap: 10px;

  min-width: 0;

  color: #fff !important;

  text-decoration: none !important;
}

.brand-mark {
  width: 38px;
  height: 38px;

  flex: 0 0 38px;

  color: #8f95ac;

  filter:
    drop-shadow(
      0 6px 16px
      rgba(91,92,240,.25)
    );
}

.brand-copy {
  display: flex;
  flex-direction: column;

  min-width: 0;

  line-height: 1;
}

.brand-copy strong {
  color: #fff;

  font-size: 1.02rem;
  font-weight: 750;

  letter-spacing: -.035em;
}

.brand-copy small {
  margin-top: 5px;

  color:
    rgba(255,255,255,.36);

  font-size: .48rem;
  font-weight: 800;

  letter-spacing: .16em;
}

.sidebar-brand a::before,
.sidebar-brand a::after {
  content: none !important;
}

.sidebar-live {
  display: flex;
  align-items: center;

  gap: 8px;

  margin: 0 4px;

  padding: 9px 10px;

  border:
    1px solid
    rgba(255,255,255,.075);

  border-radius: 10px;

  color:
    rgba(255,255,255,.62);

  background:
    rgba(255,255,255,.035);

  font-size: .68rem;
  font-weight: 600;
}

.live-dot {
  width: 7px;
  height: 7px;

  border-radius: 50%;

  background: #29c986;

  box-shadow:
    0 0 0 4px rgba(41,201,134,.12),
    0 0 14px rgba(41,201,134,.35);
}

.sidebar-nav {
  gap: 18px;
  padding: 0 1px;
}

.sidebar-group {
  gap: 3px;
}

.sidebar-group-label {
  margin:
    0
    9px
    6px;

  padding: 0;

  color:
    rgba(255,255,255,.32);

  font-size: .58rem;
  font-weight: 750;

  letter-spacing: .15em;
}

.sidebar-group a {
  min-height: 38px;

  padding:
    8px
    10px;

  border-radius: 9px;

  color:
    rgba(255,255,255,.61);

  font-size: .78rem;
  font-weight: 550;

  transition:
    transform 140ms ease,
    background 140ms ease,
    color 140ms ease,
    border-color 140ms ease;
}

.sidebar-group a::before {
  width: 18px;
  flex: 0 0 18px;

  color:
    rgba(255,255,255,.32);

  font-size: .8rem;
}

.sidebar-group a:hover {
  color: #fff;

  background:
    rgba(255,255,255,.055);

  border-color:
    rgba(255,255,255,.055);

  transform: translateX(1px);
}

.sidebar-group a.active {
  color: #fff;

  background:
    linear-gradient(
      100deg,
      rgba(91,92,240,.98),
      rgba(75,77,211,.88)
    );

  border-color:
    rgba(145,147,255,.28);

  box-shadow:
    0 8px 22px
    rgba(79,70,229,.22);
}

.sidebar-footer {
  padding:
    12px
    3px
    0;

  gap: 8px;
}

.sidebar-user {
  display: flex;
  align-items: center;

  gap: 9px;

  padding: 9px;

  border-color:
    rgba(255,255,255,.08);

  border-radius: 11px;

  background:
    rgba(255,255,255,.035);
}

.sidebar-avatar {
  display: grid;
  place-items: center;

  width: 32px;
  height: 32px;

  flex: 0 0 32px;

  border-radius: 50%;

  color: #fff;

  background:
    linear-gradient(
      135deg,
      #7073ff,
      #4b4dd7
    );

  font-size: .72rem;
  font-weight: 800;
}

.sidebar-user-meta {
  display: flex;
  flex-direction: column;

  min-width: 0;

  line-height: 1.25;
}

.sidebar-user-meta strong {
  overflow: hidden;

  color:
    rgba(255,255,255,.88);

  font-size: .69rem;
  font-weight: 700;

  text-overflow: ellipsis;
  white-space: nowrap;
}

.sidebar-user-meta small {
  overflow: hidden;

  margin-top: 3px;

  color:
    rgba(255,255,255,.35);

  font-size: .57rem;

  text-overflow: ellipsis;
  white-space: nowrap;
}

.sidebar-signout {
  display: flex;
  align-items: center;

  gap: 8px;

  min-height: 36px;

  color:
    rgba(255,255,255,.46);

  font-size: .7rem;
}


/* ========================================================================
   TOP BAR
   ======================================================================== */

.topbar {
  position: sticky;
  top: 0;

  z-index: 15;

  display: flex;
  align-items: center;

  gap: 18px;

  min-height: 62px;

  padding:
    10px
    clamp(18px, 3vw, 40px);

  border-bottom:
    1px solid
    rgba(228,231,238,.88);

  background:
    rgba(255,255,255,.86);

  backdrop-filter: blur(18px);
  -webkit-backdrop-filter: blur(18px);
}

.topbar-search {
  display: flex;
  align-items: center;

  gap: 9px;

  width: min(520px, 55vw);

  min-height: 38px;

  padding: 0 11px;

  border:
    1px solid
    var(--pv-border);

  border-radius: 10px;

  color: #98a2b3;

  background: #f9fafc;

  font-size: .72rem;
}

.topbar-search-icon {
  color: #667085;
  font-size: 1.05rem;
  line-height: 1;
}

.topbar-search kbd {
  margin-left: auto;

  padding:
    3px
    6px;

  border:
    1px solid
    #e1e4eb;

  border-radius: 5px;

  color: #98a2b3;

  background: #fff;

  font-size: .58rem;

  font-family:
    var(--font-mono);
}

.topbar-actions {
  display: flex;
  align-items: center;

  gap: 8px;

  margin-left: auto;
}

.topbar-icon {
  display: grid;
  place-items: center;

  width: 36px;
  height: 36px;

  padding: 0;

  border:
    1px solid
    transparent;

  border-radius: 9px;

  color: #667085;

  background: transparent;

  font-size: .95rem;
}

.topbar-icon:hover {
  color: var(--pv-text);

  background: #f5f6fa;

  border-color:
    var(--pv-border);
}

.topbar-workspace {
  display: flex;
  align-items: center;

  gap: 8px;

  min-height: 38px;

  margin-left: 4px;

  padding:
    4px
    9px
    4px
    5px;

  border:
    1px solid
    var(--pv-border);

  border-radius: 10px;

  background: #fff;

  color: #475467;

  font-size: .69rem;
  font-weight: 650;
}

.workspace-avatar {
  display: grid;
  place-items: center;

  width: 28px;
  height: 28px;

  border-radius: 8px;

  color: #fff;

  background:
    linear-gradient(
      135deg,
      #6869f4,
      #4b4dd7
    );

  font-size: .7rem;
  font-weight: 800;
}

.workspace-name {
  max-width: 150px;

  overflow: hidden;

  text-overflow: ellipsis;
  white-space: nowrap;
}

.mobile-nav-toolbar {
  display: none;
}


/* ========================================================================
   PAGE HEADERS
   ======================================================================== */

.page-header,
.dashboard-page-header {
  margin-bottom: 22px;

  padding:
    24px
    26px;

  border:
    1px solid
    var(--pv-border);

  border-radius: 16px;

  background:
    radial-gradient(
      circle at 92% 5%,
      rgba(91,92,240,.09),
      transparent 15rem
    ),
    linear-gradient(
      135deg,
      #fff 0%,
      #fbfbff 100%
    );

  box-shadow: var(--pv-shadow);
}

.page-header h1,
.dashboard-page-header h1 {
  color: #101828;

  font-size:
    clamp(
      1.55rem,
      2.2vw,
      2.05rem
    );

  font-weight: 760;

  letter-spacing: -.045em;
}

.eyebrow {
  color: #7b80ef;

  font-size: .59rem;
  font-weight: 800;

  letter-spacing: .14em;
}


/* ========================================================================
   BUTTONS
   ======================================================================== */

button,
:is(.btn) {
  min-height: 38px;

  padding:
    .55rem
    .9rem;

  border:
    1px solid
    var(--pv-border-strong);

  border-radius: 9px;

  color: #344054;

  background: #fff;

  font-size: .76rem;
  font-weight: 650;

  box-shadow:
    0 1px 1px
    rgba(16,24,40,.02);

  transition:
    transform 140ms ease,
    box-shadow 140ms ease,
    background 140ms ease,
    border-color 140ms ease;
}

button:hover,
.btn:hover {
  background: #f9fafb;

  border-color:
    #cfd4df;

  box-shadow:
    0 4px 12px
    rgba(16,24,40,.06);

  transform: translateY(-1px);
}

button:active,
.btn:active {
  transform: translateY(0);
}

.btn-primary {
  color: #fff !important;

  border-color:
    var(--pv-primary) !important;

  background:
    linear-gradient(
      135deg,
      #6366f1,
      #4f46e5
    ) !important;

  box-shadow:
    0 7px 18px
    rgba(79,70,229,.2);
}

.btn-primary:hover {
  border-color:
    var(--pv-primary-2) !important;

  background:
    linear-gradient(
      135deg,
      #5d5ff0,
      #4338ca
    ) !important;

  box-shadow:
    0 9px 22px
    rgba(79,70,229,.25);
}


/* ========================================================================
   CARDS
   ======================================================================== */

.card,
.data-section,
.skeleton-card,
.dashboard-widget {
  border:
    1px solid
    var(--pv-border);

  border-radius:
    var(--pv-radius);

  background:
    var(--pv-surface);

  box-shadow:
    var(--pv-shadow);
}

.card {
  padding: 20px;
}

.card:hover {
  box-shadow:
    var(--pv-shadow-hover);
}


/* ========================================================================
   METRICS
   ======================================================================== */

.metric-strip {
  gap: 14px;
}

.metric-card {
  position: relative;

  min-height: 138px;

  padding:
    18px
    18px
    16px;

  overflow: hidden;

  gap: 6px;
}

.metric-card::before {
  position: absolute;

  top: 0;
  left: 0;

  width: 100%;
  height: 3px;

  border-radius: 99px;

  background: #d8dce7;
}

.metric-card:nth-child(1)::before {
  background: #6366f1;
}

.metric-card:nth-child(2)::before {
  background: #16a36b;
}

.metric-card:nth-child(3)::before {
  background: #e5484d;
}

.metric-card:nth-child(4)::before {
  background: #98a2b3;
}

.metric-card:nth-child(5)::before {
  background: #d98b19;
}

.metric-card.metric-primary {
  background:
    linear-gradient(
      145deg,
      #fff,
      #f8f8ff
    );

  border-color:
    #dddfff;
}

.card-label {
  color: #667085;

  font-size: .65rem;
  font-weight: 750;

  letter-spacing: .04em;

  text-transform: uppercase;
}

.card-value {
  margin-top: 2px;

  color: #101828;

  font-size: 2rem;
  font-weight: 760;

  letter-spacing: -.055em;
}

.card-value.up {
  color: var(--pv-success);
}

.card-value.down {
  color: var(--pv-danger);
}

.card-hint {
  color: #98a2b3;
  font-size: .66rem;
}


/* ========================================================================
   DASHBOARD
   ======================================================================== */

.dashboard-overview {
  gap: 22px;
}

.dashboard-page-header {
  display: flex;
  align-items: center;
  justify-content: space-between;

  min-height: 112px;
}

.dashboard-content {
  gap: 22px;
}

.dashboard-section {
  gap: 12px;
}

.section-heading,
.widget-heading {
  align-items: center;
}

.section-heading h2,
.widget-heading h2 {
  color: #101828;

  font-size: .95rem;
  font-weight: 740;
}

.dashboard-trend-grid {
  grid-template-columns:
    repeat(
      3,
      minmax(0, 1fr)
    );

  gap: 14px;
}

.dashboard-trend-card {
  min-height: 250px;

  padding: 18px;

  overflow: hidden;
}

.trend-value {
  color: #101828;

  font-size: 1.05rem;
  font-weight: 760;
}

.trend-chart-wrap {
  margin-top: 16px;

  border: 0;

  border-radius: 10px;

  background:
    linear-gradient(
      180deg,
      rgba(91,92,240,.045),
      rgba(91,92,240,0)
    );
}

.trend-chart {
  height: 132px;

  color:
    var(--pv-primary);
}

.trend-empty {
  min-height: 150px;

  margin-top: 16px;

  border:
    1px dashed
    #d9dce7;

  border-radius: 10px;

  background: #fbfcff;

  color: #667085;
}


/* ========================================================================
   TABLES
   ======================================================================== */

.table-responsive,
.table-scroll,
.monitor-table-wrap {
  width: 100%;

  overflow-x: auto;

  border:
    1px solid
    var(--pv-border);

  border-radius:
    var(--pv-radius);

  background: #fff;

  box-shadow:
    var(--pv-shadow);
}

table,
.data-table,
.dashboard-monitor-table {
  width: 100%;

  border-collapse:
    separate;

  border-spacing: 0;

  border: 0;

  box-shadow: none;

  background: #fff;
}

th,
.data-table th {
  padding:
    11px
    16px;

  border-bottom:
    1px solid
    var(--pv-border);

  color: #98a2b3;

  background: #fafbfc;

  font-size: .59rem;
  font-weight: 800;

  letter-spacing: .075em;

  text-transform: uppercase;
}

td,
.data-table td {
  padding:
    13px
    16px;

  border-bottom:
    1px solid
    #f0f1f5;

  color: #475467;

  font-size: .73rem;
}

tbody tr {
  transition:
    background 120ms ease;
}

tbody tr:hover td {
  background: #fafaff;
}

tbody tr:last-child td {
  border-bottom: 0;
}

.monitor-link {
  color: #101828;
  font-weight: 700;
}

.monitor-link:hover {
  color: var(--pv-primary);
  text-decoration: none;
}

.mono {
  font-variant-numeric: tabular-nums;

  font-family:
    var(--font-mono);

  font-size: .67rem;
}


/* ========================================================================
   STATUS BADGES
   ======================================================================== */

.status-badge {
  min-height: 25px;

  padding:
    4px
    8px;

  gap: 6px;

  border-radius: 999px;

  font-size: .63rem;
  font-weight: 750;
}

.status-badge-dot {
  width: 6px;
  height: 6px;
}

.status-badge-up {
  color: #087f51;

  background: #e9f9f1;

  border-color:
    #cceede;
}

.status-badge-down {
  color: #c9363d;

  background: #fff0f1;

  border-color:
    #f5d2d5;
}

.status-badge-degraded {
  color: #a35f00;

  background: #fff6e5;

  border-color:
    #f3dfb8;
}

.status-badge-unknown,
.status-badge-neutral,
.status-badge-paused {
  color: #667085;

  background: #f1f3f6;

  border-color:
    #e2e5eb;
}


/* ========================================================================
   FORMS
   ======================================================================== */

input,
select,
textarea {
  border:
    1px solid
    var(--pv-border-strong);

  border-radius: 9px;

  color: #101828;

  background: #fff;

  outline: none;

  transition:
    border-color 140ms ease,
    box-shadow 140ms ease;
}

input:focus,
select:focus,
textarea:focus {
  border-color: #8b8df6;

  box-shadow:
    0 0 0 3px
    rgba(91,92,240,.11);
}

input::placeholder,
textarea::placeholder {
  color: #98a2b3;
}

label {
  color: #344054;

  font-size: .7rem;
  font-weight: 700;
}


/* ========================================================================
   ALERTS / EMPTY STATES / LOADING
   ======================================================================== */

.alert,
.toast,
.success,
.error,
.form-error,
.auth-success,
.error-state {
  border-radius: 11px;
}

.empty-state {
  border-color: #d9dce7;

  border-radius: 13px;

  background: #fff;

  box-shadow:
    var(--pv-shadow);
}

.loading-container {
  min-height: 180px;

  color: #667085;
}

.loading-spinner {
  width: 22px;
  height: 22px;

  border-color: #e4e6ee;

  border-top-color:
    var(--pv-primary);
}


/* ========================================================================
   INCIDENTS
   ======================================================================== */

.incident-list {
  overflow: hidden;

  border:
    1px solid
    var(--pv-border);

  border-radius:
    var(--pv-radius);

  background: #fff;

  box-shadow:
    var(--pv-shadow);
}

.incident-row {
  min-height: 62px;

  padding:
    11px
    16px;

  border-bottom:
    1px solid
    #f0f1f5;
}

.incident-row:last-child {
  border-bottom: 0;
}

.incident-link {
  color: #101828;
  font-weight: 700;
}

.incident-link:hover {
  color: var(--pv-primary);
  text-decoration: none;
}


/* ========================================================================
   FOOTER
   ======================================================================== */

.app-footer {
  display: flex;
  justify-content: center;
  align-items: center;

  gap: 7px;

  padding:
    18px
    24px
    24px;

  border-top:
    1px solid
    var(--pv-border);

  color: #98a2b3;

  background:
    rgba(255,255,255,.7);

  font-size: .62rem;
}

.app-footer span:first-child {
  color: #667085;
  font-weight: 750;
}


/* ========================================================================
   RESPONSIVE
   ======================================================================== */

@media (max-width: 1100px) {

  .sidebar {
    width: 232px;
    min-width: 232px;
  }

  .dashboard-trend-grid {
    grid-template-columns:
      repeat(
        2,
        minmax(0, 1fr)
      );
  }

  .metric-strip {
    grid-template-columns:
      repeat(
        3,
        minmax(0, 1fr)
      );
  }

  .topbar-search {
    width:
      min(
        430px,
        48vw
      );
  }
}


@media (max-width: 820px) {

  .sidebar {
    position: fixed;

    inset:
      0
      auto
      0
      0;

    z-index: 60;

    width:
      min(
        286px,
        88vw
      );

    min-width:
      min(
        286px,
        88vw
      );

    transform:
      translateX(-105%);

    transition:
      transform 180ms ease;
  }

  .sidebar.mobile-nav-open {
    transform:
      translateX(0);
  }

  .mobile-nav-toolbar {
    display: flex;
    align-items: center;
  }

  .mobile-nav-toggle {
    display: inline-flex;
    align-items: center;

    gap: 7px;

    min-height: 36px;

    padding:
      0
      10px;
  }

  .mobile-nav-close {
    display: inline-flex;
  }

  .topbar {
    gap: 10px;

    padding-inline:
      14px;
  }

  .topbar-search {
    display: none;
  }

  .topbar-actions {
    margin-left: auto;
  }

  .workspace-name {
    display: none;
  }

  .app-main {
    padding:
      20px
      14px
      36px;
  }
}


@media (max-width: 640px) {

  .dashboard-page-header,
  .page-header {
    align-items: flex-start;

    flex-direction: column;

    padding: 19px;
  }

  .metric-strip {
    grid-template-columns:
      repeat(
        2,
        minmax(0, 1fr)
      );
  }

  .dashboard-trend-grid {
    grid-template-columns: 1fr;
  }

  .dashboard-trend-card {
    min-height: 220px;
  }

  .metric-card {
    min-height: 124px;
  }

  .card-value {
    font-size: 1.7rem;
  }

  .app-footer {
    flex-wrap: wrap;
  }
}


@media (max-width: 430px) {

  .metric-strip {
    grid-template-columns: 1fr;
  }

  .topbar-icon {
    display: none;
  }

  .topbar-workspace {
    margin-left: 0;
  }
}


@media (prefers-reduced-motion: reduce) {

  *,
  *::before,
  *::after {
    scroll-behavior: auto !important;

    transition-duration:
      .01ms !important;

    animation-duration:
      .01ms !important;
  }
}


/* ============================================================
   PINGVERTEX — MONITOR WORKFLOW POLISH
   Monitors / Monitor Detail / Create / Edit
   Visual-only layer — preserves existing application logic.
   ============================================================ */

/* ---------- Monitor list ---------- */

.monitors-page {
  gap: 20px;
}

.monitors-page > .page-header {
  position: relative;
  overflow: hidden;
  padding: 26px 28px;
  border: 1px solid rgba(92, 82, 220, .10);
  border-radius: 18px;
  background:
    radial-gradient(circle at 90% 10%, rgba(103, 92, 230, .09), transparent 34%),
    linear-gradient(135deg, #ffffff 0%, #fbfbff 100%);
  box-shadow: 0 12px 34px rgba(30, 35, 70, .06);
}

.monitors-page > .page-header::after {
  content: "";
  position: absolute;
  right: -80px;
  top: -100px;
  width: 260px;
  height: 260px;
  border-radius: 50%;
  border: 1px solid rgba(99, 91, 220, .08);
  pointer-events: none;
}

.monitors-page > .page-header h1 {
  position: relative;
  z-index: 1;
  margin: 0;
  font-size: clamp(1.65rem, 2.5vw, 2.05rem);
  letter-spacing: -.045em;
}

.monitors-page > .page-header button {
  position: relative;
  z-index: 2;
  min-height: 42px;
  padding-inline: 18px;
  border-radius: 10px;
  font-weight: 700;
  box-shadow: 0 5px 14px rgba(83, 72, 210, .16);
}

/* Filter/search area */

.monitors-page .filter-bar,
.monitors-page .search-input,
.monitors-page .monitor-filters {
  border-radius: 12px;
}

.monitors-page .monitor-table-wrap {
  overflow: hidden;
  border-radius: 16px;
  background: rgba(255,255,255,.94);
  box-shadow:
    0 12px 34px rgba(30, 35, 70, .055),
    0 1px 2px rgba(30, 35, 70, .04);
}

.monitors-page table {
  width: 100%;
}

.monitors-page table thead th {
  height: 48px;
  padding: 0 15px;
  background: #fafbfe;
  border-bottom: 1px solid #e9ebf2;
  color: #858da0;
  font-size: .64rem;
  font-weight: 800;
  letter-spacing: .095em;
  text-transform: uppercase;
  white-space: nowrap;
}

.monitors-page table tbody td {
  height: 68px;
  padding: 10px 15px;
  border-bottom: 1px solid #f0f1f5;
  color: #343a49;
  font-size: .8rem;
}

.monitors-page table tbody tr {
  transition:
    background .16s ease,
    box-shadow .16s ease;
}

.monitors-page table tbody tr:hover {
  background: #fbfbff;
  box-shadow: inset 3px 0 0 rgba(93, 82, 221, .72);
}

.monitors-page table tbody tr:last-child td {
  border-bottom: 0;
}

.monitors-page table tbody td:first-child a,
.monitors-page .monitor-link {
  color: #202536;
  font-weight: 750;
  letter-spacing: -.012em;
}

.monitors-page table tbody td:first-child a:hover,
.monitors-page .monitor-link:hover {
  color: var(--accent);
}

.monitors-page table tbody td:nth-child(2) {
  color: #7c8495;
  font-family: var(--font-mono);
  font-size: .69rem;
  text-transform: uppercase;
}

.monitors-page .actions-cell {
  white-space: nowrap;
}

.monitors-page .actions-cell button {
  min-height: 32px;
  padding: 5px 10px;
  margin-left: 5px;
  border-radius: 8px;
  font-size: .7rem;
  font-weight: 700;
}

.monitors-page .actions-cell button:first-child {
  margin-left: 0;
}

.monitors-page .btn-toggle {
  min-width: 78px;
  border-radius: 999px;
  font-size: .68rem;
  font-weight: 750;
}

.monitors-page .btn-toggle-on {
  color: #147b59;
  background: #effaf5;
  border-color: #bde8d4;
}

.monitors-page .btn-toggle-off {
  color: #7b8290;
  background: #f6f7f9;
  border-color: #e1e4e9;
}

.monitors-page .pagination-controls {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  margin-top: 14px;
  padding: 4px 2px;
}

.monitors-page .pagination-controls button {
  min-height: 36px;
  border-radius: 9px;
}

.monitors-page .pagination-info {
  color: #858da0;
  font-size: .72rem;
}

/* ---------- Monitor form ---------- */

.monitor-form-page {
  max-width: 1080px;
  margin-inline: auto;
}

.monitor-form-page > .page-header {
  padding: 25px 28px;
  border-radius: 18px;
  border: 1px solid rgba(92, 82, 220, .10);
  background:
    radial-gradient(circle at 100% 0%, rgba(108, 96, 231, .08), transparent 35%),
    #fff;
  box-shadow: 0 12px 34px rgba(30,35,70,.055);
}

.monitor-form-page > .page-header h1 {
  margin: 2px 0 0;
  font-size: 1.9rem;
  letter-spacing: -.045em;
}

.monitor-form-page .eyebrow {
  color: #6559d9;
  letter-spacing: .12em;
}

/* Form becomes a series of premium cards */

.monitor-form {
  gap: 14px;
}

.monitor-form .form-section {
  position: relative;
  padding: 24px;
  border: 1px solid #e8eaf1;
  border-radius: 16px;
  background:
    linear-gradient(180deg, #ffffff 0%, #fcfcfe 100%);
  box-shadow:
    0 8px 24px rgba(30,35,70,.045),
    0 1px 2px rgba(30,35,70,.025);
}

.monitor-form .form-section::before {
  content: "";
  position: absolute;
  left: 0;
  top: 18px;
  bottom: 18px;
  width: 3px;
  border-radius: 999px;
  background: linear-gradient(180deg, #685de4, #9a93f0);
  opacity: .7;
}

.monitor-form .form-section h2 {
  margin: 0 0 18px 0;
  color: #242938;
  font-size: .94rem;
  font-weight: 800;
  letter-spacing: -.015em;
}

.monitor-form .form-section h2::after {
  content: "";
  display: block;
  width: 28px;
  height: 2px;
  margin-top: 8px;
  border-radius: 999px;
  background: #7167e3;
}

.monitor-form label {
  display: flex;
  flex-direction: column;
  gap: 7px;
  margin-bottom: 16px;
  color: #555d6e;
  font-size: .72rem;
  font-weight: 700;
}

.monitor-form label:last-child {
  margin-bottom: 0;
}

.monitor-form input:not([type="checkbox"]),
.monitor-form select {
  width: 100%;
  min-height: 43px;
  box-sizing: border-box;
  padding: 0 13px;
  border: 1px solid #dfe2e9;
  border-radius: 10px;
  background: #fff;
  color: #242938;
  font-size: .79rem;
  outline: none;
  transition:
    border-color .16s ease,
    box-shadow .16s ease,
    background .16s ease;
}

.monitor-form input:not([type="checkbox"]):hover,
.monitor-form select:hover {
  border-color: #c8cbd6;
}

.monitor-form input:not([type="checkbox"]):focus,
.monitor-form select:focus {
  border-color: #756be4;
  background: #fff;
  box-shadow: 0 0 0 3px rgba(117,107,228,.11);
}

.monitor-form input[type="number"] {
  font-family: var(--font-mono);
}

.monitor-form .form-help {
  margin-top: -8px;
  padding-left: 1px;
  color: #9097a7;
  font-size: .7rem;
}

.monitor-form .form-error-message {
  margin-top: -9px;
  margin-bottom: 14px;
  padding: 8px 10px;
  border-radius: 8px;
  color: #c44e55;
  background: #fff3f3;
  border: 1px solid #f3d2d4;
  font-size: .7rem;
  font-weight: 650;
}

/* Monitor type selector */

.monitor-form select[prop\\:value="kind"] {
  font-weight: 750;
}

/* Checkbox settings */

.monitor-form .check-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 10px;
  min-height: 44px;
  margin-bottom: 8px;
  padding: 11px 13px;
  border: 1px solid #e7e9ef;
  border-radius: 10px;
  background: #fafbfe;
  color: #444b5c;
  font-size: .75rem;
  cursor: pointer;
  transition: background .16s ease, border-color .16s ease;
}

.monitor-form .check-row:hover {
  background: #f7f6ff;
  border-color: #d9d5fa;
}

.monitor-form .check-row input[type="checkbox"] {
  width: 17px;
  height: 17px;
  margin: 0;
  accent-color: #665bdd;
}

.monitor-form .form-actions {
  position: sticky;
  bottom: 12px;
  z-index: 5;
  margin-top: 2px;
  padding: 12px;
  border: 1px solid #e3e5ec;
  border-radius: 14px;
  background: rgba(255,255,255,.91);
  backdrop-filter: blur(14px);
  box-shadow: 0 12px 30px rgba(25,30,60,.10);
}

.monitor-form .form-actions .btn {
  min-height: 42px;
  padding-inline: 18px;
  border-radius: 10px;
  font-weight: 750;
}

.monitor-form .form-actions .btn-primary {
  min-width: 145px;
}

/* ---------- Monitor detail ---------- */

.monitor-detail {
  max-width: 1240px;
  margin-inline: auto;
  gap: 16px;
}

.monitor-detail > .page-header {
  position: relative;
  overflow: hidden;
  min-height: 82px;
  padding: 20px 24px;
  border-radius: 18px;
  border: 1px solid rgba(91,82,220,.11);
  background:
    radial-gradient(circle at 95% 5%, rgba(102,91,228,.10), transparent 30%),
    #fff;
  box-shadow: 0 12px 32px rgba(30,35,70,.055);
}

.monitor-detail > .page-header h1 {
