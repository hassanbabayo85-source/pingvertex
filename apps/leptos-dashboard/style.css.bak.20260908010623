.trend-chart-wrap { border: 0; background: linear-gradient(180deg, rgba(79,70,229,.035), transparent); }
.trend-chart { height: 132px; }
.trend-area { opacity: 1; }
.trend-line { stroke: currentColor; stroke-width: 3; stroke-linecap: round; stroke-linejoin: round; }
.trend-point { fill: currentColor; stroke: var(--surface); stroke-width: 2; opacity: .9; }
.trend-point:focus { outline: none; }
.trend-axis { display: flex; justify-content: space-between; gap: 4px; padding: 7px 2px 0; color: var(--ink-faint); font-size: .61rem; font-variant-numeric: tabular-nums; }

.monitor-toolbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 14px;
  margin-bottom: 10px;
}
.monitor-tabs { display: flex; align-items: center; gap: 4px; flex-wrap: wrap; }
.monitor-tab {
  border: 0;
  border-radius: 8px;
  background: transparent;
  color: var(--ink-muted);
  padding: 7px 10px;
  font-size: .75rem;
  font-weight: 650;
  cursor: pointer;
}
.monitor-tab:hover { background: var(--surface-muted); color: var(--ink); }
.monitor-tab.active { background: var(--accent-soft); color: var(--accent); }
.monitor-search { width: min(250px, 100%); margin: 0; padding: 9px 11px; border-radius: 9px; }
.dashboard-monitor-table { min-width: 760px; }
.dashboard-monitor-table th, .dashboard-monitor-table td { padding: 12px 14px; }
.monitor-row { transition: background-color .14s ease; }
.monitor-row:hover td { background: var(--surface-sunken) !important; }
.monitor-cell { display: flex; align-items: center; gap: 10px; min-width: 210px; }
.monitor-type-icon {
  width: 34px;
  height: 34px;
  flex: 0 0 34px;
  display: grid;
  place-items: center;
  border-radius: 50%;
  background: var(--surface-muted);
  color: var(--accent);
  position: relative;
}
.monitor-type-icon::before { font-size: .85rem; font-weight: 800; }
.monitor-type-http::before { content: "◉"; }
.monitor-type-https::before { content: "◇"; }
.monitor-type-tcp::before { content: "▣"; }
.monitor-type-dns::before { content: "☁"; }
.monitor-type-heartbeat::before { content: "♥"; }
.monitor-type-flow::before { content: "⇄"; }
.monitor-link { display: flex; flex-direction: column; gap: 1px; color: var(--ink); text-decoration: none; }
.monitor-link strong { font-size: .82rem; }
.monitor-link small { color: var(--ink-faint); font-size: .66rem; font-weight: 650; text-transform: uppercase; letter-spacing: .06em; }
.monitor-link:hover { color: var(--accent); text-decoration: none; }
.relative-time { color: var(--ink-muted); font-variant-numeric: tabular-nums; white-space: nowrap; }
.monitor-row-end { width: 74px; white-space: nowrap; text-align: right; }
.row-menu { display: inline-block; position: relative; margin-right: 5px; }
.row-menu summary { list-style: none; cursor: pointer; color: var(--ink-faint); padding: 5px 6px; border-radius: 7px; font-weight: 800; letter-spacing: 1px; }
.row-menu summary::-webkit-details-marker { display: none; }
.row-menu summary:hover { background: var(--surface-muted); color: var(--ink); }
.row-menu-popover { position: absolute; z-index: 20; right: 0; top: calc(100% + 4px); display: flex; flex-direction: column; min-width: 130px; padding: 5px; border: 1px solid var(--border); border-radius: 9px; background: var(--surface); box-shadow: var(--shadow-md); }
.row-menu-popover a { padding: 7px 8px; border-radius: 6px; color: var(--ink); font-size: .72rem; }
.row-menu-popover a:hover { background: var(--surface-muted); text-decoration: none; }
.row-chevron { color: var(--ink-faint); font-size: 1.35rem; line-height: 1; text-decoration: none; vertical-align: middle; }
.row-chevron:hover { color: var(--accent); text-decoration: none; }

.dashboard-incident-list { border-radius: 14px; }
.incident-row-link { display: grid; grid-template-columns: 36px minmax(0, 1fr) auto 110px 20px; align-items: center; gap: 12px; min-height: 68px; padding: 12px 15px; color: var(--ink); text-decoration: none; border-bottom: 1px solid var(--border-subtle); }
.incident-row-link:last-child { border-bottom: 0; }
.incident-row-link:hover { background: var(--surface-sunken); text-decoration: none; }
.incident-status-icon { width: 32px; height: 32px; display: grid; place-items: center; border-radius: 50%; font-size: .75rem; font-weight: 850; }
.incident-status-investigating { color: var(--down); background: var(--down-soft); }
.incident-status-resolved { color: var(--up); background: var(--up-soft); }
.incident-main { display: flex; min-width: 0; flex-direction: column; gap: 1px; }
.incident-main strong { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-size: .82rem; }
.incident-main small { color: var(--ink-muted); font-size: .69rem; }

.nav-badge {
  min-width: 18px;
  height: 18px;
  padding: 0 5px;
  margin-left: auto;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  border-radius: 999px;
  background: #dc2626;
  color: #fff;
  font-size: .58rem;
  font-weight: 800;
  line-height: 1;
  font-variant-numeric: tabular-nums;
}
.topbar-icon-link { position: relative; text-decoration: none; }
.topbar-icon-link:hover { text-decoration: none; }
.topbar-notification-badge { position: absolute; top: -2px; right: -2px; min-width: 16px; height: 16px; padding: 0 4px; display: grid; place-items: center; border: 2px solid var(--surface); border-radius: 999px; background: #dc2626; color: #fff; font-size: .53rem; font-weight: 800; line-height: 1; }

.sidebar-group a.active::after { display: none; }
.sidebar-group a.active { background: var(--accent); box-shadow: 0 6px 18px rgba(79,70,229,.22); }

@media (max-width: 1050px) {
  .metric-strip { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  .dashboard-trend-grid { grid-template-columns: 1fr 1fr; }
}
@media (max-width: 760px) {
  .dashboard-actions { width: 100%; justify-content: flex-start; }
  .monitor-toolbar { align-items: stretch; flex-direction: column; }
  .monitor-search { width: 100%; }
  .dashboard-trend-grid { grid-template-columns: 1fr; }
  .incident-row-link { grid-template-columns: 34px minmax(0, 1fr) auto 20px; }
  .incident-row-link .stat-sparkline { display: none; }
}
@media (max-width: 560px) {
  .metric-strip { grid-template-columns: 1fr 1fr; }
  .dashboard-page-header { padding: 19px; }
  .dashboard-actions .btn { flex: 1 1 auto; }
}
@media (max-width: 390px) {
  .metric-strip { grid-template-columns: 1fr; }
}

html[data-theme="dark"] .dashboard-action-notice,
html[data-theme="dark"] .row-menu-popover { background: var(--pv-surface); border-color: var(--pv-border); }
html[data-theme="dark"] .metric-icon-monitors { background: var(--pv-primary-soft); }
html[data-theme="dark"] .topbar-notification-badge { border-color: var(--pv-surface); }

/* =========================================================
   Dashboard polish pass — appended, does not remove/override
   any existing rule other than the two explicitly noted below.
   ========================================================= */

/* Subtle reference gridlines behind the 24h trend charts so an
   empty/sparse chart (new accounts, freshly-added monitors) reads
   as "a chart with little data yet" instead of "broken/blank". */
.trend-grid {
  stroke: var(--border-subtle, var(--border));
  stroke-width: 1;
  stroke-dasharray: 2 4;
  vector-effect: non-scaling-stroke;
}

/* Overrides the earlier `.trend-point:focus { outline: none; }` rule.
   Same selector + same specificity, so the rule that appears later in
   the stylesheet wins — nothing above needs to be touched or deleted.
   These points have tabindex="0" (they're the keyboard-reachable data
   markers), so removing the outline entirely left keyboard users with
   no visible focus indicator. */
.trend-point:focus {
  outline: 2px solid var(--accent);
  outline-offset: 2px;
}

/* A little more life on hover for primary surfaces, matching the
   shadow tokens the design already defines. */
.card,
.dashboard-widget {
  transition: transform var(--transition-standard, 180ms ease),
              box-shadow var(--transition-standard, 180ms ease);
}
.card:hover,
.dashboard-widget:hover {
  transform: translateY(-1px);
}

@media (prefers-reduced-motion: reduce) {
  .card,
  .dashboard-widget {
    transition: none;
  }
  .card:hover,
  .dashboard-widget:hover {
    transform: none;
  }
}

