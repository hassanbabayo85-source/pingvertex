        ),
        linear-gradient(
            180deg,
            #f8f9ff 0%,
            #f3f5fb 100%
        );
}

.auth-shell::before {
    content: "";
    position: absolute;
    width: 520px;
    height: 520px;
    border-radius: 50%;
    background: rgba(99, 102, 241, 0.06);
    filter: blur(80px);
