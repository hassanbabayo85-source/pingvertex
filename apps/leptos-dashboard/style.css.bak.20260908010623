/* ---------- Dashboard UX hardening: theme, navigation, focus ---------- */
html[data-theme="dark"] {
  color-scheme: dark;
  --pv-bg: #0b1020;
  --pv-surface: #121827;
  --pv-surface-soft: #0f1626;
  --pv-border: #273149;
  --pv-border-strong: #39445f;
  --pv-text: #eef2ff;
  --pv-muted: #aab4c8;
  --pv-faint: #7f8aa2;
  --pv-primary: #818cf8;
  --pv-primary-2: #6366f1;
  --pv-primary-soft: #1b2140;
  --pv-success: #34d399;
  --pv-success-soft: #103328;
  --pv-danger: #fb7185;
  --pv-danger-soft: #3b1821;
  --pv-warning: #fbbf24;
  --pv-warning-soft: #3a2c0c;
  --bg: var(--pv-bg);
  --surface: var(--pv-surface);
  --surface-raised: #151d2e;
  --surface-sunken: #0f1626;
  --surface-muted: #172033;
  --border: var(--pv-border);
  --border-strong: var(--pv-border-strong);
  --border-subtle: #202a40;
  --ink: var(--pv-text);
  --ink-muted: var(--pv-muted);
  --ink-faint: var(--pv-faint);
  --accent: var(--pv-primary);
  --accent-hover: #a5b4fc;
  --accent-soft: var(--pv-primary-soft);
  --up: var(--pv-success);
  --up-soft: var(--pv-success-soft);
  --down: var(--pv-danger);
  --down-soft: var(--pv-danger-soft);
  --degraded: var(--pv-warning);
  --degraded-soft: var(--pv-warning-soft);
}

html[data-theme="dark"],
html[data-theme="dark"] body { background: var(--pv-bg); color: var(--pv-text); }
html[data-theme="dark"] .page-header,
html[data-theme="dark"] .dashboard-page-header,
html[data-theme="dark"] .card,
html[data-theme="dark"] .dashboard-widget,
html[data-theme="dark"] .table-shell,
html[data-theme="dark"] .monitor-table-wrap { background: var(--pv-surface); border-color: var(--pv-border); color: var(--pv-text); }
html[data-theme="dark"] .page-header,
html[data-theme="dark"] .dashboard-page-header { background: linear-gradient(135deg, #151d2e, #111827); }
html[data-theme="dark"] input,
html[data-theme="dark"] select,
html[data-theme="dark"] textarea,
html[data-theme="dark"] .topbar-search { background: #0f1626; color: var(--pv-text); border-color: var(--pv-border); }
html[data-theme="dark"] .topbar { background: rgba(11,16,32,.88); border-color: var(--pv-border); }
html[data-theme="dark"] .topbar-icon { color: var(--pv-muted); }
html[data-theme="dark"] .topbar-icon:hover { background: #172033; border-color: var(--pv-border); color: var(--pv-text); }
html[data-theme="dark"] table th { color: var(--pv-muted); border-color: var(--pv-border); }
html[data-theme="dark"] table td { border-color: var(--pv-border); }
html[data-theme="dark"] .trend-empty { background: #0f1626; border-color: var(--pv-border); color: var(--pv-muted); }
html[data-theme="dark"] .muted,
html[data-theme="dark"] .page-subtitle,
html[data-theme="dark"] .widget-description { color: var(--pv-muted); }
html[data-theme="dark"] .btn { background: #172033; border-color: var(--pv-border-strong); color: var(--pv-text); }
html[data-theme="dark"] .btn:hover { background: #202a40; }
html[data-theme="dark"] .btn-primary { background: var(--pv-primary-2); border-color: var(--pv-primary-2); color: #fff; }
html[data-theme="dark"] .theme-toggle { color: #fbbf24; }

.sidebar-group a.active {
  position: relative;
  font-weight: 700;
}
.sidebar-group a.active::after {
  content: "";
  position: absolute;
  left: 0;
  top: 7px;
