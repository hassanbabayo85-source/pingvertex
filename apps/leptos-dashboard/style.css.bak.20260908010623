  content: "";
  position: absolute;
  width: 520px;
  height: 520px;
  border-radius: 50%;
  background: rgba(99, 102, 241, 0.06);
  filter: blur(80px);
  top: -280px;
  left: 50%;
  transform: translateX(-50%);
  pointer-events: none;
}

