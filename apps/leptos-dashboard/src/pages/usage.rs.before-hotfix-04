use crate::api::wallet;
use leptos::prelude::*;
use leptos::task::spawn_local;

fn usd(u: i64) -> String {
    let sign = if u < 0 { "-" } else { "" };
    let a = u.unsigned_abs();
    format!("{sign}${}.{:02}", a / 1_000_000, (a % 1_000_000) / 10_000)
}

fn date_start(v: &str) -> String {
    if v.is_empty() {
        String::new()
    } else {
        format!("{v}T00:00:00Z")
    }
}

fn date_end(v: &str) -> String {
    if v.is_empty() {
        String::new()
    } else {
        format!("{v}T23:59:59Z")
    }
}

#[component]
pub fn UsagePage() -> impl IntoView {
    let report = RwSignal::new(None::<wallet::UsageReport>);
    let error = RwSignal::new(None::<String>);

    let from = RwSignal::new(String::new());
    let to = RwSignal::new(String::new());
    let operation = RwSignal::new(String::new());
    let status = RwSignal::new(String::new());

    let reload = RwSignal::new(0_u32);

    let load = move || {
        let f = date_start(&from.get());
        let t = date_end(&to.get());
        let op = operation.get();
        let st = status.get();

        spawn_local(async move {
            match wallet::usage(
                (!f.is_empty()).then_some(f.as_str()),
                (!t.is_empty()).then_some(t.as_str()),
                (!op.is_empty()).then_some(op.as_str()),
                (!st.is_empty()).then_some(st.as_str()),
            )
            .await
            {
                Ok(v) => {
                    error.set(None);
                    report.set(Some(v));
                }
                Err(e) => {
                    error.set(Some(e.to_string()));
                }
            }
        });
    };

    Effect::new(move |_| {
        let _ = reload.get();
        load();
    });

    let apply_filters = move |_| {
        reload.update(|v| *v += 1);
    };

    let clear_filters = move |_| {
        from.set(String::new());
        to.set(String::new());
        operation.set(String::new());
        status.set(String::new());
        reload.update(|v| *v += 1);
    };

    view! {
        <div class="feature-page">
            <header class="page-header">
                <div>
                    <span class="eyebrow">"PAYG"</span>
                    <h1>"Usage"</h1>
                    <p class="muted">
                        "Metered usage, spend and projected monthly cost."
                    </p>
                </div>
            </header>

            {
                move || {
                    error.get().map(|e| {
                        view! {
                            <div class="error" role="alert">
                                {e}
                            </div>
                        }
                    })
                }
            }

            <section class="card">
                <div class="section-heading">
                    <div>
                        <h2>"Filters"</h2>
                        <p class="muted">
                            "Narrow the report without changing the underlying ledger."
                        </p>
                    </div>
                </div>

                <div class="inline-form">
                    <label>
                        "From "
                        <input
                            type="date"
                            prop:value=move || from.get()
                            on:input=move |e| {
                                from.set(event_target_value(&e));
                            }
                        />
                    </label>

                    <label>
                        "To "
                        <input
                            type="date"
                            prop:value=move || to.get()
                            on:input=move |e| {
                                to.set(event_target_value(&e));
                            }
                        />
                    </label>

                    <label>
                        "Operation "
                        <input
                            type="text"
                            placeholder="Operation"
                            prop:value=move || operation.get()
                            on:input=move |e| {
                                operation.set(event_target_value(&e));
                            }
                        />
                    </label>

                    <label>
                        "Status "
                        <select
                            prop:value=move || status.get()
                            on:change=move |e| {
                                status.set(event_target_value(&e));
                            }
                        >
                            <option value="">"All"</option>
                            <option value="SUCCEEDED">"Succeeded"</option>
                            <option value="FAILED">"Failed"</option>
                        </select>
                    </label>

                    <button
                        type="button"
                        class="btn btn-primary"
                        on:click=apply_filters
                    >
                        "Apply"
                    </button>

                    <button
                        type="button"
                        class="btn"
                        on:click=clear_filters
                    >
                        "Clear"
                    </button>
                </div>
            </section>

            {
                move || {
                    report.get().map(|r| {
                        let max_daily = r
                            .daily_spend
                            .iter()
                            .map(|x| x.amount_units.abs())
                            .max()
                            .unwrap_or(1);

                        let max_operation = r
                            .usage_by_operation
                            .iter()
                            .map(|x| x.amount_units.abs())
                            .max()
                            .unwrap_or(1);

                        view! {
                            <section class="stats-grid">
                                <div class="card">
                                    <div class="muted">"Current Balance"</div>
                                    <strong>{usd(r.current_balance_units)}</strong>
                                </div>

                                <div class="card">
                                    <div class="muted">"Today's Usage"</div>
                                    <strong>{usd(r.today_usage_units)}</strong>
                                </div>

                                <div class="card">
                                    <div class="muted">"This Month"</div>
                                    <strong>{usd(r.month_usage_units)}</strong>
                                </div>

                                <div class="card">
                                    <div class="muted">"Projected Spend"</div>
                                    <strong>{usd(r.projected_month_units)}</strong>
                                </div>
                            </section>

                            <section class="card">
                                <div class="section-heading">
                                    <div>
                                        <h2>"Daily Spend"</h2>
                                        <p class="muted">
                                            "Spend by day for the selected period."
                                        </p>
                                    </div>
                                </div>

                                <div class="usage-chart">
                                    {
                                        r.daily_spend.iter().map(|item| {
                                            let width = if max_daily == 0 {
                                                0
                                            } else {
                                                (item.amount_units.abs() * 100) / max_daily
                                            };

                                            view! {
                                                <div class="usage-chart-row">
                                                    <span class="usage-chart-label">
                                                        {item.day.clone()}
                                                    </span>

                                                    <div class="usage-chart-track">
                                                        <div
                                                            class="usage-chart-bar"
                                                            style:format!("width: {width}%")
                                                        ></div>
                                                    </div>

                                                    <span class="usage-chart-value">
                                                        {usd(item.amount_units)}
                                                    </span>
                                                </div>
                                            }
                                        }).collect_view()
                                    }
                                </div>
                            </section>

                            <section class="card">
                                <div class="section-heading">
                                    <div>
                                        <h2>"Usage by Operation"</h2>
                                        <p class="muted">
                                            "Which operations consume the most balance."
                                        </p>
                                    </div>
                                </div>

                                <div class="usage-chart">
                                    {
                                        r.usage_by_operation.iter().map(|item| {
                                            let width = if max_operation == 0 {
                                                0
                                            } else {
                                                (item.amount_units.abs() * 100) / max_operation
                                            };

                                            view! {
                                                <div class="usage-chart-row">
                                                    <span class="usage-chart-label">
                                                        {item.operation.clone()}
                                                    </span>

                                                    <div class="usage-chart-track">
                                                        <div
                                                            class="usage-chart-bar"
                                                            style:format!("width: {width}%")
                                                        ></div>
                                                    </div>

                                                    <span class="usage-chart-value">
                                                        {usd(item.amount_units)}
                                                    </span>
                                                </div>
                                            }
                                        }).collect_view()
                                    }
                                </div>
                            </section>

                            <section class="card">
                                <div class="section-heading">
                                    <div>
                                        <h2>"Usage Details"</h2>
                                        <p class="muted">
                                            "Detailed metered usage ledger."
                                        </p>
                                    </div>
                                </div>

                                <div class="table-wrap">
                                    <table>
                                        <thead>
                                            <tr>
                                                <th>"Timestamp"</th>
                                                <th>"Operation"</th>
                                                <th>"Units"</th>
                                                <th>"Price"</th>
                                                <th>"Charge"</th>
                                                <th>"Request ID"</th>
                                                <th>"Status"</th>
                                            </tr>
                                        </thead>

                                        <tbody>
                                            {
                                                r.entries.iter().map(|item| {
                                                    view! {
                                                        <tr>
                                                            <td>{item.created_at.clone()}</td>
                                                            <td>{item.operation.clone()}</td>
                                                            <td>{item.units}</td>
                                                            <td>{usd(item.unit_price_units)}</td>
                                                            <td>{usd(item.amount_units)}</td>
                                                            <td>{item.request_id.clone()}</td>
                                                            <td>{item.status.clone()}</td>
                                                        </tr>
                                                    }
                                                }).collect_view()
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            </section>
                        }
                    })
                }
            }
        </div>
    }
}
