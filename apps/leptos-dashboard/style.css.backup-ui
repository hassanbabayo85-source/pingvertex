/* ---------- Design tokens (:root) ---------- */

:root {
  --font-sans: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
  --font-mono: "SFMono-Regular", Consolas, "Liberation Mono", Menlo, monospace;

  --bg: #f6f7f9;
  --surface: #ffffff;
  --surface-sunken: #f0f2f5;
  --border: #e1e4ea;
  --border-strong: #c7ccd6;
  --ink: #12151c;
  --ink-muted: #5b6472;
  --ink-faint: #8991a0;

  --accent: #4338ca;
  --accent-hover: #372fb0;
  --accent-soft: #eef0fe;

  --up: #12855a;
  --up-soft: #e5f6ef;
  --down: #c2311f;
  --down-soft: #fbeae8;
  --degraded: #9a6300;
  --degraded-soft: #fbf1dd;
  --neutral: #6b7280;
  --neutral-soft: #eef0f3;

  --radius-sm: 4px;
  --radius-md: 6px;
  --shadow-card: 0 1px 2px rgba(18, 21, 28, 0.05);

  --space-1: 4px;
  --space-2: 8px;
  --space-3: 12px;
  --space-4: 16px;
  --space-5: 24px;
  --space-6: 32px;
  --space-7: 48px;
}

:root {
  --surface-raised: #ffffff;
  --surface-muted: #f7f8fa;
  --surface-overlay: rgba(18, 21, 28, 0.55);
  --border-subtle: #eceef2;
  --ink-inverse: #ffffff;

  --status-up: #12855a;
  --status-up-soft: #e5f6ef;
  --status-down: #c2311f;
  --status-down-soft: #fbeae8;
  --status-warning: #9a6300;
  --status-warning-soft: #fbf1dd;
  --status-unknown: #6b7280;
  --status-unknown-soft: #eef0f3;
  --status-disabled: #8991a0;
  --status-disabled-soft: #f0f2f5;

  --radius-lg: 10px;
  --radius-full: 999px;
  --shadow-sm: 0 1px 2px rgba(18, 21, 28, 0.05);
  --shadow-md: 0 8px 24px rgba(18, 21, 28, 0.10);
  --shadow-lg: 0 16px 40px rgba(18, 21, 28, 0.16);
  --transition-fast: 120ms ease;
  --transition-standard: 180ms ease;
  --breakpoint-sm: 640px;
  --breakpoint-md: 720px;
  --breakpoint-lg: 1024px;
}

:root {
  --bg: #f4f6fa;
  --surface: #ffffff;
  --surface-raised: #ffffff;
  --surface-sunken: #f8f9fc;
  --surface-muted: #f1f3f7;
  --border: #e4e7ee;
  --border-strong: #cfd4df;
  --border-subtle: #edf0f4;
  --ink: #111827;
  --ink-muted: #596579;
  --ink-faint: #8a94a6;

  --accent: #4f46e5;
  --accent-hover: #4338ca;
  --accent-soft: #eef0ff;

  --up: #138a5b;
  --up-soft: #e8f7f0;
  --down: #c83b2a;
  --down-soft: #fdf0ee;
  --degraded: #a56a00;
  --degraded-soft: #fff6df;
  --neutral: #667085;
  --neutral-soft: #f0f2f5;

  --radius-sm: 8px;
  --radius-md: 12px;
  --radius-lg: 16px;
  --radius-full: 999px;

  --shadow-card: 0 1px 2px rgba(15, 23, 42, 0.04), 0 8px 24px rgba(15, 23, 42, 0.035);
  --shadow-sm: 0 1px 2px rgba(15, 23, 42, 0.05);
  --shadow-md: 0 10px 30px rgba(15, 23, 42, 0.10);
  --shadow-lg: 0 18px 50px rgba(15, 23, 42, 0.16);
  --muted: var(--ink-muted);
}


/* ---------- Reset & base ---------- */

* { margin: 0; padding: 0; box-sizing: border-box; }

html { -webkit-text-size-adjust: 100%; }

body {
  font-family: var(--font-sans);
  background-color: var(--bg);
  color: var(--ink);
  font-size: 15px;
  line-height: 1.5;
  -webkit-font-smoothing: antialiased;
}

a { color: var(--accent); text-decoration: none; }

a:hover { text-decoration: underline; }

html { color-scheme: light; }

html {
  color-scheme: light;
  background: var(--bg);
  scroll-behavior: smooth;
}

body {
  background:
    radial-gradient(circle at 100% 0, rgba(79, 70, 229, 0.045), transparent 26rem),
    var(--bg);
  color: var(--ink);
}

body,
button,
input,
select,
textarea {
  font-family: var(--font-sans);
}

a {
  color: var(--accent);
}

a:hover {
  color: var(--accent-hover);
}

textarea {
  min-height: 110px;
}


/* ---------- App shell & layout ---------- */

.page-header h1 { margin: 0; }

.page-header-actions {
  display: flex;
  align-items: center;
  gap: var(--space-3);
  flex-wrap: wrap;
}

.billing-page .page-subtitle { margin: var(--space-2) 0 0; color: var(--muted); max-width: 62ch; }

.app-shell {
  display: flex;
  flex-direction: row;
  min-height: 100vh;
}

.app-content {
  flex: 1;
  display: flex;
  flex-direction: column;
  min-height: 100vh;
  min-width: 0;
  background: transparent;
}

.app-main {
  flex: 1;
  padding: 32px clamp(18px, 3vw, 40px) 44px;
  max-width: 1400px;
  width: min(100%, 1400px);
  margin: 0 auto;
}

.app-footer {
  background-color: var(--surface);
  border-top: 1px solid var(--border);
  color: var(--ink-faint);
  text-align: center;
  padding: 18px 24px;
  font-size: 0.75rem;
  background: rgba(255, 255, 255, 0.72);
}

.page-header,
.dashboard-page-header {
  position: relative;
  margin-bottom: 24px;
  padding: 20px 22px;
  border: 1px solid var(--border);
  border-radius: var(--radius-lg);
  background:
    linear-gradient(135deg, rgba(255,255,255,.98), rgba(248,249,253,.96));
  box-shadow: var(--shadow-card);
}

.page-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--space-4);
  margin-bottom: var(--space-5);
  flex-wrap: wrap;
}

.page-header h1,
.dashboard-page-header h1 {
  margin: 0;
  color: var(--ink);
  font-size: clamp(1.55rem, 2vw, 2rem);
  letter-spacing: -.035em;
}

.page-header .eyebrow,
.dashboard-page-header .eyebrow {
  margin-bottom: 5px;
}

.page-subtitle {
  margin-top: 6px;
  font-size: .8rem;
  color: var(--ink-muted);
  font-family: var(--font-sans);
  max-width: 70ch;
}


/* ---------- Sidebar ---------- */

.sidebar-brand a {
  color: #fff;
  font-weight: 700;
  letter-spacing: -0.01em;
  font-size: 1.0625rem;
  text-decoration: none;
}

.sidebar-group a {
  color: rgba(255, 255, 255, 0.72);
  font-size: 0.875rem;
  font-weight: 500;
  text-decoration: none;
  padding: var(--space-2) var(--space-3);
  border-radius: var(--radius-sm);
  transition: background-color 0.12s ease, color 0.12s ease;
}

.sidebar-group a:hover {
  color: #fff;
  background-color: rgba(255, 255, 255, 0.06);
  text-decoration: none;
}

.sidebar-group a.active {
  color: #fff;
  background-color: var(--accent);
}

.sidebar-group-disabled {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--space-2);
  color: rgba(255, 255, 255, 0.32);
  font-size: 0.875rem;
  font-weight: 500;
  padding: var(--space-2) var(--space-3);
  border-radius: var(--radius-sm);
  cursor: default;
  user-select: none;
}

.sidebar-soon-badge {
  font-size: 0.625rem;
  font-weight: 600;
  letter-spacing: 0.03em;
  text-transform: uppercase;
  color: rgba(255, 255, 255, 0.4);
  border: 1px solid rgba(255, 255, 255, 0.16);
  border-radius: var(--radius-sm);
  padding: 1px 5px;
}

.sidebar-signout:hover {
  color: #fff;
  background-color: rgba(255, 255, 255, 0.06);
  text-decoration: none;
}

.sidebar {
  width: 264px;
  min-width: 264px;
  background-color: var(--ink);
  color: #fff;
  display: flex;
  flex-direction: column;
  gap: 18px;
  padding: 18px 12px 14px;
  position: sticky;
  top: 0;
  height: 100dvh;
  overflow-y: auto;
  overflow-x: hidden;
  background: radial-gradient(circle at 10% 0, rgba(99, 102, 241, 0.22), transparent 18rem),
    linear-gradient(180deg, #111827 0%, #0b1220 100%);
  border-right: 1px solid rgba(255, 255, 255, 0.08);
  box-shadow: 10px 0 30px rgba(15, 23, 42, 0.08);
  scrollbar-width: thin;
  scrollbar-color: rgba(255,255,255,.18) transparent;
}

.sidebar-brand {
  padding: 6px 10px 16px;
  border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  padding-bottom: var(--space-4);
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--space-2);
  min-height: 52px;
  border-bottom-color: rgba(255,255,255,.10);
}

.sidebar-brand a {
  display: inline-flex;
  align-items: center;
  gap: 10px;
  color: #fff;
  font-size: 1.02rem;
  letter-spacing: -0.025em;
}

.sidebar-brand a::before {
  content: "";
  width: 30px;
  height: 30px;
  flex: 0 0 30px;
  border-radius: 10px;
  background:
    radial-gradient(circle at 50% 50%, #fff 0 4px, transparent 5px),
    linear-gradient(135deg, #818cf8, #4f46e5);
  box-shadow: 0 0 0 1px rgba(255,255,255,.14), 0 7px 18px rgba(79,70,229,.35);
}

.sidebar-brand a::after {
  content: "MONITORING";
  align-self: flex-end;
  margin: 0 0 2px -2px;
  color: rgba(255,255,255,.42);
  font-size: .55rem;
  font-weight: 700;
  letter-spacing: .11em;
}

.sidebar-nav {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 20px;
  padding: 0 2px;
}

.sidebar-group {
  display: flex;
  flex-direction: column;
  gap: 3px;
}

.sidebar-group-label {
  font-size: .62rem;
  font-weight: 600;
  letter-spacing: .13em;
  text-transform: uppercase;
  color: rgba(255,255,255,.38);
  padding: 0 10px;
  margin-bottom: var(--space-1);
  margin: 0 0 5px;
}

.sidebar-group a {
  position: relative;
  display: flex;
  align-items: center;
  gap: 10px;
  min-height: 40px;
  padding: 8px 10px;
  border: 1px solid transparent;
  border-radius: 9px;
  color: rgba(255,255,255,.67);
  font-size: .82rem;
  font-weight: 550;
}

.sidebar-group a::before {
  content: "•";
  width: 18px;
  flex: 0 0 18px;
  color: rgba(255,255,255,.35);
  font-size: .9rem;
  line-height: 1;
  text-align: center;
}

.sidebar-group a[href="/"]::before { content: "⌂"; }

.sidebar-group a[href="/proxy-check"]::before { content: "⌁"; }

.sidebar-group a[href="/monitors"]::before { content: "◉"; }

.sidebar-group a[href="/maintenance"]::before { content: "◷"; }

.sidebar-group a[href="/escalation-policies"]::before { content: "↗"; }

.sidebar-group a[href="/rum"]::before { content: "◌"; }

.sidebar-group a[href="/rum/sites"]::before { content: "◎"; }

.sidebar-group a[href="/status-pages"]::before { content: "◍"; }

.sidebar-group a[href="/team"]::before { content: "♙"; }

.sidebar-group a[href="/team/invitations"]::before { content: "✉"; }

.sidebar-group a[href="/developer/api-keys"]::before { content: "⌘"; }

.sidebar-group a[href="/developer/api-flows"]::before { content: "⇄"; }

.sidebar-group a[href="/billing/plan"]::before { content: "◇"; }

.sidebar-group a[href="/billing/wallet"]::before { content: "▣"; }

.sidebar-group a[href="/billing/usage"]::before { content: "▥"; }

.sidebar-group a[href="/billing/invoices"]::before { content: "▤"; }

.sidebar-group a[href="/billing/transactions"]::before { content: "↔"; }

.sidebar-group a[href="/help"]::before { content: "?"; }

.sidebar-group a[href="/support"]::before { content: "◫"; }

.sidebar-group a[href="/settings/account"]::before { content: "○"; }

.sidebar-group a[href="/settings/security"]::before { content: "◆"; }

.sidebar-group a[href="/settings/notifications"]::before { content: "◈"; }

.sidebar-group a:hover {
  color: #fff;
  background: rgba(255,255,255,.055);
  border-color: rgba(255,255,255,.06);
}

.sidebar-group a.active {
  color: #fff;
  background: linear-gradient(90deg, rgba(79,70,229,.95), rgba(79,70,229,.72));
  border-color: rgba(129,140,248,.28);
  box-shadow: 0 6px 18px rgba(79,70,229,.18);
}

.sidebar-group a.active::before {
  color: #fff;
}

.sidebar-footer {
  border-top: 1px solid rgba(255, 255, 255, 0.08);
  padding-top: var(--space-4);
  display: flex;
  flex-direction: column;
  gap: 8px;
  padding: 12px 4px 0;
  border-top-color: rgba(255,255,255,.09);
}

.sidebar-user {
  padding: 10px;
  border: 1px solid rgba(255,255,255,.08);
  border-radius: 10px;
  background: rgba(255,255,255,.035);
}

.sidebar-user-email {
  font-family: var(--font-sans);
  font-size: .7rem;
  color: rgba(255,255,255,.58);
  padding: 0;
  word-break: break-all;
  display: block;
  line-height: 1.45;
}

.sidebar-signout {
  color: rgba(255,255,255,.62);
  font-family: var(--font-sans);
  font-size: 0.8125rem;
  font-weight: 500;
  text-decoration: none;
  padding: 8px 10px;
  border-radius: var(--radius-sm);
  transition: background-color 0.12s ease, color 0.12s ease;
  min-height: 38px;
}

.sidebar-signout:hover {
  color: #fff;
  background: rgba(255,255,255,.055);
}


/* ---------- Buttons & form controls ---------- */

button, :is(.btn) {
  font-family: var(--font-sans);
  font-size: 0.875rem;
  font-weight: 500;
  background-color: var(--surface);
  color: var(--ink);
  border: 1px solid var(--border-strong);
  border-radius: var(--radius-sm);
  padding: 0.5rem 0.875rem;
  cursor: pointer;
  transition: background-color 0.12s ease, border-color 0.12s ease;
}

button:hover, .btn:hover { background-color: var(--surface-sunken); }

button:disabled { opacity: 0.5; cursor: not-allowed; }

.btn-primary:hover { background-color: var(--accent-hover); border-color: var(--accent-hover); }

.btn-danger:hover { background-color: var(--down); color: #fff; }

.btn-block { width: 100%; padding: 0.625rem 1rem; }

button, :is(.btn), input, select, textarea { min-height: 38px; }

button, :is(.btn) {
  transition: background-color var(--transition-fast), border-color var(--transition-fast),
              color var(--transition-fast), box-shadow var(--transition-fast),
              transform var(--transition-fast);
}

button:focus-visible, .btn:focus-visible,
input:focus-visible, select:focus-visible, textarea:focus-visible {
  outline: 2px solid var(--accent);
  outline-offset: 2px;
}

button:active:not(:disabled), .btn:active:not(:disabled) { transform: translateY(1px); }

.form-field {
  display: flex;
  flex-direction: column;
  gap: var(--space-1);
  width: 100%;
}

:is(.form-field-label) {
  margin: 0;
  color: var(--ink);
  font-size: 0.8125rem;
  font-weight: 600;
}

.form-field-control { width: 100%; }

.form-submitting { opacity: 0.75; pointer-events: none; }

.icon-button {
  width: 36px;
  min-height: 36px;
  padding: 0;
  border: 0;
  background: transparent;
  font-size: 1.5rem;
}

.icon-button:hover { background: var(--surface-sunken); }

.form-error-message {
  margin: -4px 0 var(--space-2);
  font-size: 0.78rem;
  color: var(--down);
  font-weight: 500;
}

button, :is(.btn), .sidebar-group a, :is(.sidebar-signout), :is(.icon-button) {
  min-height: 40px;
}

button,
.btn,
.sidebar-group a,
.sidebar-signout,
.icon-button {
  -webkit-tap-highlight-color: transparent;
}

button,
.btn {
  min-height: 40px;
  border-radius: 9px;
  border-color: var(--border-strong);
  background: var(--surface);
  color: var(--ink);
  box-shadow: 0 1px 1px rgba(15,23,42,.025);
  font-weight: 600;
}

button:hover,
.btn:hover {
  border-color: #b9c0ce;
  background: #f8f9fc;
}

.btn-primary {
  background-color: var(--accent);
  color: #fff;
  border-color: var(--accent);
  background: var(--accent);
  box-shadow: 0 5px 14px rgba(79,70,229,.18);
}

.btn-primary:hover {
  border-color: var(--accent-hover);
  background: var(--accent-hover);
}

.btn-danger {
  color: var(--down);
  border-color: #e8b8b1;
  background: var(--down-soft);
}

.btn-danger:hover {
  border-color: var(--down);
  background: var(--down);
  color: #fff;
}

button:active:not(:disabled),
.btn:active:not(:disabled) {
  transform: translateY(1px);
}

button:disabled,
.btn:disabled {
  box-shadow: none;
}

.form-help {
  margin: 0 0 var(--space-2);
  font-size: 0.75rem;
  color: var(--ink-faint);
  line-height: 1.55;
}

.form-section {
  margin-bottom: 0;
  padding: 20px;
}

.form-actions {
  display: flex;
  justify-content: flex-end;
  gap: var(--space-2);
  padding-top: 4px;
}


/* ---------- Cards & tables ---------- */

.card-value.up { color: var(--up); }

.card-value.down { color: var(--down); }

.table-responsive { overflow-x: auto; border-radius: var(--radius-md); }

.table-responsive table { border-radius: 0; border: none; }

.data-section.two-col { display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-5); }

.card-trend {
  font-size: 0.75rem;
  font-weight: 500;
  font-family: var(--font-sans);
  color: var(--ink-muted);
}

.card-trend-up {
  color: var(--up);
}

.card-trend-down {
  color: var(--down);
}

.card-trend-flat {
  color: var(--ink-faint);
}

:is(.data-table) {
  width: 100%;
  border-collapse: collapse;
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: var(--radius-md);
  overflow: hidden;
  font-size: 0.875rem;
  margin: 0;
}

.data-table th {
  text-align: left;
  font-size: 0.75rem;
  font-weight: 600;
  color: var(--ink-muted);
  background: var(--surface-sunken);
  padding: var(--space-3) var(--space-4);
  border-bottom: 1px solid var(--border);
  white-space: nowrap;
}

.data-table td {
  padding: var(--space-3) var(--space-4);
  border-bottom: 1px solid var(--border);
  color: var(--ink);
  font-family: var(--font-mono);
  font-variant-numeric: tabular-nums;
}

.data-table td:first-child,
.data-table th:first-child {
  font-family: var(--font-sans);
}

.data-table tbody tr:last-child td {
  border-bottom: none;
}

.data-table tbody tr:hover td {
  background-color: var(--surface-sunken);
}

.list-row:last-child { border-bottom: 0; }

.details dt { font-weight: 600; }

.details dd { margin: 0; overflow-wrap: anywhere; }

.tabs > * { flex: 0 0 auto; }

.data-table caption {
  text-align: left;
  padding: var(--space-3) var(--space-4);
  font-weight: 600;
  color: var(--ink);
}

.data-table tbody tr:focus-within td { background: var(--surface-sunken); }

.metric-card.metric-primary {
  border-color: var(--border-strong);
}

.data-cell {
  font-family: var(--font-mono);
  font-size: 0.75rem;
  font-variant-numeric: tabular-nums;
}

.list-row:last-child { border-bottom: 0; }

.table-scroll {
  width: 100%;
  overflow-x: auto;
  -webkit-overflow-scrolling: touch;
}

.table-scroll table {
  min-width: 620px;
}

.row-actions {
  display: flex;
  gap: var(--space-2);
  flex-wrap: wrap;
  align-items: center;
  justify-content: flex-end;
}

.billing-page .card { box-shadow: none; }

.card,
.data-section,
.skeleton-card {
  border-color: var(--border);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-card);
}

.card {
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: var(--radius-md);
  box-shadow: var(--shadow-card);
  padding: 18px;
  margin: 0;
  display: flex;
  flex-direction: column;
  gap: var(--space-1);
}

.data-section {
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: var(--radius-md);
  padding: 20px;
  margin-bottom: 0;
  box-shadow: var(--shadow-card);
}

.feature-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
  gap: 18px;
}

.metric-card {
  gap: 8px;
  min-width: 0;
  min-height: 126px;
  justify-content: flex-start;
  overflow: hidden;
}

.metric-card::before {
  content: "";
  width: 30px;
  height: 4px;
  border-radius: var(--radius-full);
  background: var(--border-strong);
}

.metric-card:nth-child(1)::before { background: var(--accent); }

.metric-card:nth-child(2)::before { background: var(--up); }

.metric-card:nth-child(3)::before { background: var(--down); }

.metric-card:nth-child(4)::before { background: #9aa3b2; }

.metric-card:nth-child(5)::before { background: var(--degraded); }

.metric-card.metric-primary {
  background: linear-gradient(145deg, #fff, #f7f7ff);
  border-color: #dcdcf8;
}

.card-label {
  font-size: .72rem;
  font-weight: 650;
  color: var(--ink-muted);
  letter-spacing: .02em;
}

.card-value {
  font-family: var(--font-mono);
  font-size: 1.9rem;
  font-weight: 600;
  color: var(--ink);
  font-variant-numeric: tabular-nums;
  letter-spacing: -.04em;
}

.card-hint {
  color: var(--ink-faint);
  font-size: .7rem;
}

.metric-strip {
  display: grid;
  grid-template-columns: repeat(5, minmax(0, 1fr));
  gap: 12px;
}

table,
:is(.data-table) {
  border-color: var(--border);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-card);
}

th,
.data-table th {
  background: #f8f9fc;
  color: #697386;
  font-size: .67rem;
  letter-spacing: .035em;
  text-transform: uppercase;
}

td,
.data-table td {
  padding: 13px 16px;
  border-bottom-color: var(--border-subtle);
}

tbody tr:hover td,
.data-table tbody tr:hover td {
  background: #fafbff;
}

.list-stack {
  display: flex;
  flex-direction: column;
  gap: 0;
  border: 1px solid var(--border);
  border-radius: var(--radius-lg);
  overflow: hidden;
  border-color: var(--border);
  box-shadow: var(--shadow-sm);
}

.list-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: var(--space-4);
  padding: 12px 16px;
  border-bottom: 1px solid var(--border);
  background: var(--surface);
  min-height: 58px;
}

.list-row:hover {
  background: #fafbff;
}

.details {
  display: grid;
  grid-template-columns: minmax(120px, 180px) 1fr;
  gap: 10px 24px;
}

.quote-box {
  display: flex;
  flex-direction: column;
  gap: var(--space-1);
  margin-top: var(--space-3);
  padding: var(--space-3);
  border: 1px solid var(--border);
  border-radius: var(--radius-md);
  border-color: var(--border);
  background: #fbfcfe;
}

.tabs {
  display: flex;
  gap: 4px;
  border-bottom: 1px solid var(--border);
  overflow-x: auto;
  padding: 4px;
  border: 1px solid var(--border);
  border-radius: 10px;
  background: var(--surface-sunken);
}

.tabs > * {
  border-radius: 7px;
}


/* ---------- Loading / error / empty states ---------- */

:is(.loading), :is(.auth-loading) {
  color: var(--ink-muted);
  font-size: 0.875rem;
  padding: var(--space-5) 0;
}

@keyframes spin { to { transform: rotate(360deg); } }

.skeleton { display: flex; flex-direction: column; gap: var(--space-2); }

.skeleton-line.short { width: 40%; }

@keyframes shimmer { 0% { background-position: 100% 50%; } 100% { background-position: 0 50%; } }

@keyframes pulse {
  0% { transform: scale(1); opacity: 0.6; }
  100% { transform: scale(2.6); opacity: 0; }
}

.empty-state-title {
  font-size: 1rem;
  font-weight: 600;
  color: var(--ink);
  margin: 0;
}

.empty-state-description {
  font-size: 0.875rem;
  color: var(--ink-muted);
  margin: 0;
  max-width: 420px;
}

.empty-state-actions {
  margin-top: var(--space-2);
  display: flex;
  gap: var(--space-2);
  flex-wrap: wrap;
  justify-content: center;
}

.error-state-title {
  font-size: 1rem;
  font-weight: 600;
  color: var(--down);
  margin: 0;
}

.error-state-description {
  font-size: 0.875rem;
  color: var(--ink-muted);
  margin: 0;
  max-width: 420px;
}

.error-state .btn {
  margin-top: var(--space-2);
}

.skeleton-card {
  padding: var(--space-4);
  border: 1px solid var(--border);
  border-radius: var(--radius-md);
  background: var(--surface);
}

.skeleton-circle { width: 40px; height: 40px; border-radius: 50%; }

.skeleton-text { height: 14px; width: 70%; }

.skeleton-rect { height: 120px; width: 100%; }

:is(.skeleton-card), :is(.skeleton-line), :is(.skeleton-circle), :is(.skeleton-text), :is(.skeleton-rect) {
  background-color: var(--surface-sunken);
}

.dashboard-refresh-error .btn {
  flex: 0 0 auto;
  padding: 0.35rem 0.625rem;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  gap: var(--space-2);
  padding: var(--space-5);
  background: var(--surface);
  border: 1px dashed var(--border);
  border-radius: var(--radius-sm);
  margin: var(--space-4) 0;
}

.empty-state h2,
.empty-state h3,
.empty-state p {
  margin-bottom: var(--space-2);
}

.network-status-offline {
  color: var(--down);
  background: var(--surface);
}

.network-status-dot {
  width: 7px;
  height: 7px;
  flex: 0 0 auto;
  border-radius: 50%;
  background: currentColor;
}

.dashboard-refresh-error {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--space-3);
  padding: var(--space-3) var(--space-4);
  border: 1px solid var(--down-soft);
  border-radius: var(--radius-md);
  background: #fffafa;
  color: var(--down);
  font-size: 0.8125rem;
  border-color: #ead1cd;
}

.alert,
.toast,
.success,
.error,
.form-error,
.auth-success,
.error-state {
  border-radius: var(--radius-md);
}

.error-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  gap: var(--space-2);
  padding: var(--space-5) var(--space-4);
  background-color: var(--down-soft);
  border: 1px solid rgba(194, 49, 31, 0.25);
  border-radius: var(--radius-md);
  margin: var(--space-4) 0;
  background: #fffafa;
}

.loading-container {
  display: flex;
  align-items: center;
  gap: var(--space-3);
  color: var(--ink-muted);
  font-size: 0.875rem;
  min-height: 120px;
  justify-content: center;
}

.loading-spinner {
  display: inline-block;
  border: 2.5px solid var(--border);
  border-radius: 50%;
  border-top-color: var(--accent);
  width: 20px;
  height: 20px;
  animation: spin 0.8s linear infinite;
  flex-shrink: 0;
  border-width: 2px;
}

.skeleton-card,
.skeleton-line,
.skeleton-circle,
.skeleton-text,
.skeleton-rect {
  background-color: #eef1f5;
}

.skeleton-line {
  height: 12px;
  border-radius: var(--radius-sm);
  background: linear-gradient(90deg, var(--surface-sunken) 25%, var(--border) 37%, var(--surface-sunken) 63%);
  background-size: 400% 100%;
  animation: shimmer 1.4s ease infinite;
  width: 100%;
  background-image: linear-gradient(90deg, #eef1f5 25%, #e3e7ed 37%, #eef1f5 63%);
}

.network-status {
  position: sticky;
  top: 0;
  z-index: 20;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: var(--space-2);
  min-height: 36px;
  padding: 0.45rem var(--space-4);
  border-bottom: 1px solid var(--border);
  background: rgba(255,255,255,.92);
  color: var(--ink-muted);
  font-size: .72rem;
  font-weight: 600;
  border-bottom-color: var(--border);
}


/* ---------- Dashboard ---------- */

.dashboard-page-header h1 {
  margin: 0;
  font-size: 2rem;
}

:is(.section-heading),
:is(.widget-heading) {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: var(--space-4);
}

.section-heading h2,
.widget-heading h2 {
  margin-bottom: 0;
}

.trend-line {
  vector-effect: non-scaling-stroke;
}

.trend-axis {
  display: flex;
  justify-content: space-between;
  padding-top: var(--space-2);
  color: var(--ink-faint);
  font-family: var(--font-mono);
  font-size: 0.625rem;
}

.trend-empty small {
  color: var(--ink-faint);
}

.dashboard-monitor-table th,
.dashboard-monitor-table td {
  padding: 0.75rem 1rem;
}

.dashboard-monitor-table th {
  white-space: nowrap;
}

.dashboard-monitor-table tbody tr:last-child td {
  border-bottom: 0;
}

.dashboard-empty h3 {
  font-size: 1rem;
}

.dashboard-empty p {
  max-width: 480px;
  font-size: 0.8125rem;
}

.dashboard-empty .btn {
  margin-top: var(--space-2);
}

.dashboard-empty.compact {
  align-items: flex-start;
  text-align: left;
  padding: var(--space-5);
}

.dashboard-data-note {
  color: var(--ink-faint);
  font-size: 0.6875rem;
  line-height: 1.5;
}

.performance-index {
  color: var(--ink-faint);
  font: 0.7rem var(--font-mono);
  text-align: right;
}

.performance-up { background: var(--up); }

.performance-down { background: var(--down); }

.performance-value {
  color: var(--ink-muted);
  font: 0.72rem var(--font-mono);
  text-align: right;
}

.performance-bars {
  display: flex;
  flex-direction: column;
  gap: 7px;
  overflow-x: auto;
}

.performance-row {
  display: grid;
  grid-template-columns: 28px 1fr 72px;
  align-items: center;
  gap: 8px;
  min-height: 24px;
  min-width: 520px;
}

.dashboard-overview {
  display: flex;
  flex-direction: column;
  gap: 18px;
}

.dashboard-page-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--space-4);
  padding-bottom: var(--space-4);
  border-bottom: 1px solid var(--border);
  padding: 24px;
  background: radial-gradient(circle at 92% 10%, rgba(79,70,229,.09), transparent 15rem),
    linear-gradient(135deg, #fff 0%, #fafaff 100%);
}

.dashboard-page-header .btn {
  min-width: 96px;
}

.dashboard-content {
  display: flex;
  flex-direction: column;
  gap: 28px;
}

.dashboard-section {
  display: flex;
  flex-direction: column;
  gap: 12px;
}

:is(.section-heading),
:is(.widget-heading) {
  align-items: center;
}

.section-heading h2,
.widget-heading h2 {
  font-size: 1rem;
  letter-spacing: -.02em;
}

.section-heading > a,
.dashboard-section > .section-heading a {
  font-size: .78rem;
  font-weight: 650;
}

.dashboard-trend-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 14px;
}

.dashboard-trend-card {
  min-height: 238px;
  padding: 18px;
}

.dashboard-trend-card .widget-heading {
  align-items: flex-start;
}

.trend-value {
  flex-shrink: 0;
  font-family: var(--font-mono);
  font-size: 1.1rem;
  font-variant-numeric: tabular-nums;
  color: var(--ink);
  font-weight: 700;
}

.trend-chart-wrap {
  margin-top: 18px;
  overflow: hidden;
  border-top: 1px solid var(--border);
  border-bottom: 1px solid var(--border);
  border-top-color: var(--border-subtle);
  border-bottom-color: var(--border-subtle);
  background: linear-gradient(180deg, rgba(79,70,229,.025), transparent);
}

.trend-chart {
  display: block;
  width: 100%;
  height: 128px;
  color: var(--accent);
}

.trend-empty {
  display: flex;
  min-height: 136px;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: var(--space-1);
  margin-top: var(--space-3);
  border: 1px dashed var(--border-strong);
  border-radius: var(--radius-sm);
  color: var(--ink-muted);
  text-align: center;
  font-size: 0.8125rem;
  border-color: #d8dce5;
  background: #fbfcfe;
}

.dashboard-monitor-table {
  min-width: 640px;
  border: 0;
  background: var(--surface);
}

.dashboard-monitor-table th,
.dashboard-monitor-table td {
  padding: 13px 16px;
}

.dashboard-monitor-table th {
  background: #f8f9fc;
  color: #697386;
  font-size: .68rem;
  letter-spacing: .03em;
  text-transform: uppercase;
}

.dashboard-monitor-table tbody tr:hover td {
  background: #fafbff;
}

.dashboard-empty {
  display: flex;
  align-items: center;
  text-align: center;
  flex-direction: column;
  gap: var(--space-2);
  padding: 34px 24px;
  border: 1px dashed var(--border-strong);
  border-radius: var(--radius-md);
  background: radial-gradient(circle at 50% 0, rgba(79,70,229,.05), transparent 14rem),
    var(--surface);
  min-height: 210px;
  border-color: #d5d9e4;
}

.dashboard-empty h3 {
  font-size: 1.05rem;
}

.dashboard-empty p {
  color: var(--ink-muted);
  line-height: 1.6;
}

.performance-track {
  height: 9px;
  overflow: hidden;
  background: #e9ecf2;
  border-radius: 999px;
}

.performance-fill {
  height: 100%;
  min-width: 2px;
  border-radius: inherit;
  background: var(--accent);
}


/* ---------- Proxy checker ---------- */

.proxy-check-page { max-width: 1180px; }

.proxy-input-card { gap: var(--space-4); }

.proxy-input-tabs {
  display: flex;
  gap: var(--space-2);
  align-items: center;
  flex-wrap: wrap;
}

.proxy-input-tabs > button,
:is(.proxy-file-button) { width: auto; }

.proxy-input-tabs > button.active,
.proxy-filters > button.active {
  background: var(--accent-soft);
  border-color: var(--accent);
  color: var(--accent);
}

:is(.proxy-file-button) {
  position: relative;
  overflow: hidden;
  cursor: pointer;
}

.proxy-file-button input[type="file"] {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  opacity: 0;
  cursor: pointer;
}

.proxy-input-meta {
  display: flex;
  justify-content: space-between;
  gap: var(--space-3);
  color: var(--ink-muted);
  font-size: 0.8125rem;
  font-family: var(--font-mono);
}

.proxy-inline-error { color: var(--down); }

.proxy-progress-card { margin-top: var(--space-5); }

.proxy-progress-stats {
  display: grid;
  grid-template-columns: repeat(5, minmax(90px, 1fr));
  gap: var(--space-3);
  margin-top: var(--space-3);
  color: var(--ink-muted);
  font-size: 0.8125rem;
}

.proxy-progress-stats strong {
  color: var(--ink);
  font-family: var(--font-mono);
  font-variant-numeric: tabular-nums;
}

.proxy-actions,
.proxy-export-actions {
  display: flex;
  gap: var(--space-2);
  flex-wrap: wrap;
}

.proxy-summary-card span {
  display: block;
  color: var(--ink-muted);
  font-size: 0.72rem;
  font-weight: 600;
  letter-spacing: 0.04em;
}

.proxy-summary-card strong {
  display: block;
  margin-top: var(--space-1);
  font-family: var(--font-mono);
  font-size: 1.5rem;
  font-variant-numeric: tabular-nums;
}

.proxy-summary-card strong.up { color: var(--up); }

.proxy-summary-card strong.down { color: var(--down); }

.proxy-filters {
  display: flex;
  gap: var(--space-2);
  flex-wrap: wrap;
  margin-bottom: var(--space-4);
}

.proxy-filters button { padding: 0.4rem 0.7rem; }

.proxy-results-table { min-width: 900px; }

.proxy-results-table td { white-space: nowrap; }

.proxy-results-table td:last-child {
  max-width: 300px;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.proxy-results-table .up { color: var(--up); font-weight: 600; }

.proxy-results-table .down { color: var(--down); font-weight: 600; }

.feature-page,
.monitor-detail,
.proxy-check-page,
.billing-page {
  gap: 18px;
}

.proxy-summary {
  display: grid;
  grid-template-columns: repeat(5, minmax(130px, 1fr));
  gap: 12px;
  margin: var(--space-5) 0;
}

.proxy-summary-card {
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-card);
  padding: 16px;
  border-color: var(--border);
}

.proxy-summary-card span {
  color: var(--ink-muted);
}

.proxy-results-card {
  overflow: hidden;
  padding: 18px;
}

.proxy-progress-track {
  width: 100%;
  height: 9px;
  overflow: hidden;
  background: #e9ecf2;
  border-radius: 999px;
  border: 0;
}

.proxy-progress-fill {
  height: 100%;
  background: var(--accent);
  border-radius: inherit;
  transition: width 0.2s ease;
}


/* ---------- Monitors ---------- */

.monitor-info { display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: var(--space-3) var(--space-5); background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius-md); padding: var(--space-4); margin-bottom: var(--space-5); box-shadow: var(--shadow-card); }

.monitor-info p { color: var(--ink); font-size: 0.875rem; }

.monitor-info strong { color: var(--ink-muted); font-weight: 500; }

.monitor-table-wrap {
  max-width: 100%;
  overflow-x: auto;
  overflow-y: hidden;
  -webkit-overflow-scrolling: touch;
  overscroll-behavior-x: contain;
  border: 1px solid var(--border);
  border-radius: var(--radius-md);
  background: var(--surface);
}

.monitor-link,
.incident-link {
  color: var(--ink);
  font-weight: 600;
}

.monitor-link:hover,
.incident-link:hover {
  color: var(--accent);
  text-decoration: none;
}

.monitor-detail {
  display: flex;
  flex-direction: column;
  gap: var(--space-4);
  max-width: 1200px;
}

.monitor-identity h2 { margin: 2px 0 2px; }

.monitor-status { flex: 0 0 auto; }

.monitor-subform { margin-top: var(--space-4); }

.monitor-form { gap: var(--space-4); }

.monitor-form .form-section h2 { margin-bottom: var(--space-3); }

.stack-form,
.monitor-form {
  gap: 16px;
}

.monitor-table-wrap,
.incident-list {
  border-color: var(--border);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-card);
}

.monitor-identity {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--space-4);
  padding: 22px;
}

.monitor-identity h2 {
  font-size: 1.35rem;
  letter-spacing: -.025em;
}

.monitor-health-metrics {
  grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
  margin-bottom: 0;
  gap: 12px;
}


/* ---------- Auth ---------- */

.auth-success { color: var(--up); background: var(--up-soft); border: 1px solid rgba(18, 133, 90, 0.25); padding: var(--space-3) var(--space-4); border-radius: var(--radius-sm); }

.auth-card-center { text-align: center; }

.auth-brand { display: flex; align-items: center; gap: var(--space-2); margin-bottom: var(--space-5); }

.auth-brand-name { font-weight: 700; letter-spacing: -0.01em; color: var(--ink); }

.auth-hint { font-size: 0.875rem; color: var(--ink-muted); }

.auth-links { margin-top: var(--space-5); font-size: 0.8125rem; color: var(--ink-muted); text-align: center; }

.auth-links-sep { margin: 0 var(--space-2); color: var(--ink-faint); }

:is(.alert), :is(.toast), :is(.success), :is(.error), :is(.form-error), :is(.auth-success) {
  border-radius: var(--radius-sm);
  padding: var(--space-3) var(--space-4);
  font-size: 0.875rem;
  border: 1px solid var(--border);
}

:is(.alert-success), :is(.toast-success), :is(.success), :is(.auth-success) {
  color: var(--up);
  background: var(--up-soft);
  border-color: rgba(18, 133, 90, 0.25);
}

.auth-card h1 { margin-top: var(--space-5); font-size: 1.85rem; }

.auth-subtitle {
  font-size: 0.875rem;
  margin-bottom: var(--space-5);
  margin-top: var(--space-2);
}

.auth-form {
  display: flex;
  flex-direction: column;
  gap: 14px;
}

.auth-form input { min-height: 44px; border-radius: 7px; }

.auth-form .btn-primary { min-height: 44px; border-radius: 7px; font-weight: 600; }

.auth-divider { display: flex; align-items: center; gap: 12px; margin: 22px 0 14px; color: var(--ink-faint); font-size: .75rem; }

.auth-divider::before, .auth-divider::after { content: ""; flex: 1; height: 1px; background: var(--border); }

.auth-divider span { white-space: nowrap; }

.auth-shell {
  min-height: 100vh;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: var(--space-5);
  background-color: var(--ink);
  background-image: radial-gradient(rgba(255, 255, 255, 0.06) 1px, transparent 1px);
  background-size: 22px 22px;
  background: radial-gradient(circle at 15% 10%, rgba(99,102,241,.22), transparent 25rem),
    radial-gradient(circle at 90% 85%, rgba(20,184,166,.12), transparent 22rem),
    #0b1220;
}

.auth-card {
  width: 100%;
  max-width: 430px;
  background: var(--surface);
  border-radius: 18px;
  box-shadow: 0 30px 80px rgba(0,0,0,.34);
  padding: 34px 30px;
  border: 1px solid rgba(255,255,255,.45);
  border-color: rgba(255,255,255,.55);
}

.auth-brand-mark {
  width: 28px;
  height: 28px;
  border-radius: 9px;
  background: var(--accent-soft);
  display: flex;
  align-items: center;
  justify-content: center;
}

.auth-form input {
  min-height: 46px;
}

.auth-form .btn-primary {
  min-height: 46px;
}


/* ---------- Billing ---------- */

.billing-page { max-width: 960px; }

.billing-page .section-heading { align-items: flex-start; }

.billing-page .error, .billing-page .success { border-radius: var(--radius-sm); }


/* ---------- Status pages ---------- */

:is(.check-item), :is(.incident-item), :is(.channel-item) {
  display: flex;
  gap: var(--space-4);
  align-items: center;
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: var(--radius-sm);
  padding: var(--space-3) var(--space-4);
  font-size: 0.8125rem;
  font-family: var(--font-mono);
}

.status-page-inner h1 { margin-bottom: var(--space-5); }

.status-hero-label { font-weight: 600; }

.status-dot { width: 10px; height: 10px; border-radius: 50%; background: var(--neutral); flex-shrink: 0; }

[data-variant="operational"] .status-dot, .status-dot[data-variant="operational"] { background: var(--up); }

[data-variant="degraded"] .status-dot, .status-dot[data-variant="degraded"] { background: var(--degraded); }

[data-variant="outage"] .status-dot, .status-dot[data-variant="outage"] { background: var(--down); }

[data-variant="paused"] .status-dot, .status-dot[data-variant="paused"] { background: var(--ink-faint); }

.status-section { margin-bottom: var(--space-6); }

:is(.service-list), :is(.incident-list) { list-style: none; background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius-md); overflow: hidden; box-shadow: var(--shadow-card); }

:is(.service-row), :is(.incident-row) { display: flex; align-items: center; justify-content: space-between; padding: var(--space-4); border-bottom: 1px solid var(--border); }

.service-row:last-child, .incident-row:last-child { border-bottom: none; }

:is(.service-name), :is(.incident-title) { font-weight: 500; font-size: 0.9375rem; }

:is(.service-url), :is(.incident-description) { font-size: 0.8125rem; color: var(--ink-muted); }

:is(.service-uptime), :is(.incident-date) { font-family: var(--font-mono); font-size: 0.8125rem; color: var(--ink-muted); }

.status-badge-label {
  color: inherit;
}

.status-badge-neutral,
.status-badge-paused {
  background-color: var(--neutral-soft);
  color: var(--neutral);
}

:is(.status-badge-warning), :is(.status-badge-degraded) { color: var(--status-warning); background: var(--status-warning-soft); }

:is(.status-badge-unknown), :is(.status-badge-neutral) { color: var(--status-unknown); background: var(--status-unknown-soft); }

:is(.status-badge-disabled), :is(.status-badge-paused) { color: var(--status-disabled); background: var(--status-disabled-soft); }

.incident-list {
  list-style: none;
  overflow: hidden;
  border: 1px solid var(--border);
  border-radius: var(--radius-md);
  background: var(--surface);
}

.incident-item + .incident-item {
  border-top: 1px solid var(--border);
}

.incident-link {
  display: flex;
  align-items: center;
  gap: var(--space-3);
  padding: var(--space-3) var(--space-4);
}

.incident-marker {
  width: 8px;
  height: 8px;
  flex: 0 0 8px;
  border-radius: 50%;
  background: var(--down);
}

.incident-copy {
  display: flex;
  min-width: 0;
  flex: 1;
  flex-direction: column;
  gap: 2px;
}

.incident-copy strong {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.incident-copy small {
  color: var(--ink-faint);
  font-family: var(--font-mono);
  font-size: 0.6875rem;
  font-weight: 400;
}

.incident-arrow {
  color: var(--ink-faint);
  font-size: 1rem;
}

.status-badge {
  display: inline-flex;
  align-items: center;
  gap: var(--space-2);
  font-size: .72rem;
  font-weight: 650;
  font-family: var(--font-sans);
  padding: 5px 9px;
  border-radius: var(--radius-full);
  white-space: nowrap;
  border: 1px solid transparent;
  min-height: 28px;
}

.status-badge-dot {
  width: 6px;
  height: 6px;
  border-radius: 50%;
  flex-shrink: 0;
  background: currentColor;
}

.status-badge-up {
  background-color: var(--up-soft);
  color: var(--up);
  background: var(--up-soft);
  border-color: #ccebdd;
}

.status-badge-down {
  background-color: var(--down-soft);
  color: var(--down);
  background: var(--down-soft);
  border-color: #f0d0ca;
}

.status-badge-degraded {
  background-color: var(--degraded-soft);
  color: var(--degraded);
  background: var(--degraded-soft);
  border-color: #f0dfb9;
}

.status-badge-neutral,
.status-badge-paused,
.status-badge-unknown {
  color: var(--neutral);
  background: var(--neutral-soft);
  border-color: #e1e4ea;
}

.status-page {
  min-height: 100vh;
  background-color: var(--bg);
  padding: var(--space-7) var(--space-5);
  background: var(--bg);
}

.status-page-inner {
  max-width: 820px;
  margin: 0 auto;
}

.status-hero {
  display: flex;
  align-items: center;
  gap: var(--space-3);
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: var(--radius-lg);
  padding: var(--space-4) var(--space-5);
  margin-bottom: var(--space-6);
  box-shadow: var(--shadow-card);
}

.service-list,
.status-page .incident-list {
  border-color: var(--border);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-card);
}


/* ---------- Dialogs / search / filters ---------- */

.channel-form input, .channel-form select { width: auto; flex: 1; min-width: 160px; }

.filters-bar {
  display: flex;
  gap: var(--space-5);
  align-items: flex-end;
  flex-wrap: wrap;
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: var(--radius-md);
  padding: var(--space-4);
  margin-bottom: var(--space-5);
}

.filters-bar label { display: flex; flex-direction: column; gap: var(--space-1); font-size: 0.75rem; }

.filters-bar select, .filters-bar input { width: auto; min-width: 150px; }

.dialog-overlay {
  position: fixed;
  inset: 0;
  background-color: rgba(18, 21, 28, 0.55);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
  padding: var(--space-4);
}

.dialog-panel {
  background: var(--surface);
  border-radius: var(--radius-md);
  box-shadow: 0 16px 32px rgba(0, 0, 0, 0.24);
  padding: var(--space-5);
  max-width: 420px;
  width: 100%;
  display: flex;
  flex-direction: column;
  gap: var(--space-3);
}

.dialog-title {
  font-size: 1.125rem;
  font-weight: 600;
  color: var(--ink);
  margin: 0;
}

.dialog-body {
  font-size: 0.875rem;
  color: var(--ink-muted);
  margin: 0;
}

.dialog-actions {
  display: flex;
  gap: var(--space-3);
  justify-content: flex-end;
  margin-top: var(--space-2);
}

.modal-overlay {
  position: fixed;
  inset: 0;
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: var(--space-4);
  background: var(--surface-overlay);
}

.modal-panel {
  width: min(560px, 100%);
  max-height: min(720px, calc(100vh - 32px));
  overflow: auto;
  background: var(--surface-raised);
  border: 1px solid var(--border);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-lg);
}

.modal-title { margin: 0; }

.modal-body { padding: var(--space-5); }

.command-palette {
  width: min(640px, calc(100vw - 32px));
  padding: var(--space-3);
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-lg);
}

.command-palette-results { margin-top: var(--space-2); max-height: 360px; overflow: auto; }

.filter-bar,
.filters-bar {
  gap: 12px;
  padding: 14px;
  border-color: var(--border);
  border-radius: var(--radius-lg);
  background: rgba(255,255,255,.9);
  box-shadow: var(--shadow-sm);
}

.modal-overlay,
.dialog-overlay {
  background: rgba(15, 23, 42, .52);
  backdrop-filter: blur(2px);
}

.modal-panel,
.dialog-panel,
.dropdown-menu,
.command-palette {
  border-color: var(--border);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-lg);
}

.modal-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--space-3);
  padding: 16px 20px;
  border-bottom: 1px solid var(--border);
}

.modal-body,
.dialog-panel {
  padding: 20px;
}

.channel-form {
  display: flex;
  gap: var(--space-3);
  flex-wrap: wrap;
  align-items: flex-end;
  background: #fbfcfe;
  border: 1px solid var(--border);
  border-radius: var(--radius-lg);
  padding: var(--space-4);
  border-color: var(--border);
}


/* ---------- Shared status / text utilities ---------- */

.muted {
  color: var(--ink-muted);
  font-size: 0.8125rem;
}

.eyebrow {
  margin-bottom: 2px;
  color: #7b8495;
  font-size: .64rem;
  line-height: 1.3;
  font-weight: 700;
  letter-spacing: .13em;
  display: block;
  text-transform: uppercase;
}

.secret-box {
  display: flex;
  flex-direction: column;
  gap: var(--space-2);
  padding: var(--space-3);
  border: 1px solid var(--border);
  border-radius: var(--radius-md);
  background: #fffdf4;
  position: relative;
  border-color: #e0d9b6;
}


/* ---------- Other feature/component styles ---------- */

h1, h2, h3 { font-weight: 600; letter-spacing: -0.01em; color: var(--ink); }

h1 { font-size: 1.625rem; }

h2 { font-size: 1.0625rem; margin-bottom: var(--space-3); }

p { color: var(--ink-muted); }

:focus-visible {
  outline: 2px solid var(--accent);
  outline-offset: 2px;
}

input, select, textarea {
  font-family: var(--font-sans);
  font-size: 0.9375rem;
  color: var(--ink);
  background-color: var(--surface);
  border: 1px solid var(--border-strong);
  border-radius: var(--radius-sm);
  padding: 0.5rem 0.625rem;
  width: 100%;
}

input:focus, select:focus, textarea:focus {
  outline: none;
  border-color: var(--accent);
  box-shadow: 0 0 0 3px var(--accent-soft);
}

label { display: block; font-size: 0.8125rem; font-weight: 500; color: var(--ink-muted); margin-bottom: var(--space-1); }

.app-header {
  background-color: var(--ink);
  color: #fff;
  padding: 0 var(--space-5);
  height: 56px;
  display: flex;
  align-items: center;
  gap: var(--space-6);
}

.app-brand a { color: #fff; font-weight: 700; letter-spacing: -0.01em; }

.app-nav { display: flex; gap: var(--space-4); flex: 1; }

.app-nav a { color: rgba(255, 255, 255, 0.72); font-size: 0.875rem; font-weight: 500; }

.app-nav a:hover, .app-nav a.active { color: #fff; text-decoration: none; }

.app-user { display: flex; align-items: center; gap: var(--space-3); font-size: 0.8125rem; color: rgba(255, 255, 255, 0.72); font-family: var(--font-mono); }

.app-user a { color: rgba(255, 255, 255, 0.85); font-family: var(--font-sans); }

.overview-cards {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
  gap: var(--space-4);
  margin-bottom: var(--space-6);
}

table {
  width: 100%;
  border-collapse: collapse;
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: var(--radius-md);
  overflow: hidden;
  font-size: 0.875rem;
}

:is(.monitors-table), table { margin-bottom: var(--space-5); }

th {
  text-align: left;
  font-size: 0.75rem;
  font-weight: 600;
  color: var(--ink-muted);
  background: var(--surface-sunken);
  padding: var(--space-3) var(--space-4);
  border-bottom: 1px solid var(--border);
}

td {
  padding: var(--space-3) var(--space-4);
  border-bottom: 1px solid var(--border);
  color: var(--ink);
  font-family: var(--font-mono);
  font-variant-numeric: tabular-nums;
}

td:first-child, th:first-child { font-family: var(--font-sans); }

tr:last-child td { border-bottom: none; }

tbody tr:hover td { background-color: var(--surface-sunken); }

td button, td .btn { padding: 0.3rem 0.625rem; font-size: 0.8125rem; margin-right: var(--space-2); }

:is(.error), :is(.form-error) {
  background-color: var(--down-soft);
  border: 1px solid rgba(194, 49, 31, 0.25);
  color: var(--down);
  padding: var(--space-3) var(--space-4);
  border-radius: var(--radius-sm);
  font-size: 0.875rem;
  margin: var(--space-3) 0;
}

.error-boundary {
  background-color: var(--down-soft);
  border: 1px solid rgba(194, 49, 31, 0.25);
  color: var(--down);
  padding: var(--space-4);
  border-radius: var(--radius-md);
  margin: var(--space-4) 0;
}

.pulse-dot { width: 8px; height: 8px; border-radius: 50%; background: var(--accent); position: relative; }

.pulse-dot::after {
  content: "";
  position: absolute; inset: 0;
  border-radius: 50%;
  background: var(--accent);
  animation: pulse 2s ease-out infinite;
}

.field { display: flex; flex-direction: column; }

:is(.checks-list), :is(.incidents-list), :is(.channels-list) { display: flex; flex-direction: column; gap: var(--space-2); margin-bottom: var(--space-5); }

.channel-item { justify-content: space-between; font-family: var(--font-sans); }

.channel-item button { margin: 0; }

.chart-section { margin-bottom: var(--space-5); }

.chart-container {
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: var(--radius-md);
  padding: var(--space-4);
  box-shadow: var(--shadow-card);
}

.chart-container svg polyline { stroke: var(--accent); }

.chart-container svg text { fill: var(--ink-faint); font-size: 12px; font-family: var(--font-mono); }

.service-row-main { display: flex; align-items: center; gap: var(--space-3); }

.search-input {
  position: relative;
  width: 100%;
  max-width: 320px;
}

.search-input input {
  width: 100%;
  padding-left: var(--space-4);
  font-size: 0.875rem;
  border: 1px solid var(--border-strong);
  border-radius: var(--radius-sm);
  background-color: var(--surface);
  color: var(--ink);
}

.search-input input:focus {
  outline: none;
  border-color: var(--accent);
  box-shadow: 0 0 0 3px var(--accent-soft);
}

.filter-bar {
  display: flex;
  gap: var(--space-4);
  align-items: flex-end;
  flex-wrap: wrap;
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: var(--radius-md);
  padding: var(--space-4);
  margin-bottom: var(--space-5);
  box-shadow: var(--shadow-card);
}

.filter-bar label {
  display: flex;
  flex-direction: column;
  gap: var(--space-1);
  font-size: 0.75rem;
  font-weight: 500;
  color: var(--ink-muted);
}

.filter-bar select,
.filter-bar input {
  width: auto;
  min-width: 150px;
  font-size: 0.875rem;
}

.mobile-nav-toolbar,
.mobile-nav-backdrop,
.mobile-nav-close {
  display: none;
}

.totp-actions {
  display: flex;
  gap: var(--space-3);
  flex-wrap: wrap;
}

.totp-setup,
.totp-backup-codes {
  display: flex;
  flex-direction: column;
  gap: var(--space-3);
}

.totp-uri {
  display: block;
  word-break: break-all;
  background: var(--surface-muted, #f3f4f6);
  border: 1px solid var(--border);
  border-radius: var(--radius-sm);
  padding: var(--space-3);
  font-family: var(--font-mono);
  font-size: 0.8125rem;
  user-select: all;
}

.backup-code-list {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: var(--space-2);
  list-style: none;
  padding: 0;
  margin: 0;
}

.backup-code-list code {
  display: block;
  background: var(--surface-muted, #f3f4f6);
  border: 1px solid var(--border);
  border-radius: var(--radius-sm);
  padding: var(--space-2);
  font-family: var(--font-mono);
  font-size: 0.8125rem;
  text-align: center;
}

.feature-page { display: flex; flex-direction: column; gap: var(--space-4); max-width: 1200px; }

.stack-form { display: flex; flex-direction: column; gap: var(--space-3); }

.stack-form label, .stack-form fieldset { display: flex; flex-direction: column; gap: var(--space-2); }

.stack-form fieldset { border: 1px solid var(--border); padding: var(--space-3); border-radius: var(--radius-sm); }

.inline-form { display: flex; align-items: end; gap: var(--space-2); flex-wrap: wrap; }

.inline-form label { display: flex; flex-direction: column; gap: var(--space-1); }

.check-row { display: flex !important; flex-direction: row !important; align-items: center; gap: var(--space-2); }

.check-row input { width: auto; }

.secret-box code { user-select: all; overflow-wrap: anywhere; }

.subsection { margin-top: var(--space-4); padding-top: var(--space-4); border-top: 1px solid var(--border); }

.feature-editor { width: 100%; }

.link-button { width: 100%; background: transparent; border: 0; text-align: left; cursor: pointer; font: inherit; }

.article-content { white-space: pre-wrap; line-height: 1.65; }

.message { padding: var(--space-3); border-left: 3px solid var(--border); margin: var(--space-3) 0; }

input:disabled, select:disabled, textarea:disabled {
  background: var(--surface-sunken);
  color: var(--ink-faint);
  cursor: not-allowed;
}

input[aria-invalid="true"], select[aria-invalid="true"], textarea[aria-invalid="true"],
.input-error {
  border-color: var(--down);
}

input[aria-invalid="true"]:focus-visible, select[aria-invalid="true"]:focus-visible,
textarea[aria-invalid="true"]:focus-visible {
  box-shadow: 0 0 0 3px var(--down-soft);
}

.required-indicator { color: var(--down); margin-left: 2px; }

:is(.alert-info), :is(.toast-info) {
  color: var(--ink);
  background: var(--accent-soft);
  border-color: rgba(67, 56, 202, 0.20);
}

:is(.alert-warning), :is(.toast-warning) {
  color: var(--degraded);
  background: var(--degraded-soft);
  border-color: rgba(154, 99, 0, 0.25);
}

:is(.alert-error), :is(.toast-error), :is(.error), :is(.form-error) {
  color: var(--down);
  background: var(--down-soft);
  border-color: rgba(194, 49, 31, 0.25);
}

.toast {
  position: fixed;
  right: var(--space-5);
  bottom: var(--space-5);
  z-index: 1100;
  max-width: min(420px, calc(100vw - 32px));
  box-shadow: var(--shadow-md);
}

.dropdown { position: relative; }

.dropdown-trigger {
  display: inline-flex;
  align-items: center;
  min-height: 38px;
  padding: 0.5rem 0.875rem;
  border: 1px solid var(--border-strong);
  border-radius: var(--radius-sm);
  background: var(--surface);
  cursor: pointer;
  font-size: 0.875rem;
}

.dropdown-menu {
  position: absolute;
  z-index: 900;
  top: calc(100% + 4px);
  right: 0;
  min-width: 180px;
  padding: var(--space-2);
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: var(--radius-sm);
  box-shadow: var(--shadow-md);
}

.dropdown-menu > * { display: block; width: 100%; }

.pagination {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: var(--space-3);
  margin-top: var(--space-4);
}

.pagination span { color: var(--ink-muted); font-size: 0.8125rem; }

.tooltip { position: relative; display: inline-flex; }

.tooltip-content {
  position: absolute;
  z-index: 1000;
  left: 50%;
  bottom: calc(100% + 8px);
  transform: translateX(-50%);
  width: max-content;
  max-width: 260px;
  padding: var(--space-2) var(--space-3);
  border-radius: var(--radius-sm);
  background: var(--ink);
  color: var(--ink-inverse);
  font-size: 0.75rem;
  pointer-events: none;
  opacity: 0;
  transition: opacity var(--transition-fast);
}

.tooltip:hover .tooltip-content, .tooltip:focus-within .tooltip-content { opacity: 1; }

.date-range-picker {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: var(--space-3);
}

.date-range-picker label { margin: 0; }

.date-range-picker label span { display: block; margin-bottom: var(--space-1); }

:is(.check-row), :is(.switch-row) {
  display: flex !important;
  align-items: center;
  gap: var(--space-2);
  min-height: 38px;
  margin: 0;
}

.check-row input { width: 18px; min-height: 18px; }

.switch-row { cursor: pointer; }

.switch-input {
  position: absolute;
  opacity: 0;
  width: 1px;
  height: 1px;
}

.switch-track {
  width: 40px;
  height: 22px;
  padding: 2px;
  border-radius: var(--radius-full);
  background: var(--border-strong);
  transition: background-color var(--transition-fast);
}

.switch-thumb {
  display: block;
  width: 18px;
  height: 18px;
  border-radius: 50%;
  background: var(--surface);
  box-shadow: var(--shadow-sm);
  transition: transform var(--transition-fast);
}

.switch-input:checked + .switch-track { background: var(--accent); }

.switch-input:checked + .switch-track .switch-thumb { transform: translateX(18px); }

.switch-input:focus-visible + .switch-track { outline: 2px solid var(--accent); outline-offset: 2px; }

.widget-description {
  margin-top: 2px;
  font-size: 0.75rem;
  color: var(--ink-faint);
}

.muted-cell {
  color: var(--ink-faint);
}

:is(.mono), code { font-family: var(--font-mono); font-size: 0.82em; }

.section-heading {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: var(--space-3);
  margin-bottom: var(--space-3);
}

.section-heading h2 { margin-bottom: 0; }

.escalation-steps {
  margin: var(--space-2) 0 0 var(--space-5);
  color: var(--ink-muted);
  font-size: 0.8rem;
}

.secret-box code {
  max-height: 8rem;
  overflow: auto;
}

.oauth-stack { display: grid; gap: 10px; }

.oauth-provider-slot { width: 100%; min-height: 40px; display: flex; justify-content: center; }

#appleid-signin { height: 40px; }

.oauth-error { min-height: 1.25rem; margin-top: 8px; color: var(--down); font-size: .8125rem; text-align: center; }

img,
svg {
  max-width: 100%;
}

::selection {
  background: rgba(79, 70, 229, 0.18);
}

input,
select,
textarea {
  min-height: 42px;
  border-color: var(--border-strong);
  border-radius: 9px;
  background: var(--surface);
  box-shadow: inset 0 1px 2px rgba(15,23,42,.025);
}

input::placeholder,
textarea::placeholder {
  color: #a0a8b7;
}

input:focus,
select:focus,
textarea:focus {
  border-color: #7c74ea;
  box-shadow: 0 0 0 3px rgba(79,70,229,.10);
}

label,
:is(.form-field-label) {
  color: var(--ink-muted);
  font-size: .78rem;
  font-weight: 650;
}

.search-input input {
  border-radius: 9px;
}


/* ---------- Responsive / @media ---------- */

@media (prefers-reduced-motion: reduce) {
  *, *::before, *::after { animation-duration: 0.001ms !important; transition-duration: 0.001ms !important; }
}

@media (max-width: 720px) {
  .app-header { flex-wrap: wrap; height: auto; padding: var(--space-3) var(--space-4); gap: var(--space-3); }
  .app-main { padding: var(--space-4); }
  .data-section.two-col { grid-template-columns: 1fr; }
  .monitor-info { grid-template-columns: 1fr; }
}

@media (max-width: 900px) {
  .app-shell {
    flex-direction: row;
    min-width: 0;
  }

  .sidebar {
    position: fixed;
    inset: 0 auto 0 0;
    z-index: 1200;
    width: min(280px, 88vw);
    min-width: min(280px, 88vw);
    height: 100dvh;
    max-height: 100dvh;
    padding: var(--space-4) var(--space-3);
    overflow-x: hidden;
    overflow-y: auto;
    transform: translateX(-105%);
    transition: transform 0.18s ease;
    box-shadow: var(--shadow-lg);
  }

  .sidebar.mobile-nav-open {
    transform: translateX(0);
  }

  .sidebar-brand {
    padding: 0 var(--space-2) var(--space-4);
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }

  .mobile-nav-close {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    min-width: 36px;
    height: 36px;
    min-height: 36px;
    padding: 0;
    border: 1px solid rgba(255, 255, 255, 0.16);
    color: #fff;
    background: transparent;
    font-size: 1.5rem;
    line-height: 1;
  }

  .mobile-nav-close:hover {
    color: #fff;
    background: rgba(255, 255, 255, 0.08);
  }

  .sidebar-nav {
    flex-direction: column;
    gap: var(--space-5);
    overflow: visible;
  }

  .sidebar-group {
    flex-direction: column;
    align-items: stretch;
    gap: var(--space-1);
  }

  .sidebar-group-label {
    display: block;
  }

  .sidebar-group a {
    white-space: normal;
  }

  .sidebar-footer {
    flex-direction: column;
    align-items: stretch;
    justify-content: initial;
    gap: var(--space-2);
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    padding-top: var(--space-4);
  }

  .mobile-nav-toolbar {
    display: flex;
    align-items: center;
    min-height: 52px;
    padding: var(--space-2) var(--space-3);
    border-bottom: 1px solid var(--border);
    background: var(--surface);
  }

  .mobile-nav-toggle {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-height: 40px;
    padding: 0.5rem 0.75rem;
    font-weight: 600;
  }

  .mobile-nav-toggle-icon {
    font-size: 1.1rem;
    line-height: 1;
  }

  .mobile-nav-backdrop {
    position: fixed;
    inset: 0;
    z-index: 1100;
    display: block;
    width: 100%;
    height: 100%;
    border: 0;
    padding: 0;
    background: rgba(18, 21, 28, 0.55);
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.18s ease;
    cursor: default;
  }

  .mobile-nav-backdrop.mobile-nav-backdrop-open {
    opacity: 1;
    pointer-events: auto;
  }

  .app-content {
    width: 100%;
    min-width: 0;
  }

  .app-main {
    padding: var(--space-4);
    min-width: 0;
  }
}

@media (max-width: 600px) {
  .app-main {
    padding: var(--space-5) var(--space-3);
  }
}

@media (max-width: 375px) {
  .mobile-nav-toolbar {
    padding-inline: var(--space-2);
  }

  .metric-strip {
    grid-template-columns: 1fr;
  }
}

@media (max-width: 720px) {
  .feature-grid { grid-template-columns: 1fr; }
  .details { grid-template-columns: 1fr; }
  .inline-form { align-items: stretch; flex-direction: column; }
  .inline-form > * { width: 100%; }
}

@media (max-width: 720px) {
  .page-header-actions { width: 100%; }
  .page-header-actions > .btn, .page-header-actions > a { width: 100%; }
  .date-range-picker { grid-template-columns: 1fr; }
  .toast { right: var(--space-4); bottom: var(--space-4); }
}

@media (max-width: 1100px) {
  .dashboard-trend-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
}

@media (max-width: 900px) {
  .metric-strip {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  .dashboard-trend-grid {
    grid-template-columns: 1fr;
  }
}

@media (max-width: 600px) {
  .app-main {
    padding: var(--space-5) var(--space-3);
  }

  .dashboard-page-header {
    align-items: flex-start;
  }

  .dashboard-page-header h1 {
    font-size: 1.5rem;
  }

  .metric-strip {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .metric-card {
    min-height: 104px;
  }
}

@media (max-width: 375px) {
  .metric-strip {
    grid-template-columns: 1fr;
  }

  .dashboard-page-header {
    flex-direction: column;
    align-items: stretch;
  }

  .dashboard-page-header .btn {
    width: 100%;
  }

  .dashboard-trend-card {
    padding: var(--space-3);
  }
}

@media (max-width: 640px) {
  .monitor-identity { align-items: flex-start; flex-direction: column; }
  .performance-row { grid-template-columns: 22px 1fr 62px; }
  .channel-form { align-items: stretch; }
  .channel-form input, .channel-form select { width: 100%; }
}

@media (max-width: 640px) {
  .row-actions {
    justify-content: flex-start;
  }
}

@media (prefers-reduced-motion: reduce) {
  .network-status-dot {
    animation: none;
  }
}

@media (max-width: 720px) {
button, :is(.btn), .sidebar-group a, :is(.sidebar-signout), :is(.icon-button) {
    min-height: 44px;
  }

  .dialog-actions {
    justify-content: stretch;
  }

  .dialog-actions > * {
    flex: 1 1 140px;
  }
}

@media (max-width: 900px) {
  .proxy-summary { grid-template-columns: repeat(2, minmax(130px, 1fr)); }
  .proxy-progress-stats { grid-template-columns: repeat(2, 1fr); }
}

@media (max-width: 480px) {
  .auth-shell { padding: 16px; align-items: flex-start; }
  .auth-card { margin-top: 5vh; padding: 28px 20px; }
}

@media (prefers-reduced-motion: reduce) {
  html { scroll-behavior: auto; }
}

@media (max-width: 1100px) {
  .sidebar {
    width: 248px;
    min-width: 248px;
  }

  .app-main {
    padding-inline: 22px;
  }

  .metric-strip {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }
}

@media (max-width: 900px) {
  .sidebar {
    width: min(292px, 88vw);
    min-width: min(292px, 88vw);
    box-shadow: 16px 0 44px rgba(15,23,42,.25);
  }

  .app-main {
    width: 100%;
    padding: 22px 18px 36px;
  }

  .mobile-nav-toolbar {
    display: flex;
    min-height: 58px;
    padding: 9px 14px;
    border-bottom-color: var(--border);
    background: rgba(255,255,255,.92);
    box-shadow: 0 1px 8px rgba(15,23,42,.04);
  }

  .mobile-nav-toggle {
    min-height: 40px;
    border-radius: 9px;
  }

  .metric-strip {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .feature-grid {
    grid-template-columns: 1fr;
  }
}

@media (max-width: 640px) {
  .app-main {
    padding: 16px 12px 28px;
  }

  .page-header,
  .dashboard-page-header {
    align-items: flex-start;
    padding: 18px;
    border-radius: 14px;
  }

  .page-header {
    flex-direction: column;
  }

  .page-header > *,
  .dashboard-page-header > * {
    max-width: 100%;
  }

  .page-header .btn,
  .page-header > a.btn,
  .dashboard-page-header .btn {
    width: 100%;
  }

  .metric-strip {
    grid-template-columns: 1fr 1fr;
  }

  .metric-card {
    min-height: 112px;
    padding: 15px;
  }

  .data-section,
  .card {
    padding: 16px;
  }

  .section-heading {
    align-items: flex-start;
  }

  .section-heading > a {
    white-space: nowrap;
  }

  .inline-form,
  .row-actions,
  .proxy-actions,
  .proxy-export-actions {
    align-items: stretch;
  }

  .inline-form > *,
  .proxy-actions > .btn {
    width: 100%;
  }

  .proxy-summary {
    grid-template-columns: 1fr 1fr;
  }

  .proxy-progress-stats {
    grid-template-columns: 1fr 1fr;
  }

  .details {
    grid-template-columns: 1fr;
  }

  .dashboard-trend-card {
    min-height: 210px;
  }
}

@media (max-width: 390px) {
  .metric-strip,
  .proxy-summary {
    grid-template-columns: 1fr;
  }

  .metric-card {
    min-height: 104px;
  }
}

@media (min-width: 901px) {
  .mobile-nav-toolbar {
    display: none;
  }
}

@media (prefers-reduced-motion: reduce) {
  *,
  *::before,
  *::after {
    scroll-behavior: auto !important;
    animation-duration: 0.001ms !important;
    transition-duration: 0.001ms !important;
  }
}

/* ========================================================================
   PINGVERTEX PREMIUM UI
   Global redesign for the complete Leptos frontend.
   ======================================================================== */

:root {
  --pv-bg: #f6f7fb;
  --pv-surface: #ffffff;
  --pv-surface-soft: #fafbff;

  --pv-border: #e7e9f0;
  --pv-border-strong: #d9dce7;

  --pv-text: #111827;
  --pv-muted: #667085;
  --pv-faint: #98a2b3;

  --pv-primary: #5b5cf0;
  --pv-primary-2: #4648d9;
  --pv-primary-soft: #f0f0ff;

  --pv-success: #12a56a;
  --pv-success-soft: #eaf9f2;

  --pv-danger: #e5484d;
  --pv-danger-soft: #fff0f1;

  --pv-warning: #d98b19;
  --pv-warning-soft: #fff7e8;

  --pv-radius: 14px;
  --pv-radius-sm: 10px;

  --pv-shadow:
    0 1px 2px rgba(16,24,40,.03),
    0 10px 28px rgba(16,24,40,.045);

  --pv-shadow-hover:
    0 8px 30px rgba(16,24,40,.08);
}


/* ========================================================================
   BASE
   ======================================================================== */

html,
body {
  background: var(--pv-bg);
}

body {
  color: var(--pv-text);
  font-size: 14px;

  background:
    radial-gradient(
      circle at 85% -10%,
      rgba(91,92,240,.07),
      transparent 28rem
    ),
    var(--pv-bg);
}


/* ========================================================================
   APP SHELL
   ======================================================================== */

.app-shell {
  min-height: 100vh;
}

.app-content {
  min-width: 0;
}

.app-main {
  width: 100%;
  max-width: 1480px;

  padding:
    30px
    clamp(20px, 3vw, 42px)
    52px;
}


/* ========================================================================
   SIDEBAR
   ======================================================================== */

.sidebar {
  width: 252px;
  min-width: 252px;

  padding: 16px 12px 14px;

  gap: 14px;

  background:
    radial-gradient(
      circle at 15% 0%,
      rgba(91,92,240,.18),
      transparent 20rem
    ),
    linear-gradient(
      180deg,
      #0d1224 0%,
      #090e1b 100%
    );

  border-right:
    1px solid rgba(255,255,255,.075);

  box-shadow:
    12px 0 36px rgba(9,14,27,.07);
}

.sidebar-brand {
  min-height: 58px;

  padding:
    4px
    7px
    14px;

  border-bottom-color:
    rgba(255,255,255,.08);
}

.brand-link {
  display: inline-flex;
  align-items: center;

  gap: 10px;

  min-width: 0;

  color: #fff !important;

  text-decoration: none !important;
}

.brand-mark {
  width: 38px;
  height: 38px;

  flex: 0 0 38px;

  color: #8f95ac;

  filter:
    drop-shadow(
      0 6px 16px
      rgba(91,92,240,.25)
    );
}

.brand-copy {
  display: flex;
  flex-direction: column;

  min-width: 0;

  line-height: 1;
}

.brand-copy strong {
  color: #fff;

  font-size: 1.02rem;
  font-weight: 750;

  letter-spacing: -.035em;
}

.brand-copy small {
  margin-top: 5px;

  color:
    rgba(255,255,255,.36);

  font-size: .48rem;
  font-weight: 800;

  letter-spacing: .16em;
}

.sidebar-brand a::before,
.sidebar-brand a::after {
  content: none !important;
}

.sidebar-live {
  display: flex;
  align-items: center;

  gap: 8px;

  margin: 0 4px;

  padding: 9px 10px;

  border:
    1px solid
    rgba(255,255,255,.075);

  border-radius: 10px;

  color:
    rgba(255,255,255,.62);

  background:
    rgba(255,255,255,.035);

  font-size: .68rem;
  font-weight: 600;
}

.live-dot {
  width: 7px;
  height: 7px;

  border-radius: 50%;

  background: #29c986;

  box-shadow:
    0 0 0 4px rgba(41,201,134,.12),
    0 0 14px rgba(41,201,134,.35);
}

.sidebar-nav {
  gap: 18px;
  padding: 0 1px;
}

.sidebar-group {
  gap: 3px;
}

.sidebar-group-label {
  margin:
    0
    9px
    6px;

  padding: 0;

  color:
    rgba(255,255,255,.32);

  font-size: .58rem;
  font-weight: 750;

  letter-spacing: .15em;
}

.sidebar-group a {
  min-height: 38px;

  padding:
    8px
    10px;

  border-radius: 9px;

  color:
    rgba(255,255,255,.61);

  font-size: .78rem;
  font-weight: 550;

  transition:
    transform 140ms ease,
    background 140ms ease,
    color 140ms ease,
    border-color 140ms ease;
}

.sidebar-group a::before {
  width: 18px;
  flex: 0 0 18px;

  color:
    rgba(255,255,255,.32);

  font-size: .8rem;
}

.sidebar-group a:hover {
  color: #fff;

  background:
    rgba(255,255,255,.055);

  border-color:
    rgba(255,255,255,.055);

  transform: translateX(1px);
}

.sidebar-group a.active {
  color: #fff;

  background:
    linear-gradient(
      100deg,
      rgba(91,92,240,.98),
      rgba(75,77,211,.88)
    );

  border-color:
    rgba(145,147,255,.28);

  box-shadow:
    0 8px 22px
    rgba(79,70,229,.22);
}

.sidebar-footer {
  padding:
    12px
    3px
    0;

  gap: 8px;
}

.sidebar-user {
  display: flex;
  align-items: center;

  gap: 9px;

  padding: 9px;

  border-color:
    rgba(255,255,255,.08);

  border-radius: 11px;

  background:
    rgba(255,255,255,.035);
}

.sidebar-avatar {
  display: grid;
  place-items: center;

  width: 32px;
  height: 32px;

  flex: 0 0 32px;

  border-radius: 50%;

  color: #fff;

  background:
    linear-gradient(
      135deg,
      #7073ff,
      #4b4dd7
    );

  font-size: .72rem;
  font-weight: 800;
}

.sidebar-user-meta {
  display: flex;
  flex-direction: column;

  min-width: 0;

  line-height: 1.25;
}

.sidebar-user-meta strong {
  overflow: hidden;

  color:
    rgba(255,255,255,.88);

  font-size: .69rem;
  font-weight: 700;

  text-overflow: ellipsis;
  white-space: nowrap;
}

.sidebar-user-meta small {
  overflow: hidden;

  margin-top: 3px;

  color:
    rgba(255,255,255,.35);

  font-size: .57rem;

  text-overflow: ellipsis;
  white-space: nowrap;
}

.sidebar-signout {
  display: flex;
  align-items: center;

  gap: 8px;

  min-height: 36px;

  color:
    rgba(255,255,255,.46);

  font-size: .7rem;
}


/* ========================================================================
   TOP BAR
   ======================================================================== */

.topbar {
  position: sticky;
  top: 0;

  z-index: 15;

  display: flex;
  align-items: center;

  gap: 18px;

  min-height: 62px;

  padding:
    10px
    clamp(18px, 3vw, 40px);

  border-bottom:
    1px solid
    rgba(228,231,238,.88);

  background:
    rgba(255,255,255,.86);

  backdrop-filter: blur(18px);
  -webkit-backdrop-filter: blur(18px);
}

.topbar-search {
  display: flex;
  align-items: center;

  gap: 9px;

  width: min(520px, 55vw);

  min-height: 38px;

  padding: 0 11px;

  border:
    1px solid
    var(--pv-border);

  border-radius: 10px;

  color: #98a2b3;

  background: #f9fafc;

  font-size: .72rem;
}

.topbar-search-icon {
  color: #667085;
  font-size: 1.05rem;
  line-height: 1;
}

.topbar-search kbd {
  margin-left: auto;

  padding:
    3px
    6px;

  border:
    1px solid
    #e1e4eb;

  border-radius: 5px;

  color: #98a2b3;

  background: #fff;

  font-size: .58rem;

  font-family:
    var(--font-mono);
}

.topbar-actions {
  display: flex;
  align-items: center;

  gap: 8px;

  margin-left: auto;
}

.topbar-icon {
  display: grid;
  place-items: center;

  width: 36px;
  height: 36px;

  padding: 0;

  border:
    1px solid
    transparent;

  border-radius: 9px;

  color: #667085;

  background: transparent;

  font-size: .95rem;
}

.topbar-icon:hover {
  color: var(--pv-text);

  background: #f5f6fa;

  border-color:
    var(--pv-border);
}

.topbar-workspace {
  display: flex;
  align-items: center;

  gap: 8px;

  min-height: 38px;

  margin-left: 4px;

  padding:
    4px
    9px
    4px
    5px;

  border:
    1px solid
    var(--pv-border);

  border-radius: 10px;

  background: #fff;

  color: #475467;

  font-size: .69rem;
  font-weight: 650;
}

.workspace-avatar {
  display: grid;
  place-items: center;

  width: 28px;
  height: 28px;

  border-radius: 8px;

  color: #fff;

  background:
    linear-gradient(
      135deg,
      #6869f4,
      #4b4dd7
    );

  font-size: .7rem;
  font-weight: 800;
}

.workspace-name {
  max-width: 150px;

  overflow: hidden;

  text-overflow: ellipsis;
  white-space: nowrap;
}

.mobile-nav-toolbar {
  display: none;
}


/* ========================================================================
   PAGE HEADERS
   ======================================================================== */

.page-header,
.dashboard-page-header {
  margin-bottom: 22px;

  padding:
    24px
    26px;

  border:
    1px solid
    var(--pv-border);

  border-radius: 16px;

  background:
    radial-gradient(
      circle at 92% 5%,
      rgba(91,92,240,.09),
      transparent 15rem
    ),
    linear-gradient(
      135deg,
      #fff 0%,
      #fbfbff 100%
    );

  box-shadow: var(--pv-shadow);
}

.page-header h1,
.dashboard-page-header h1 {
  color: #101828;

  font-size:
    clamp(
      1.55rem,
      2.2vw,
      2.05rem
    );

  font-weight: 760;

  letter-spacing: -.045em;
}

.eyebrow {
  color: #7b80ef;

  font-size: .59rem;
  font-weight: 800;

  letter-spacing: .14em;
}


/* ========================================================================
   BUTTONS
   ======================================================================== */

button,
:is(.btn) {
  min-height: 38px;

  padding:
    .55rem
    .9rem;

  border:
    1px solid
    var(--pv-border-strong);

  border-radius: 9px;

  color: #344054;

  background: #fff;

  font-size: .76rem;
  font-weight: 650;

  box-shadow:
    0 1px 1px
    rgba(16,24,40,.02);

  transition:
    transform 140ms ease,
    box-shadow 140ms ease,
    background 140ms ease,
    border-color 140ms ease;
}

button:hover,
.btn:hover {
  background: #f9fafb;

  border-color:
    #cfd4df;

  box-shadow:
    0 4px 12px
    rgba(16,24,40,.06);

  transform: translateY(-1px);
}

button:active,
.btn:active {
  transform: translateY(0);
}

.btn-primary {
  color: #fff !important;

  border-color:
    var(--pv-primary) !important;

  background:
    linear-gradient(
      135deg,
      #6366f1,
      #4f46e5
    ) !important;

  box-shadow:
    0 7px 18px
    rgba(79,70,229,.2);
}

.btn-primary:hover {
  border-color:
    var(--pv-primary-2) !important;

  background:
    linear-gradient(
      135deg,
      #5d5ff0,
      #4338ca
    ) !important;

  box-shadow:
    0 9px 22px
    rgba(79,70,229,.25);
}


/* ========================================================================
   CARDS
   ======================================================================== */

.card,
.data-section,
.skeleton-card,
.dashboard-widget {
  border:
    1px solid
    var(--pv-border);

  border-radius:
    var(--pv-radius);

  background:
    var(--pv-surface);

  box-shadow:
    var(--pv-shadow);
}

.card {
  padding: 20px;
}

.card:hover {
  box-shadow:
    var(--pv-shadow-hover);
}


/* ========================================================================
   METRICS
   ======================================================================== */

.metric-strip {
  gap: 14px;
}

.metric-card {
  position: relative;

  min-height: 138px;

  padding:
    18px
    18px
    16px;

  overflow: hidden;

  gap: 6px;
}

.metric-card::before {
  position: absolute;

  top: 0;
  left: 0;

  width: 100%;
  height: 3px;

  border-radius: 99px;

  background: #d8dce7;
}

.metric-card:nth-child(1)::before {
  background: #6366f1;
}

.metric-card:nth-child(2)::before {
  background: #16a36b;
}

.metric-card:nth-child(3)::before {
  background: #e5484d;
}

.metric-card:nth-child(4)::before {
  background: #98a2b3;
}

.metric-card:nth-child(5)::before {
  background: #d98b19;
}

.metric-card.metric-primary {
  background:
    linear-gradient(
      145deg,
      #fff,
      #f8f8ff
    );

  border-color:
    #dddfff;
}

.card-label {
  color: #667085;

  font-size: .65rem;
  font-weight: 750;

  letter-spacing: .04em;

  text-transform: uppercase;
}

.card-value {
  margin-top: 2px;

  color: #101828;

  font-size: 2rem;
  font-weight: 760;

  letter-spacing: -.055em;
}

.card-value.up {
  color: var(--pv-success);
}

.card-value.down {
  color: var(--pv-danger);
}

.card-hint {
  color: #98a2b3;
  font-size: .66rem;
}


/* ========================================================================
   DASHBOARD
   ======================================================================== */

.dashboard-overview {
  gap: 22px;
}

.dashboard-page-header {
  display: flex;
  align-items: center;
  justify-content: space-between;

  min-height: 112px;
}

.dashboard-content {
  gap: 22px;
}

.dashboard-section {
  gap: 12px;
}

.section-heading,
.widget-heading {
  align-items: center;
}

.section-heading h2,
.widget-heading h2 {
  color: #101828;

  font-size: .95rem;
  font-weight: 740;
}

.dashboard-trend-grid {
  grid-template-columns:
    repeat(
      3,
      minmax(0, 1fr)
    );

  gap: 14px;
}

.dashboard-trend-card {
  min-height: 250px;

  padding: 18px;

  overflow: hidden;
}

.trend-value {
  color: #101828;

  font-size: 1.05rem;
  font-weight: 760;
}

.trend-chart-wrap {
  margin-top: 16px;

  border: 0;

  border-radius: 10px;

  background:
    linear-gradient(
      180deg,
      rgba(91,92,240,.045),
      rgba(91,92,240,0)
    );
}

.trend-chart {
  height: 132px;

  color:
    var(--pv-primary);
}

.trend-empty {
  min-height: 150px;

  margin-top: 16px;

  border:
    1px dashed
    #d9dce7;

  border-radius: 10px;

  background: #fbfcff;

  color: #667085;
}


/* ========================================================================
   TABLES
   ======================================================================== */

.table-responsive,
.table-scroll,
.monitor-table-wrap {
  width: 100%;

  overflow-x: auto;

  border:
    1px solid
    var(--pv-border);

  border-radius:
    var(--pv-radius);

  background: #fff;

  box-shadow:
    var(--pv-shadow);
}

table,
.data-table,
.dashboard-monitor-table {
  width: 100%;

  border-collapse:
    separate;

  border-spacing: 0;

  border: 0;

  box-shadow: none;

  background: #fff;
}

th,
.data-table th {
  padding:
    11px
    16px;

  border-bottom:
    1px solid
    var(--pv-border);

  color: #98a2b3;

  background: #fafbfc;

  font-size: .59rem;
  font-weight: 800;

  letter-spacing: .075em;

  text-transform: uppercase;
}

td,
.data-table td {
  padding:
    13px
    16px;

  border-bottom:
    1px solid
    #f0f1f5;

  color: #475467;

  font-size: .73rem;
}

tbody tr {
  transition:
    background 120ms ease;
}

tbody tr:hover td {
  background: #fafaff;
}

tbody tr:last-child td {
  border-bottom: 0;
}

.monitor-link {
  color: #101828;
  font-weight: 700;
}

.monitor-link:hover {
  color: var(--pv-primary);
  text-decoration: none;
}

.mono {
  font-variant-numeric: tabular-nums;

  font-family:
    var(--font-mono);

  font-size: .67rem;
}


/* ========================================================================
   STATUS BADGES
   ======================================================================== */

.status-badge {
  min-height: 25px;

  padding:
    4px
    8px;

  gap: 6px;

  border-radius: 999px;

  font-size: .63rem;
  font-weight: 750;
}

.status-badge-dot {
  width: 6px;
  height: 6px;
}

.status-badge-up {
  color: #087f51;

  background: #e9f9f1;

  border-color:
    #cceede;
}

.status-badge-down {
  color: #c9363d;

  background: #fff0f1;

  border-color:
    #f5d2d5;
}

.status-badge-degraded {
  color: #a35f00;

  background: #fff6e5;

  border-color:
    #f3dfb8;
}

.status-badge-unknown,
.status-badge-neutral,
.status-badge-paused {
  color: #667085;

  background: #f1f3f6;

  border-color:
    #e2e5eb;
}


/* ========================================================================
   FORMS
   ======================================================================== */

input,
select,
textarea {
  border:
    1px solid
    var(--pv-border-strong);

  border-radius: 9px;

  color: #101828;

  background: #fff;

  outline: none;

  transition:
    border-color 140ms ease,
    box-shadow 140ms ease;
}

input:focus,
select:focus,
textarea:focus {
  border-color: #8b8df6;

  box-shadow:
    0 0 0 3px
    rgba(91,92,240,.11);
}

input::placeholder,
textarea::placeholder {
  color: #98a2b3;
}

label {
  color: #344054;

  font-size: .7rem;
  font-weight: 700;
}


/* ========================================================================
   ALERTS / EMPTY STATES / LOADING
   ======================================================================== */

.alert,
.toast,
.success,
.error,
.form-error,
.auth-success,
.error-state {
  border-radius: 11px;
}

.empty-state {
  border-color: #d9dce7;

  border-radius: 13px;

  background: #fff;

  box-shadow:
    var(--pv-shadow);
}

.loading-container {
  min-height: 180px;

  color: #667085;
}

.loading-spinner {
  width: 22px;
  height: 22px;

  border-color: #e4e6ee;

  border-top-color:
    var(--pv-primary);
}


/* ========================================================================
   INCIDENTS
   ======================================================================== */

.incident-list {
  overflow: hidden;

  border:
    1px solid
    var(--pv-border);

  border-radius:
    var(--pv-radius);

  background: #fff;

  box-shadow:
    var(--pv-shadow);
}

.incident-row {
  min-height: 62px;

  padding:
    11px
    16px;

  border-bottom:
    1px solid
    #f0f1f5;
}

.incident-row:last-child {
  border-bottom: 0;
}

.incident-link {
  color: #101828;
  font-weight: 700;
}

.incident-link:hover {
  color: var(--pv-primary);
  text-decoration: none;
}


/* ========================================================================
   FOOTER
   ======================================================================== */

.app-footer {
  display: flex;
  justify-content: center;
  align-items: center;

  gap: 7px;

  padding:
    18px
    24px
    24px;

  border-top:
    1px solid
    var(--pv-border);

  color: #98a2b3;

  background:
    rgba(255,255,255,.7);

  font-size: .62rem;
}

.app-footer span:first-child {
  color: #667085;
  font-weight: 750;
}


/* ========================================================================
   RESPONSIVE
   ======================================================================== */

@media (max-width: 1100px) {

  .sidebar {
    width: 232px;
    min-width: 232px;
  }

  .dashboard-trend-grid {
    grid-template-columns:
      repeat(
        2,
        minmax(0, 1fr)
      );
  }

  .metric-strip {
    grid-template-columns:
      repeat(
        3,
        minmax(0, 1fr)
      );
  }

  .topbar-search {
    width:
      min(
        430px,
        48vw
      );
  }
}


@media (max-width: 820px) {

  .sidebar {
    position: fixed;

    inset:
      0
      auto
      0
      0;

    z-index: 60;

    width:
      min(
        286px,
        88vw
      );

    min-width:
      min(
        286px,
        88vw
      );

    transform:
      translateX(-105%);

    transition:
      transform 180ms ease;
  }

  .sidebar.mobile-nav-open {
    transform:
      translateX(0);
  }

  .mobile-nav-toolbar {
    display: flex;
    align-items: center;
  }

  .mobile-nav-toggle {
    display: inline-flex;
    align-items: center;

    gap: 7px;

    min-height: 36px;

    padding:
      0
      10px;
  }

  .mobile-nav-close {
    display: inline-flex;
  }

  .topbar {
    gap: 10px;

    padding-inline:
      14px;
  }

  .topbar-search {
    display: none;
  }

  .topbar-actions {
    margin-left: auto;
  }

  .workspace-name {
    display: none;
  }

  .app-main {
    padding:
      20px
      14px
      36px;
  }
}


@media (max-width: 640px) {

  .dashboard-page-header,
  .page-header {
    align-items: flex-start;

    flex-direction: column;

    padding: 19px;
  }

  .metric-strip {
    grid-template-columns:
      repeat(
        2,
        minmax(0, 1fr)
      );
  }

  .dashboard-trend-grid {
    grid-template-columns: 1fr;
  }

  .dashboard-trend-card {
    min-height: 220px;
  }

  .metric-card {
    min-height: 124px;
  }

  .card-value {
    font-size: 1.7rem;
  }

  .app-footer {
    flex-wrap: wrap;
  }
}


@media (max-width: 430px) {

  .metric-strip {
    grid-template-columns: 1fr;
  }

  .topbar-icon {
    display: none;
  }

  .topbar-workspace {
    margin-left: 0;
  }
}


@media (prefers-reduced-motion: reduce) {

  *,
  *::before,
  *::after {
    scroll-behavior: auto !important;

    transition-duration:
      .01ms !important;

    animation-duration:
      .01ms !important;
  }
}

