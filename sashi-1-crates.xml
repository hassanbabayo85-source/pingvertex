    }

    #[test]
    fn test_json_wildcard_contains_matches() {
        let assertions = vec![make_assertion(
            ResponsePart::Json,
            AssertionOperator::Contains,
            Some("$.items[*].id"),
            Some("42"),
        )];
        let ctx = make_ctx(200, r#"{"items": [{"id": 1}, {"id": 42}, {"id": 7}]}"#);
