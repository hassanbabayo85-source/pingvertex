<file path="crates/api/src/middleware/agent_auth.rs">
use axum::{
    body::Body,
    extract::Request,
    http::{HeaderMap, StatusCode},
    middleware::Next,
    response::Response,
};
use axum_server_mtls::PeerCertificates;
use domain::RegionCode;

#[derive(Clone, Debug)]
pub struct AgentId(pub String);

#[derive(Clone, Debug)]
pub struct AgentRegion(pub RegionCode);

/// Middleware that authenticates internal agent endpoints.
///
/// SEC: this used to also accept a shared `AGENT_SECRET` Bearer token as a
/// fallback whenever `PeerCertificates` was absent, described in a comment
/// as "for tests/legacy". That fallback has been REMOVED ENTIRELY — it was
/// a fully-functional authentication bypass with no cross-check against the
/// requested `{agent_id}` (unlike the mTLS path below), reachable by anyone
/// who obtained the `AGENT_SECRET` value. Even though the specific
/// `main.rs`/`router.rs` wiring at the time meant it wasn't reachable via
/// the plain HTTP listener, "unreachable today because of how three
/// separate things happen to be wired" is not the same guarantee as
/// "cannot happen" — a single future refactor (merging routers, adding a
/// reverse proxy in front of the mTLS port, etc.) would have silently
/// reactivated it. Authentication code should never contain a bypass whose
/// safety depends on infrastructure staying exactly as configured today.
///
/// Identity now comes EXCLUSIVELY from the client certificate's Common Name
/// (CN), injected as a `PeerCertificates` extension by `axum-server-mtls`'s
/// `MtlsAcceptor` after a real mTLS handshake (see `mtls.rs` / the mTLS
/// `axum_server` bound in `main.rs`, which requires every connecting client
/// to present a certificate signed by our internal CA *before* any
/// application code — including this middleware — ever runs). If
/// `PeerCertificates` is missing, this is a hard `UNAUTHORIZED`, full stop
/// — there is no other way to authenticate as an agent.
///
/// Defense-in-depth: the CN is also required to match the `{agent_id}`
/// URL path segment exactly. This isn't needed to establish *whose*
/// certificate was presented — the CN already proves that — but it stops
/// an agent with a valid certificate from acting on another agent's
/// behalf by pointing its URL at a different `{agent_id}`, and it keeps
/// every existing route/handler that reads `AgentId` from the path
/// unchanged.
pub async fn agent_auth(
    headers: HeaderMap,
    mut request: Request<Body>,
    next: Next,
) -> Result<Response, StatusCode> {
    let path = request.uri().path().to_string();
    let segments: Vec<&str> = path.split('/').collect();
    let path_agent_id = segments
        .iter()
        .position(|segment| *segment == "agents")
        .and_then(|idx| segments.get(idx + 1))
        .map(|s| s.to_string())
        .ok_or(StatusCode::UNAUTHORIZED)?;

    // mTLS only — no fallback. See doc comment above for why.
    let peer_certs = request
        .extensions()
        .get::<PeerCertificates>()
        .ok_or(StatusCode::UNAUTHORIZED)?;

    let agent_id = peer_certs
        .leaf_cn()
        .filter(|_| peer_certs.is_present())
        .ok_or(StatusCode::UNAUTHORIZED)?;

    if agent_id != path_agent_id {
        return Err(StatusCode::FORBIDDEN);
    }

    let region_str = headers
        .get("x-agent-region")
        .and_then(|v| v.to_str().ok())
        .ok_or(StatusCode::BAD_REQUEST)?;

    let region = RegionCode::new(region_str).map_err(|_| StatusCode::BAD_REQUEST)?;

    request.extensions_mut().insert(AgentId(agent_id));
    request.extensions_mut().insert(AgentRegion(region));

    Ok(next.run(request).await)
}
</file>

<file path="crates/api/src/middleware/custom_domain_routing.rs">
use axum::{
    body::Body,
    extract::State,
    http::{header::HOST, Request},
    middleware::Next,
    response::{IntoResponse, Response},
};

use crate::{handlers::public_status_page::render_public_status_page, state::AppState};

/// Routes requests whose `Host` header matches a VERIFIED custom domain
/// straight to that status page's public response, regardless of path.
///
/// This is deliberate vhost-style isolation, not just a routing
/// convenience: once a hostname is recognized as an owner's verified
/// custom domain, that hostname serves ONLY the status page — never any
/// other route on this API, including authenticated endpoints. A request
/// to `status.acme.com/api/v1/monitors` gets the status page response
/// too, exactly like `status.acme.com/anything-else` would.
///
/// SECURITY: the lookup below (`find_by_verified_custom_domain`) is a
/// strict allowlist query — it can only ever match a domain whose
/// ownership was independently confirmed by
/// `CustomDomainVerificationWorker` via a live DNS TXT lookup. There is
/// no pattern-matching, wildcard, or prefix/suffix logic here: the `Host`
/// header (with any port stripped) must equal a `Verified` custom domain
/// value exactly. See the SECURITY notes on `find_by_verified_custom_domain`
/// and `StatusPage::verified_custom_domain` for why this must never be
/// loosened.
pub async fn custom_domain_routing(
    State(state): State<AppState>,
    request: Request<Body>,
    next: Next,
) -> Response {
    let hostname = request
        .headers()
        .get(HOST)
        .and_then(|value| value.to_str().ok())
        .map(strip_port);

    let Some(hostname) = hostname else {
        return next.run(request).await;
    };

    // Cheap check before touching the database: a bare hostname (no dot)
    // can never be a customer's custom domain — `CustomDomain` validation
    // requires at least one dot (see `domain::value_objects::CustomDomain`)
    // — so this also naturally skips localhost/IP-address requests during
    // local development without an extra query.
    if !hostname.contains('.') {
        return next.run(request).await;
    }

    match state
        .status_page_repository
        .find_by_verified_custom_domain(&hostname)
        .await
    {
        Ok(Some(status_page)) => render_public_status_page(&state, status_page)
            .await
            .into_response(),
        Ok(None) => next.run(request).await,
        Err(err) => {
            // Fail OPEN to normal routing, never to serving stale/wrong
            // status-page content — a database error here should look
            // like "this host isn't a status page", not risk exposing
            // internal routes or the wrong tenant's data.
            tracing::error!(
                error = %err,
                hostname = %hostname,
                "custom domain lookup failed during host-header routing"
            );
            next.run(request).await
        }
    }
}

/// Strips an optional `:port` suffix from a `Host` header value.
///
/// Deliberately simple: real customer custom domains are always regular
/// DNS hostnames (enforced by `CustomDomain` validation at request time),
/// never raw IPv6 literals, so the naive "everything after the last
/// colon" split is safe here — it only needs to handle `example.com` and
/// `example.com:443`, not `[::1]:8080`.
fn strip_port(host: &str) -> String {
    host.rsplit_once(':')
        .map(|(hostname, _port)| hostname)
        .unwrap_or(host)
        .to_lowercase()
}
</file>

<file path="crates/api/src/middleware/metrics.rs">
use std::time::Instant;

use axum::{body::Body, http::Request, middleware::Next, response::Response};
use metrics::{counter, histogram};

pub async fn record_http_metrics(req: Request<Body>, next: Next) -> Response {
    let method = req.method().as_str().to_owned();
    let path = req.uri().path().to_owned();

    if path == "/metrics" {
        return next.run(req).await;
    }

    let start = Instant::now();
    let response = next.run(req).await;
    let status = response.status().as_u16().to_string();
    let elapsed = start.elapsed().as_secs_f64();

    counter!("http_requests_total",
        "method" => method.clone(),
        "path" => path.clone(),
        "status" => status.clone()
    )
    .increment(1);

    histogram!("http_request_duration_seconds",
        "method" => method,
        "path" => path,
        "status" => status
    )
    .record(elapsed);

    response
}
</file>

