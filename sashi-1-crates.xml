                .map(|color| color.as_str().to_owned()),
            monitor_ids: status_page
                .monitor_ids
                .iter()
                .map(|id| id.0.to_string())
                .collect(),
            created_at: status_page.created_at,
            updated_at: status_page.updated_at,
