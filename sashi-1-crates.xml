    async fn update_last_heartbeat_at(
        &self,
        id: MonitorId,
        now: chrono::DateTime<chrono::Utc>,
    ) -> RepoResult<()> {
        sqlx::query("UPDATE monitors SET last_heartbeat_at = $2, updated_at = $2 WHERE id = $1")
            .bind(id.0)
            .bind(now)
            .execute(&self.pool)
            .await?;

        Ok(())
    }
