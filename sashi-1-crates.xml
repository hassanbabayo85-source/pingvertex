<file path="crates/infra/src/services/s3_logo_storage.rs">
use application::ports::LogoStorage;
use async_trait::async_trait;
use domain::value_objects::LogoImage;
use s3::creds::Credentials;
use s3::{Bucket, Region};
use std::error::Error;
use uuid::Uuid;

use crate::s3_config::{S3Config, S3ConfigError};

/// S3-compatible object storage implementation of [`LogoStorage`].
///
/// Uses `rust-s3` with a rustls-only HTTP client. Object keys are random
/// UUIDs, so an attacker cannot predict/overwrite another status page's
/// logo; file extension is chosen from the magic-byte detection performed
/// in `LogoImage`, never from client-supplied content.
#[derive(Clone)]
pub struct S3LogoStorage {
    bucket: Box<Bucket>,
    public_base_url: String,
}

impl S3LogoStorage {
    pub fn try_from_env() -> Result<Self, S3ConfigError> {
        let config = S3Config::try_from_env()?;
        Self::new(config)
    }

    pub fn new(config: S3Config) -> Result<Self, S3ConfigError> {
        let region = match config.endpoint {
            Some(endpoint) => Region::Custom {
                region: config.region.clone(),
                endpoint,
            },
            None => config
                .region
                .parse::<Region>()
                .map_err(|_| S3ConfigError::InvalidS3Region(config.region.clone()))?,
        };

        let credentials = Credentials::new(
            Some(&config.access_key_id),
            Some(&config.secret_access_key),
            None,
            None,
            None,
        )
        .map_err(|err| S3ConfigError::S3ClientError(err.to_string()))?;

        let bucket = Bucket::new(&config.bucket, region, credentials)
            .map_err(|err| S3ConfigError::S3ClientError(err.to_string()))?;

        let bucket = if config.path_style {
            bucket.with_path_style()
        } else {
            bucket
        };

        Ok(Self {
            bucket,
            public_base_url: config.public_base_url,
        })
    }

    fn object_key(logo: &LogoImage) -> String {
        format!(
            "logos/{}.{}",
            Uuid::new_v4().simple(),
            logo.file_extension()
        )
    }
}

#[async_trait]
impl LogoStorage for S3LogoStorage {
    async fn store_logo(&self, logo: &LogoImage) -> Result<String, Box<dyn Error + Send + Sync>> {
        let key = Self::object_key(logo);

        self.bucket
            .put_object_with_content_type(key.as_str(), logo.data(), logo.content_type())
            .await?;

        Ok(format!("{}/{}", self.public_base_url, key))
    }
}
</file>

<file path="crates/infra/src/services/smtp_email_notification_service.rs">
use application::ports::{NotificationService, NotifyResult};
use async_trait::async_trait;
use domain::{
    entities::NotificationChannel, enums::NotificationChannelKind, notification::NotificationEvent,
};
use lettre::{
    AsyncSmtpTransport, AsyncTransport, Message, Tokio1Executor, message::Mailbox,
    transport::smtp::authentication::Credentials,
};

use crate::config::SmtpConfig;

/// Sends monitor lifecycle notifications by email over SMTP.
///
/// Built once at startup from `SmtpConfig` (see
/// `NotificationDispatcher::from_env`) and reused for every send — `lettre`'s
/// `AsyncSmtpTransport` internally pools connections, so there's no need to
/// reconnect per email.
pub struct SmtpEmailNotificationService {
    mailer: AsyncSmtpTransport<Tokio1Executor>,
    from: Mailbox,
}

impl SmtpEmailNotificationService {
    pub fn new(config: SmtpConfig) -> Result<Self, Box<dyn std::error::Error + Send + Sync>> {
        let credentials = Credentials::new(config.username.clone(), config.password.clone());

        let builder = if config.starttls {
            AsyncSmtpTransport::<Tokio1Executor>::starttls_relay(&config.host)?
        } else {
            AsyncSmtpTransport::<Tokio1Executor>::relay(&config.host)?
        };

        let mailer = builder.port(config.port).credentials(credentials).build();

        let from: Mailbox = match &config.from_name {
            Some(name) if !name.is_empty() => {
                format!("{name} <{}>", config.from_address).parse()?
            }
            _ => config.from_address.parse()?,
        };

        Ok(Self { mailer, from })
    }
}

fn email_subject_and_body(event: &NotificationEvent) -> (String, String) {
    match event {
        NotificationEvent::MonitorDown(monitor) => (
            format!("🔴 {} is DOWN", monitor.name.as_str()),
            format!(
                "Your monitor \"{}\" ({}) stopped responding as expected and has been marked DOWN.\n\n\
                 We'll send another email as soon as it recovers.",
                monitor.name.as_str(),
                monitor.url.as_str()
            ),
        ),
        NotificationEvent::MonitorRecovered(monitor) => (
            format!("✅ {} has recovered", monitor.name.as_str()),
            format!(
                "Good news — your monitor \"{}\" ({}) is responding normally again.",
                monitor.name.as_str(),
                monitor.url.as_str()
            ),
        ),
        NotificationEvent::Test(monitor) => (
            format!("🔔 Test notification for {}", monitor.name.as_str()),
            format!(
                "This is a test notification for monitor \"{}\" ({}).\n\n\
                 If you received this, this email channel is configured correctly. \
                 No action is needed.",
                monitor.name.as_str(),
                monitor.url.as_str()
            ),
        ),
    }
}

#[async_trait]
impl NotificationService for SmtpEmailNotificationService {
    async fn notify(
        &self,
        channel: &NotificationChannel,
        event: &NotificationEvent,
    ) -> NotifyResult {
        if channel.kind != NotificationChannelKind::Email {
            return Err(format!(
                "SmtpEmailNotificationService received a non-email channel (kind: {})",
                channel.kind
            )
            .into());
        }

        let to: Mailbox = channel.target.parse().map_err(|err| {
            format!(
                "invalid recipient email address '{}': {err}",
                channel.target
            )
        })?;

        let (subject, body) = email_subject_and_body(event);

        let email = Message::builder()
            .from(self.from.clone())
            .to(to)
            .subject(subject)
            .body(body)?;

        self.mailer.send(email).await?;

        Ok(())
    }
}

/// Stand-in `NotificationService` used when SMTP isn't configured for this
/// deployment (see `SmtpConfig::try_from_env`).
///
/// Deliberately fails LOUDLY the moment an email channel is actually
/// triggered (rather than silently no-op'ing like `NoopNotificationService`),
/// with a message that tells whoever's looking at the logs exactly which
/// environment variables to set. This keeps webhook-only deployments fully
/// functional at startup while still surfacing a clear, actionable error
/// on every email attempt until SMTP is configured.
#[derive(Debug, Clone)]
pub struct DisabledEmailNotificationService {
    reason: String,
}

impl DisabledEmailNotificationService {
    pub fn new(reason: impl Into<String>) -> Self {
        Self {
            reason: reason.into(),
        }
    }
}

#[async_trait]
impl NotificationService for DisabledEmailNotificationService {
    async fn notify(
        &self,
        _channel: &NotificationChannel,
        _event: &NotificationEvent,
    ) -> NotifyResult {
        Err(format!("email notifications are not configured: {}", self.reason).into())
    }
}
</file>

<file path="crates/infra/src/services/webhook_notification_service.rs">
use std::time::Duration;

use application::ports::{NotificationService, NotifyResult};
use async_trait::async_trait;
use domain::{
    entities::NotificationChannel, enums::NotificationChannelKind, notification::NotificationEvent,
};
use hmac::{Hmac, Mac};
use serde::Serialize;
use sha2::Sha256;
use tracing::warn;

type HmacSha256 = Hmac<Sha256>;

/// Per-attempt network timeout. Keeps one slow/hanging third-party
/// endpoint from tying up a worker task indefinitely.
const WEBHOOK_TIMEOUT: Duration = Duration::from_secs(8);

/// Total attempts (1 initial + up to 2 retries) for a transient failure
/// (network error, non-2xx response, timeout).
const WEBHOOK_MAX_ATTEMPTS: u32 = 3;

/// Base for exponential backoff between retries: 500ms, then 1000ms.
const WEBHOOK_BACKOFF_BASE_MS: u64 = 500;

/// Sends monitor lifecycle notifications as signed HTTP POST requests to a
/// user-supplied URL — the mechanism that lets someone wire this project up
/// to Slack/Discord/PagerDuty/their own endpoint via an incoming webhook.
///
/// Holds the shared `SecretCipher` (same AES-256-GCM cipher used for
/// Telegram bot tokens / SMS credentials) so it can decrypt
/// `channel.encrypted_secret` at send time — new channels persist the HMAC
/// signing secret encrypted at rest rather than in the plaintext
/// `signing_secret` column (see `CreateNotificationChannelUseCase`). Cheap
/// to construct and safe to share across the whole app behind one `Arc`.
#[derive(Clone)]
pub struct WebhookNotificationService {
    cipher: std::sync::Arc<dyn application::ports::SecretCipher>,
}

impl WebhookNotificationService {
    pub fn new(cipher: std::sync::Arc<dyn application::ports::SecretCipher>) -> Self {
        Self { cipher }
    }

    /// Resolves the plaintext HMAC signing secret for a webhook channel.
    ///
    /// Prefers the encrypted secret (new channels, and any legacy channel
    /// that has since been rotated). Falls back to the legacy plaintext
    /// `signing_secret` column so channels created before encryption was
    /// added keep working without a forced migration — rotating a channel
    /// (delete + recreate) moves it onto encrypted storage.
    fn resolve_secret(&self, channel: &NotificationChannel) -> Result<String, String> {
        if let Some(encrypted) = channel.encrypted_secret.as_ref() {
            let bytes = self
                .cipher
                .decrypt_bytes(encrypted)
                .map_err(|err| format!("failed to decrypt webhook signing secret: {err}"))?;
            return String::from_utf8(bytes)
                .map_err(|_| "decrypted webhook signing secret is not valid UTF-8".to_string());
        }

        channel
            .signing_secret
            .clone()
            .ok_or_else(|| "webhook channel is missing a signing secret".to_string())
    }
}

#[derive(Debug, Serialize)]
struct WebhookPayload<'a> {
    event: &'a str,
    monitor_id: String,
    monitor_name: &'a str,
    monitor_url: &'a str,
    message: String,
}

fn payload_for(event: &NotificationEvent) -> WebhookPayload<'_> {
    let monitor = event.monitor();

    let (event_name, message) = match event {
        NotificationEvent::MonitorDown(monitor) => {
            ("monitor.down", format!("{} is down", monitor.name.as_str()))
        }
        NotificationEvent::MonitorRecovered(monitor) => (
            "monitor.recovered",
            format!("{} has recovered", monitor.name.as_str()),
        ),
        NotificationEvent::Test(monitor) => (
            "notification.test",
            format!("Test notification for {}", monitor.name.as_str()),
        ),
    };

    WebhookPayload {
        event: event_name,
        monitor_id: monitor.id.to_string(),
        monitor_name: monitor.name.as_str(),
        monitor_url: monitor.url.as_str(),
        message,
    }
}

#[async_trait]
impl NotificationService for WebhookNotificationService {
    async fn notify(
        &self,
        channel: &NotificationChannel,
        event: &NotificationEvent,
    ) -> NotifyResult {
        if channel.kind != NotificationChannelKind::Webhook {
            return Err(format!(
                "WebhookNotificationService received a non-webhook channel (kind: {})",
                channel.kind
            )
            .into());
        }

        let secret = self.resolve_secret(channel)?;

        let payload = payload_for(event);
        let body = serde_json::to_vec(&payload)?;

        let mut mac = HmacSha256::new_from_slice(secret.as_bytes())
            .map_err(|err| format!("invalid webhook signing secret: {err}"))?;
        mac.update(&body);
        let signature = hex::encode(mac.finalize().into_bytes());

        let mut last_error: Option<Box<dyn std::error::Error + Send + Sync>> = None;

        for attempt in 0..WEBHOOK_MAX_ATTEMPTS {
            if attempt > 0 {
                let backoff_ms = WEBHOOK_BACKOFF_BASE_MS * 2u64.pow(attempt - 1);
                tokio::time::sleep(Duration::from_millis(backoff_ms)).await;
            }

            match send_once(&channel.target, &body, &signature).await {
                Ok(()) => return Ok(()),
                Err(err) => {
                    warn!(
                        url = %channel.target,
                        attempt = attempt + 1,
                        max_attempts = WEBHOOK_MAX_ATTEMPTS,
                        error = %err,
                        "webhook notification attempt failed"
                    );
                    last_error = Some(err);
                }
            }
        }

        Err(last_error
            .unwrap_or_else(|| "webhook notification failed for an unknown reason".into()))
    }
}

/// Sends a single signed webhook POST.
///
/// Re-resolves and re-validates the destination via `shared::ssrf` on
/// EVERY call — including every retry — never just once up front. This is
/// what closes the DNS-rebinding gap: a URL that resolved to a public IP
/// when the channel was created (or on a previous retry) could have its
/// DNS record repointed at an internal address by the time this call
/// fires. Re-checking on every attempt, using the same
/// `resolve_and_validate_destination` the worker's monitor checker uses,
/// means that repointed address is caught here too, not just once.
async fn send_once(
    url: &str,
    body: &[u8],
    signature: &str,
) -> Result<(), Box<dyn std::error::Error + Send + Sync>> {
    let destination = shared::ssrf::resolve_and_validate_destination(url).await?;

    let client = reqwest::Client::builder()
        .redirect(reqwest::redirect::Policy::none())
        .resolve(&destination.host, destination.socket_addr)
        .timeout(WEBHOOK_TIMEOUT)
        .build()?;

    let response = client
        .post(destination.url)
        .header("Content-Type", "application/json")
        .header("X-Webhook-Signature", format!("sha256={signature}"))
        .body(body.to_vec())
        .send()
        .await?;

    if !response.status().is_success() {
        return Err(format!(
            "webhook endpoint responded with status {}",
            response.status()
        )
        .into());
    }

    Ok(())
}
