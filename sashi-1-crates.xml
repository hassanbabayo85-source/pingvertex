<file path="crates/application/src/use_cases/submit_proxy_check_job.rs">
use std::{error::Error, fmt, sync::Arc};

use chrono::Utc;
use serde_json::json;

use crate::{
    dto::CreateProxyCheckJobRequest,
    ports::{AuditLogEntryRepository, IdGenerator, ProxyCheckJobRepository},
};
use domain::shared::policies::OwnershipPolicy;
use domain::shared::types::AuthenticatedUser;
use domain::{
    AuditAction, AuditLogEntry, AuditLogEntryId, DomainError, ProxyCheckJob, ProxyCredentials,
    ProxyEntry, ProxyHost,
};

pub const MAX_JOBS_PER_USER_PER_DAY: usize = 5;

#[derive(Debug)]
pub enum SubmitProxyCheckJobError {
    QuotaExceeded { limit: usize },
    InvalidInput(String),
    DomainError(DomainError),
    RepoError(Box<dyn Error + Send + Sync>),
}

impl fmt::Display for SubmitProxyCheckJobError {
    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
        match self {
            Self::QuotaExceeded { limit } => write!(
                f,
                "daily proxy check job limit reached: at most {limit} jobs may be submitted per day"
            ),
            Self::InvalidInput(msg) => write!(f, "invalid input: {msg}"),
            Self::DomainError(err) => write!(f, "{err}"),
            Self::RepoError(err) => write!(f, "{err}"),
        }
    }
}

impl Error for SubmitProxyCheckJobError {
    fn source(&self) -> Option<&(dyn Error + 'static)> {
        match self {
            Self::QuotaExceeded { .. } => None,
            Self::InvalidInput(_) => None,
            Self::DomainError(err) => Some(err),
            Self::RepoError(err) => Some(err.as_ref()),
        }
    }
}

pub struct SubmitProxyCheckJobUseCase<R, G> {
    repository: R,
    id_generator: G,
    audit_log_entry_repository: Arc<dyn AuditLogEntryRepository>,
}

impl<R, G> SubmitProxyCheckJobUseCase<R, G>
where
    R: ProxyCheckJobRepository,
    G: IdGenerator,
{
    pub fn new(
        repository: R,
        id_generator: G,
        audit_log_entry_repository: Arc<dyn AuditLogEntryRepository>,
    ) -> Self {
        Self {
            repository,
            id_generator,
            audit_log_entry_repository,
        }
    }

    pub async fn execute(
        &self,
        request: CreateProxyCheckJobRequest,
        authenticated_user: AuthenticatedUser,
    ) -> Result<ProxyCheckJob, SubmitProxyCheckJobError> {
        let user_id = authenticated_user.user_id();
        let tenant_id = authenticated_user.tenant_context().tenant_id();

        if request.entries.is_empty() {
            return Err(SubmitProxyCheckJobError::InvalidInput(
                "at least one proxy entry is required".to_string(),
            ));
        }

        let existing_jobs = self
            .repository
            .find_jobs_by_user_id(user_id)
            .await
            .map_err(SubmitProxyCheckJobError::RepoError)?;

        let today = Utc::now().date_naive();
        let jobs_submitted_today = existing_jobs
            .iter()
            .filter(|job| job.created_at().date_naive() == today)
            .count();

        if jobs_submitted_today >= MAX_JOBS_PER_USER_PER_DAY {
            return Err(SubmitProxyCheckJobError::QuotaExceeded {
                limit: MAX_JOBS_PER_USER_PER_DAY,
            });
        }

        let job_id = self.id_generator.next_proxy_check_job_id().await;

        let total_count = u32::try_from(request.entries.len())
            .map_err(|_| SubmitProxyCheckJobError::InvalidInput("too many entries".to_string()))?;

        let job = ProxyCheckJob::new(job_id, user_id, tenant_id, total_count);

        debug_assert!(
            OwnershipPolicy::can_access(&authenticated_user, &job),
            "newly created proxy check job must be owned by the authenticated user"
        );

        let mut entries = Vec::with_capacity(request.entries.len());
        for input in &request.entries {
            let entry_id = self.id_generator.next_proxy_entry_id().await;

            let host = ProxyHost::new(input.host.clone())
                .map_err(SubmitProxyCheckJobError::DomainError)?;

            let credentials = match (&input.username, &input.password) {
                (None, None) => None,
                (username, password) => Some(
                    ProxyCredentials::new(
                        username.clone().unwrap_or_default(),
                        password.clone().unwrap_or_default(),
                    )
                    .map_err(SubmitProxyCheckJobError::DomainError)?,
                ),
            };

            let entry = ProxyEntry::new(
                entry_id,
                job_id,
                host,
                input.port,
                input.scheme.clone(),
                credentials,
            )
            .map_err(SubmitProxyCheckJobError::DomainError)?;

            entries.push(entry);
        }

        self.repository
            .save_job(&job, &entries)
            .await
            .map_err(SubmitProxyCheckJobError::RepoError)?;

        let entry = AuditLogEntry {
            id: AuditLogEntryId::new(),
            actor_user_id: user_id,
            tenant_id: Some(tenant_id),
            action: AuditAction::ProxyCheckJobCreated,
            target_id: job.id().0.to_string(),
            metadata: json!({
                "total_count": job.total_count(),
            }),
            created_at: Utc::now(),
        };
        self.audit_log_entry_repository
            .create(&entry)
            .await
            .map_err(SubmitProxyCheckJobError::RepoError)?;

        Ok(job)
    }
}
</file>

<file path="crates/application/src/use_cases/update_api_flow.rs">
use std::{error::Error, sync::Arc};

use chrono::Utc;
use serde_json::json;

use crate::{
    commands::UpdateApiFlow,
    dto::{ApiFlowStepInput, ExtractSourceInput},
    ports::{ApiFlowRepository, AuditLogEntryRepository, MonitorRepository},
};
use domain::{
    AuditAction, AuditLogEntry, AuditLogEntryId, ExtractSource,
    entities::{ApiFlow, ApiFlowStep, Assertion},
    shared::types::AuthenticatedUser,
    value_objects::{FlowStepName, VariableExtraction},
};

pub type UseCaseResult<T> = Result<T, Box<dyn Error + Send + Sync>>;

pub struct UpdateApiFlowUseCase<R, M> {
    api_flow_repository: R,
    monitor_repository: M,
    audit_log_entry_repository: Arc<dyn AuditLogEntryRepository>,
}

impl<R, M> UpdateApiFlowUseCase<R, M>
where
    R: ApiFlowRepository,
    M: MonitorRepository,
{
    pub fn new(
        api_flow_repository: R,
        monitor_repository: M,
        audit_log_entry_repository: Arc<dyn AuditLogEntryRepository>,
    ) -> Self {
        Self {
            api_flow_repository,
            monitor_repository,
            audit_log_entry_repository,
        }
    }

    pub async fn execute(
        &self,
        command: UpdateApiFlow,
        authenticated_user: AuthenticatedUser,
    ) -> UseCaseResult<Option<ApiFlow>> {
        let user_id = authenticated_user.user_id();
        let tenant_id = authenticated_user.tenant_context().tenant_id();

        if self
            .monitor_repository
            .find_by_id_for_user(command.monitor_id, user_id)
            .await?
            .is_none()
        {
            return Ok(None);
        }

        let existing = match self.api_flow_repository.find_by_id(command.id).await? {
            Some(flow) => flow,
            None => return Ok(None),
        };

        if existing.monitor_id != command.monitor_id {
            return Ok(None);
        }

        let steps = build_steps(command.steps)?;

        let mut flow = ApiFlow::new(command.id, command.monitor_id, tenant_id, steps)
            .map_err(Box::<dyn Error + Send + Sync>::from)?;

        flow.created_at = existing.created_at;
        flow.updated_at = Utc::now();

        self.api_flow_repository.update(&flow).await?;

        let entry = AuditLogEntry {
            id: AuditLogEntryId::new(),
            actor_user_id: user_id,
            tenant_id: Some(tenant_id),
            action: AuditAction::ApiFlowUpdated,
            target_id: flow.id.0.to_string(),
            metadata: json!({
                "monitor_id": flow.monitor_id.0.to_string(),
                "steps": flow.steps.len(),
            }),
            created_at: Utc::now(),
        };
        self.audit_log_entry_repository.create(&entry).await?;

        Ok(Some(flow))
    }
}

fn build_steps(input_steps: Vec<ApiFlowStepInput>) -> UseCaseResult<Vec<ApiFlowStep>> {
    let mut steps = Vec::with_capacity(input_steps.len());

    for step_input in input_steps {
        let name =
            FlowStepName::new(step_input.name).map_err(Box::<dyn Error + Send + Sync>::from)?;

        let mut extract = Vec::with_capacity(step_input.extract.len());
        for extraction_input in step_input.extract {
            let source = match extraction_input.source {
                ExtractSourceInput::StatusCode => ExtractSource::StatusCode,
                ExtractSourceInput::Header(name) => ExtractSource::Header(name),
                ExtractSourceInput::JsonPath(path) => ExtractSource::JsonPath(path),
                ExtractSourceInput::Body => ExtractSource::Body,
            };

            let extraction = VariableExtraction::new(extraction_input.name, source)
                .map_err(Box::<dyn Error + Send + Sync>::from)?;

            extract.push(extraction);
        }

        let mut assertions = Vec::with_capacity(step_input.assertions.len());
        for input in &step_input.assertions {
            let assertion = Assertion::new(
                input.response_part.clone(),
                input.operator.clone(),
                input.target.clone(),
                input.expected_value.clone(),
            )
            .map_err(Box::<dyn Error + Send + Sync>::from)?;

            assertions.push(assertion);
        }

        let step = ApiFlowStep::new(
            step_input.order,
            name,
            step_input.method,
            step_input.url_template,
            step_input.headers,
            step_input.body,
            extract,
            assertions,
        )
        .map_err(Box::<dyn Error + Send + Sync>::from)?;

        steps.push(step);
    }

    Ok(steps)
}
