<file path="crates/worker/src/custom_domain_verification_worker.rs">
use std::{error::Error, sync::Arc, time::Duration as StdDuration};

use application::ports::{CustomDomainVerifier, StatusPageRepository};
use chrono::{Duration as ChronoDuration, Utc};
use domain::entities::{CustomDomainVerification, StatusPage};
use tracing::{debug, error, info, warn};

type Result<T> = std::result::Result<T, Box<dyn Error + Send + Sync>>;

/// A `Pending` custom-domain request older than this is abandoned rather
/// than checked forever. The domain entity's `request_custom_domain` doc
/// comment calls this out explicitly ("`requested_at` lets the
/// worker/cleanup job expire stale, never-verified requests") — this is
/// that job. 7 days comfortably covers realistic DNS propagation delays
/// and an owner who's slow to update their DNS records, while not leaving
/// abandoned verification attempts (and the token that goes with them)
/// sitting around forever.
const STALE_PENDING_DOMAIN_MAX_AGE: ChronoDuration = ChronoDuration::days(7);

/// Runs a periodic sweep that checks every status page with a `Pending`
/// custom domain against live DNS, via `CustomDomainVerifier`.
///
/// SECURITY: this worker is the ONLY caller in the entire codebase
/// permitted to invoke `StatusPage::mark_custom_domain_verified` — and
/// only ever immediately after `CustomDomainVerifier::verify` has
/// returned `Ok(true)` for that exact domain/token pair. See the SECURITY
/// notes on both of those for why: skipping the real DNS check would let
/// anyone claim ownership of any domain and hijack its status-page
/// traffic once host-header routing goes live.
#[derive(Clone)]
pub struct CustomDomainVerificationWorker {
    status_page_repository: Arc<dyn StatusPageRepository>,
    custom_domain_verifier: Arc<dyn CustomDomainVerifier>,
}

impl CustomDomainVerificationWorker {
    pub fn new(
        status_page_repository: Arc<dyn StatusPageRepository>,
        custom_domain_verifier: Arc<dyn CustomDomainVerifier>,
    ) -> Self {
        Self {
            status_page_repository,
            custom_domain_verifier,
        }
    }

    /// Runs one sweep. Returns Ok(()) even if individual pages fail to
    /// verify; errors are logged and the sweep continues to the next
    /// page.
    pub async fn run_once(&self) -> Result<()> {
        let pending_pages = self
            .status_page_repository
            .find_pending_custom_domains()
            .await?;

        debug!(
            count = pending_pages.len(),
            "custom domain verification sweep starting"
        );

        for mut status_page in pending_pages {
            if let Err(err) = self.process_status_page(&mut status_page).await {
                error!(
                    status_page_id = %status_page.id.0,
                    error = %err,
                    "failed to process custom domain verification for status page"
                );
                continue;
            }
        }

        Ok(())
    }

    async fn process_status_page(&self, status_page: &mut StatusPage) -> Result<()> {
        let Some((
            domain,
            CustomDomainVerification::Pending {
                token,
                requested_at,
            },
        )) = status_page.custom_domain.clone()
        else {
            // Already verified (or cleared) by the time we got to it —
            // nothing to do. Can happen if the owner updated it between
            // the list query and now.
            debug!(
                status_page_id = %status_page.id.0,
                "status page no longer has a pending custom domain; skipping"
            );
            return Ok(());
        };

        if Utc::now() - requested_at > STALE_PENDING_DOMAIN_MAX_AGE {
            warn!(
                status_page_id = %status_page.id.0,
                domain = domain.as_str(),
                requested_at = %requested_at,
                "custom domain verification request is stale; abandoning"
            );
            status_page.remove_custom_domain();
            self.status_page_repository.update(status_page).await?;
            return Ok(());
        }

        let verified = match self
            .custom_domain_verifier
            .verify(domain.as_str(), &token)
            .await
        {
            Ok(verified) => verified,
            Err(err) => {
                // A lookup failure (DNS timeout, resolver error, etc) is
                // transient — log and try again next sweep. Do NOT treat
                // this as "not verified forever"; the page stays Pending.
                warn!(
                    status_page_id = %status_page.id.0,
                    domain = domain.as_str(),
                    error = %err,
                    "DNS TXT record lookup failed during custom domain verification"
                );
                return Ok(());
            }
        };

        if !verified {
            debug!(
                status_page_id = %status_page.id.0,
                domain = domain.as_str(),
                "custom domain TXT record not published yet"
            );
            return Ok(());
        }

        // SECURITY: this is the one and only place in the codebase this
        // is called, and only immediately after a live DNS lookup
        // confirmed above returned `Ok(true)` for this exact
        // domain/token pair. See the SECURITY note on
        // `mark_custom_domain_verified` itself.
        status_page.mark_custom_domain_verified()?;
        self.status_page_repository.update(status_page).await?;

        info!(
            status_page_id = %status_page.id.0,
            domain = domain.as_str(),
            "custom domain verified"
        );

        Ok(())
    }

    /// Runs forever, sleeping 60 seconds between sweeps.
    ///
    /// Same cadence as `EscalationWorker` for consistency. DNS
    /// propagation is typically much slower than 60 seconds, so most
    /// sweeps for a given pending domain will simply find nothing new —
    /// that's expected and cheap (a single indexed query), not a
    /// problem to tune away.
    pub async fn run_forever(&self) -> Result<()> {
        let mut interval = tokio::time::interval(StdDuration::from_secs(60));
        loop {
            interval.tick().await;
            if let Err(err) = self.run_once().await {
                error!(error = %err, "custom domain verification sweep failed");
            }
        }
    }
}
</file>

<file path="crates/worker/src/diagnostics.rs">
//! Diagnostic checks run immediately after a monitor's main check fails,
//! so the customer sees WHY it went down (DNS / TCP / TLS / HTTP) instead
//! of just "Down".
//!
//! ## SSRF / DNS-rebinding note
//!
//! This module NEVER performs a second, independent DNS lookup for a
//! destination the main check already resolved+validated. When the main
//! check succeeded in resolving+validating the monitor's host but failed
//! at a LATER stage (TCP/TLS/HTTP), the caller passes that exact
//! `shared::ssrf::ResolvedDestination` in as `existing_destination`, and
//! Step 1 here reuses its already-validated IP verbatim — resolving again
//! at this point could return a *different* IP (DNS rebinding) and would
//! defeat the whole point of pinning.
//!
//! The ONE exception is when the main check itself failed to resolve or
//! SSRF-validate the destination in the first place (`existing_destination
//! == None`): in that case there is no IP to reuse, and Step 1's own
//! attempt via the SAME SSRF-guarded resolver *is* the diagnosis ("DNS
//! resolution failed"). This never gives an attacker two independent
//! chances at two different addresses — if it fails, every later step is
//! `Skipped`; if it unexpectedly succeeds, that resolved IP is used
//! immediately and only within this same diagnostic run (Steps 2-4),
//! never handed back out.
//!
//! No diagnostic step here ever dials anything other than the monitor's
//! own already-validated destination — no extra attack surface is
//! introduced beyond what the main check already reaches.

use std::time::{Duration, Instant};

use domain::{DiagnosticStep, DiagnosticStepStatus, Monitor};
use shared::ssrf::ResolvedDestination;

use crate::tls_cert;

/// Hard cap on the total wall-clock time a single diagnostic run may
/// take, regardless of how many steps run or how slow the target is at
/// each stage. A diagnostic run must never become a second, heavier check
/// piled on top of every single failure.
pub const DIAGNOSTIC_TOTAL_TIMEOUT: Duration = Duration::from_secs(15);

/// Per-step timeout budget, kept well under `DIAGNOSTIC_TOTAL_TIMEOUT` so
/// the outer timeout is the one that ultimately bounds the run.
const STEP_TIMEOUT: Duration = Duration::from_secs(5);

/// Result of a diagnostic run: the step-by-step timeline plus a single
/// template-generated root cause summary.
pub struct DiagnosticOutcome {
    pub steps: Vec<DiagnosticStep>,
    pub root_cause_summary: String,
}

/// Runs the diagnostic step chain for `monitor` immediately after its
/// main check has failed, while the monitor is still "warm" in memory
/// (called synchronously from `checker.rs::check_monitor` on the same
/// failure path — no waiting for the next scheduled check).
///
/// See the module-level SSRF note above for the contract on
/// `existing_destination`.
pub async fn run_diagnostics(
    monitor: &Monitor,
    existing_destination: Option<&ResolvedDestination>,
) -> DiagnosticOutcome {
    match tokio::time::timeout(
        DIAGNOSTIC_TOTAL_TIMEOUT,
        run_diagnostics_inner(monitor, existing_destination),
    )
    .await
    {
        Ok(outcome) => outcome,
        Err(_elapsed) => DiagnosticOutcome {
            steps: vec![DiagnosticStep::new(
                "Diagnostics",
                DiagnosticStepStatus::Failed,
                DIAGNOSTIC_TOTAL_TIMEOUT.as_millis() as u64,
                "Diagnostic run exceeded its 15 second time budget",
            )],
            root_cause_summary: "Diagnostics timed out before a root cause could be determined"
                .to_string(),
        },
    }
}

async fn run_diagnostics_inner(
    monitor: &Monitor,
    existing_destination: Option<&ResolvedDestination>,
) -> DiagnosticOutcome {
    let mut steps: Vec<DiagnosticStep> = Vec::with_capacity(4);

    // ---- Step 1: DNS resolution ----
    let destination: Option<ResolvedDestination> = match existing_destination {
        Some(existing) => {
            steps.push(DiagnosticStep::new(
                "DNS resolution",
                DiagnosticStepStatus::Success,
                0,
                format!(
                    "Already resolved to {} by the primary check; reused to avoid a second DNS lookup",
                    existing.socket_addr.ip()
                ),
            ));
            Some(existing.clone())
        }
        None => {
            let started = Instant::now();
            match shared::ssrf::resolve_and_validate_destination(monitor.url.as_str()).await {
                Ok(resolved) => {
                    let elapsed = started.elapsed().as_millis() as u64;
                    steps.push(DiagnosticStep::new(
                        "DNS resolution",
                        DiagnosticStepStatus::Success,
                        elapsed,
                        format!("Resolved to {} in {elapsed}ms", resolved.socket_addr.ip()),
                    ));
                    Some(resolved)
                }
                Err(_err) => {
                    let elapsed = started.elapsed().as_millis() as u64;
                    steps.push(DiagnosticStep::new(
                        "DNS resolution",
                        DiagnosticStepStatus::Failed,
                        elapsed,
                        format!(
                            "Failed to resolve or validate the monitor's hostname after {elapsed}ms"
                        ),
                    ));
                    None
                }
            }
        }
    };

    let Some(destination) = destination else {
        let dns_ms = steps[0].duration_ms;
        steps.push(DiagnosticStep::skipped("TCP connect"));
        steps.push(DiagnosticStep::skipped("TLS handshake"));
        steps.push(DiagnosticStep::skipped("HTTP response"));

        return DiagnosticOutcome {
            root_cause_summary: format!("DNS resolution failed after {dns_ms}ms"),
            steps,
        };
    };

    let is_https = monitor.url.as_str().starts_with("https://");

    // ---- Step 2: TCP connect ----
    let started = Instant::now();
    let tcp_result = tokio::time::timeout(
        STEP_TIMEOUT,
        tokio::net::TcpStream::connect(destination.socket_addr),
    )
    .await;
    let tcp_elapsed = started.elapsed().as_millis() as u64;

    let tcp_failure_reason: Option<&'static str> = match tcp_result {
        Ok(Ok(_stream)) => {
            steps.push(DiagnosticStep::new(
                "TCP connect",
                DiagnosticStepStatus::Success,
                tcp_elapsed,
                format!(
                    "Connected to {} in {tcp_elapsed}ms",
                    destination.socket_addr
                ),
            ));
            None
        }
        Ok(Err(err)) => {
            let reason = classify_connect_error(&err);
            steps.push(DiagnosticStep::new(
                "TCP connect",
                DiagnosticStepStatus::Failed,
                tcp_elapsed,
                format!(
                    "Failed to connect to {} after {tcp_elapsed}ms: {reason}",
                    destination.socket_addr
                ),
            ));
            Some(reason)
        }
        Err(_timed_out) => {
            steps.push(DiagnosticStep::new(
                "TCP connect",
                DiagnosticStepStatus::Failed,
                tcp_elapsed,
                format!(
                    "Connection attempt to {} timed out after {tcp_elapsed}ms",
                    destination.socket_addr
                ),
            ));
            Some("connection timeout")
        }
    };

    if let Some(reason) = tcp_failure_reason {
        if is_https {
            steps.push(DiagnosticStep::skipped("TLS handshake"));
        }
        steps.push(DiagnosticStep::skipped("HTTP response"));

        return DiagnosticOutcome {
            root_cause_summary: format!("TCP connection failed after {tcp_elapsed}ms ({reason})"),
            steps,
        };
    }

    // ---- Step 3: TLS handshake (only for https) ----
    if is_https {
        let started = Instant::now();
        let handshake =
            tls_cert::probe_tls_handshake(&destination.host, destination.socket_addr, STEP_TIMEOUT)
                .await;
        let tls_elapsed = started.elapsed().as_millis() as u64;

        if handshake.is_err() {
            let expired_on = tls_cert::probe_expired_cert_date(
                &destination.host,
                destination.socket_addr,
                STEP_TIMEOUT,
            )
            .await;

            let detail = match expired_on {
                Some(expires_at) => {
                    format!("Certificate expired on {}", expires_at.format("%Y-%m-%d"))
                }
                None => format!("TLS handshake failed after {tls_elapsed}ms"),
            };

            steps.push(DiagnosticStep::new(
                "TLS handshake",
                DiagnosticStepStatus::Failed,
                tls_elapsed,
                detail.clone(),
            ));
            steps.push(DiagnosticStep::skipped("HTTP response"));

            return DiagnosticOutcome {
                root_cause_summary: format!("TLS handshake failed: {detail}"),
                steps,
            };
        }

        steps.push(DiagnosticStep::new(
            "TLS handshake",
            DiagnosticStepStatus::Success,
            tls_elapsed,
            format!("TLS handshake completed in {tls_elapsed}ms"),
        ));
    }

    // ---- Step 4: HTTP request/response ----
    let started = Instant::now();
    let http_result = probe_http(monitor, &destination).await;
    let http_elapsed = started.elapsed().as_millis() as u64;

    match http_result {
        Ok(status) => {
            steps.push(DiagnosticStep::new(
                "HTTP response",
                DiagnosticStepStatus::Success,
                http_elapsed,
                format!("Received HTTP {status} in {http_elapsed}ms"),
            ));

            DiagnosticOutcome {
                root_cause_summary: format!(
                    "Server responded with HTTP {status}, which did not match what the monitor expected"
                ),
                steps,
            }
        }
        Err(_err) => {
            steps.push(DiagnosticStep::new(
                "HTTP response",
                DiagnosticStepStatus::Failed,
                http_elapsed,
                format!("No valid HTTP response received after {http_elapsed}ms"),
            ));

            DiagnosticOutcome {
                root_cause_summary: format!(
                    "Server accepted the connection but did not return a valid HTTP response within {http_elapsed}ms"
                ),
                steps,
            }
        }
    }
}

/// Classifies a TCP connect `io::Error` into a small, fixed set of
/// template phrases — never the raw OS error text — so the phrase can
/// safely flow into `root_cause_summary`.
fn classify_connect_error(err: &std::io::Error) -> &'static str {
    use std::io::ErrorKind;
    match err.kind() {
        ErrorKind::ConnectionRefused => "connection refused",
        ErrorKind::TimedOut => "connection timeout",
        _ => "connection failed",
    }
}

/// Sends a single diagnostic HTTP request against the already-resolved,
/// already-SSRF-validated `destination` — using the exact same
/// `.resolve(host, socket_addr)` DNS-pinning pattern as
/// `checker.rs::check_monitor`, so this never triggers a second DNS
/// lookup either. Redirects are disabled for the same SSRF reason as the
/// main checker.
async fn probe_http(
    monitor: &Monitor,
    destination: &ResolvedDestination,
) -> Result<u16, Box<dyn std::error::Error + Send + Sync>> {
    let method = match monitor.method {
        domain::HttpMethod::Get => reqwest::Method::GET,
        domain::HttpMethod::Head => reqwest::Method::HEAD,
    };

    let pinned_client = reqwest::Client::builder()
        .redirect(reqwest::redirect::Policy::none())
        .resolve(&destination.host, destination.socket_addr)
        .build()?;

    let response = pinned_client
        .request(method, destination.url.clone())
        .timeout(STEP_TIMEOUT)
        .send()
        .await?;

    Ok(response.status().as_u16())
}
</file>

<file path="crates/worker/src/escalation_worker.rs">
use std::{error::Error, sync::Arc, time::Duration};

use application::ports::{
    EscalationPolicyRepository, IncidentRepository, MonitorRepository,
    NotificationChannelRepository, NotificationService,
};
use domain::{Incident, notification::NotificationEvent};
use tracing::{debug, error, info, warn};

type Result<T> = std::result::Result<T, Box<dyn Error + Send + Sync>>;

/// Runs a periodic sweep that checks open, unacknowledged incidents and
/// sends escalation notifications according to each monitor's effective
/// escalation policy.
#[derive(Clone)]
pub struct EscalationWorker {
    incident_repository: Arc<dyn IncidentRepository>,
    monitor_repository: Arc<dyn MonitorRepository>,
    escalation_policy_repository: Arc<dyn EscalationPolicyRepository>,
    notification_channel_repository: Arc<dyn NotificationChannelRepository>,
    notification_service: Arc<dyn NotificationService>,
}

impl EscalationWorker {
    pub fn new(
        incident_repository: Arc<dyn IncidentRepository>,
        monitor_repository: Arc<dyn MonitorRepository>,
        escalation_policy_repository: Arc<dyn EscalationPolicyRepository>,
        notification_channel_repository: Arc<dyn NotificationChannelRepository>,
        notification_service: Arc<dyn NotificationService>,
    ) -> Self {
        Self {
            incident_repository,
            monitor_repository,
            escalation_policy_repository,
            notification_channel_repository,
            notification_service,
        }
    }

    /// Runs one sweep. Returns Ok(()) even if individual sends fail; errors
    /// are logged and the sweep continues.
    pub async fn run_once(&self) -> Result<()> {
        let incidents = self.incident_repository.list_open_unacknowledged().await?;

        debug!(count = incidents.len(), "escalation sweep starting");

        for mut incident in incidents {
            if let Err(err) = self.process_incident(&mut incident).await {
                error!(
                    incident_id = %incident.id.0,
                    error = %err,
                    "failed to process escalation for incident"
                );
                continue;
            }
        }

        Ok(())
    }

    async fn process_incident(&self, incident: &mut Incident) -> Result<()> {
        let monitor = match self
            .monitor_repository
            .find_by_id(incident.monitor_id)
            .await?
        {
            Some(m) => m,
            None => {
                warn!(
                    monitor_id = %incident.monitor_id.0,
                    "monitor not found for incident during escalation"
                );
                return Ok(());
            }
        };

        let policy = match self
            .escalation_policy_repository
            .find_effective(monitor.id, monitor.user_id)
            .await?
        {
            Some(p) => p,
            None => {
                debug!(
                    monitor_id = %monitor.id.0,
                    "no escalation policy for monitor; skipping"
                );
                return Ok(());
            }
        };

        let step_index = incident.escalation_step_index as usize;
        if step_index >= policy.steps.len() {
            debug!(
                incident_id = %incident.id.0,
                step_index = step_index,
                "all escalation steps already sent"
            );
            return Ok(());
        }

        let step = &policy.steps[step_index];
        let now = chrono::Utc::now();
        let base_time = if step_index == 0 {
            incident.started_at
        } else {
            incident
                .last_escalation_at
                .expect("last_escalation_at must be set after step 0")
        };

        let delay = chrono::Duration::minutes(step.delay_minutes as i64);
        if now < base_time + delay {
            debug!(
                incident_id = %incident.id.0,
                step_index = step_index,
                "delay not elapsed yet"
            );
            return Ok(());
        }

        // Fetch channels for this monitor (enabled only) and find the
        // channel specified in the step.
        let channels = self
            .notification_channel_repository
            .list_enabled_by_monitor(monitor.id)
            .await?;

        let channel = channels.iter().find(|c| c.id == step.channel_id);
        if channel.is_none() {
            warn!(
                incident_id = %incident.id.0,
                channel_id = %step.channel_id.0,
                "escalation channel not found or disabled"
            );
            return Ok(());
        }

        let channel = channel.unwrap();

        // Send escalation notification (reusing MonitorDown event).
        if let Err(err) = self
            .notification_service
            .notify(channel, &NotificationEvent::MonitorDown(monitor.clone()))
            .await
        {
            error!(
                incident_id = %incident.id.0,
                channel_id = %channel.id.0,
                error = %err,
                "failed to send escalation notification"
            );
            return Ok(());
        }

        info!(
            incident_id = %incident.id.0,
            step_index = step_index,
            channel_id = %channel.id.0,
            "sent escalation notification"
        );

        // Advance escalation progress
        incident.escalation_step_index = step_index as u32 + 1;
        incident.last_escalation_at = Some(now);
        incident.updated_at = now;
        self.incident_repository.update(incident).await?;

        Ok(())
    }

    /// Runs forever, sleeping 60 seconds between sweeps.
    pub async fn run_forever(&self) -> Result<()> {
        let mut interval = tokio::time::interval(Duration::from_secs(60));
        loop {
            interval.tick().await;
            if let Err(err) = self.run_once().await {
                error!(error = %err, "escalation sweep failed");
            }
        }
    }
}
