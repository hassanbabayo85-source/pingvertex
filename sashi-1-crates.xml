<file path="crates/agent/src/checker.rs">
use domain::{HttpMethod, Monitor, RegionCode};
use maxminddb::{PathElement, Reader};
use reqwest::Client;
use serde::Serialize;
use shared::ssrf::resolve_and_validate_destination;
use std::net::IpAddr;
use std::time::{Duration, Instant};

#[derive(Debug, Serialize)]
pub struct CheckOutcome {
    pub success: bool,
    pub status_code: Option<u16>,
    pub latency_ms: u128,
    pub error: Option<String>,
    pub region: String,
    pub country_code: Option<String>,
}

/// Looks up the ISO country code for `ip` in the offline GeoIP database.
/// Any failure (IP not found, decode error, etc.) degrades gracefully to `None`.
fn lookup_country_code(geoip_reader: &Reader<Vec<u8>>, ip: IpAddr) -> Option<String> {
    geoip_reader
        .lookup(ip)
        .ok()
        .and_then(|result| {
            result
                .decode_path::<String>(&[PathElement::Key("country"), PathElement::Key("iso_code")])
                .ok()
        })
        .flatten()
}

/// Executes a single HTTP check for a monitor from the given region.
///
/// SSRF protection uses `shared::ssrf::resolve_and_validate_destination`
/// — the SAME validator worker uses — before every request. The returned
/// `CheckOutcome` is serialized and submitted to the central API.
pub async fn check_monitor(
    monitor: &Monitor,
    region: &RegionCode,
    geoip_reader: &Reader<Vec<u8>>,
) -> CheckOutcome {
    if !monitor.enabled {
        return CheckOutcome {
            success: false,
            status_code: None,
            latency_ms: 0,
            error: Some("monitor is disabled".to_string()),
            region: region.to_string(),
            country_code: None,
        };
    }

    let method = match monitor.method {
        HttpMethod::Get => reqwest::Method::GET,
        HttpMethod::Head => reqwest::Method::HEAD,
    };

    let overall_started = Instant::now();

    let destination = match resolve_and_validate_destination(monitor.url.as_str()).await {
        Ok(destination) => destination,
        Err(err) => {
            let latency = overall_started.elapsed().as_millis();
            return CheckOutcome {
                success: false,
                status_code: None,
                latency_ms: latency,
                error: Some(err),
                region: region.to_string(),
                country_code: None,
            };
        }
    };

    let country_code = lookup_country_code(geoip_reader, destination.socket_addr.ip());

    let client = match Client::builder()
        .redirect(reqwest::redirect::Policy::none())
        .resolve(&destination.host, destination.socket_addr)
        .build()
    {
        Ok(client) => client,
        Err(err) => {
            let latency = overall_started.elapsed().as_millis();
            return CheckOutcome {
                success: false,
                status_code: None,
                latency_ms: latency,
                error: Some(err.to_string()),
                region: region.to_string(),
                country_code,
            };
        }
    };

    let started = Instant::now();
    let response = client
        .request(method, destination.url.clone())
        .timeout(Duration::from_secs(monitor.timeout_seconds.into()))
        .send()
        .await;

    let latency = started.elapsed().as_millis();

    match response {
        Ok(resp) => {
            let status = resp.status().as_u16();
            let success = status == monitor.expected_status;
            CheckOutcome {
                success,
                status_code: Some(status),
                latency_ms: latency,
                error: if success {
                    None
                } else {
                    Some(format!(
                        "expected {}, got {}",
                        monitor.expected_status, status
                    ))
                },
                region: region.to_string(),
                country_code,
            }
        }
        Err(err) => CheckOutcome {
            success: false,
            status_code: None,
            latency_ms: latency,
            error: Some(err.to_string()),
            region: region.to_string(),
            country_code,
        },
    }
}
</file>

<file path="crates/agent/src/claim_client.rs">
use crate::checker::CheckOutcome;
use domain::{Monitor, RegionCode};
use reqwest::Client;
use serde::{Deserialize, Serialize};
use uuid::Uuid;

#[derive(Debug, Deserialize)]
struct ClaimResponse {
    checks: Vec<ClaimedCheck>,
}

#[derive(Debug, Deserialize)]
pub struct ClaimedCheck {
    pub check_id: Uuid,
    pub monitor: Monitor,
    pub region: RegionCode,
}

#[derive(Debug, Serialize)]
struct SubmitResultRequest {
    check_id: Uuid,
    monitor_id: Uuid,
    region: String,
    success: bool,
    status_code: Option<u16>,
    latency_ms: u128,
    error: Option<String>,
    country_code: Option<String>,
}

pub async fn claim_checks(
    client: &Client,
    api_base: &str,
    agent_id: &str,
    agent_region: &str,
) -> anyhow::Result<Vec<ClaimedCheck>> {
    let url = format!("{api_base}/agents/{agent_id}/checks/claim");

    let resp = client
        .post(url)
        .header("X-Agent-Region", agent_region)
        .send()
        .await?
        .error_for_status()?;

    let body: ClaimResponse = resp.json().await?;
    Ok(body.checks)
}

pub async fn submit_result(
    client: &Client,
    api_base: &str,
    agent_id: &str,
    agent_region: &str,
    check_id: Uuid,
    monitor_id: Uuid,
    result: CheckOutcome,
) -> anyhow::Result<()> {
    let url = format!("{api_base}/agents/{agent_id}/results");

    let payload = SubmitResultRequest {
        check_id,
        monitor_id,
        region: result.region,
        success: result.success,
        status_code: result.status_code,
        latency_ms: result.latency_ms,
        error: result.error,
        country_code: result.country_code,
    };

    client
        .post(url)
        .header("X-Agent-Region", agent_region)
        .json(&payload)
        .send()
        .await?
        .error_for_status()?;

    Ok(())
}
