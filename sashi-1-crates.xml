<file path="crates/infra/src/services/sms_notification_service.rs">
use application::ports::{NotificationService, NotifyResult, SecretCipher};
use async_trait::async_trait;
use domain::{
    entities::NotificationChannel, enums::NotificationChannelKind, notification::NotificationEvent,
};

/// SMS notification service (Twilio/Africa's Talking).
///
/// Holds a `SecretCipher` so that the encrypted `encrypted_secret` field
/// (a phone number, encrypted by `CreateNotificationChannelUseCase`) can
/// be decrypted before use. If the provider credentials are missing, a
/// clear error is returned *after* decryption — this ensures the cipher is
/// actually used and validates the encrypted data path.
pub struct SmsNotificationService {
    cipher: std::sync::Arc<dyn SecretCipher>,
}

impl SmsNotificationService {
    pub fn new(cipher: std::sync::Arc<dyn SecretCipher>) -> Self {
        Self { cipher }
    }
}

#[async_trait]
impl NotificationService for SmsNotificationService {
    async fn notify(
        &self,
        channel: &NotificationChannel,
        _event: &NotificationEvent,
    ) -> NotifyResult {
        if channel.kind != NotificationChannelKind::Sms {
            return Err(format!(
                "SmsNotificationService received non-sms channel (kind: {})",
                channel.kind
            )
            .into());
        }

        // Decrypt phone number from encrypted_secret. This is what makes the
        // cipher actually be read/used — and what the warning about `cipher`
        // was pointing at.
        let encrypted = channel
            .encrypted_secret
            .as_ref()
            .ok_or("sms channel is missing encrypted phone number")?;
        let phone_bytes = self
            .cipher
            .decrypt_bytes(encrypted)
            .map_err(|err| format!("failed to decrypt sms phone number: {err}"))?;
        let _phone_number = String::from_utf8(phone_bytes)
            .map_err(|_| "decrypted sms phone number is not valid UTF-8")?;

        // Check provider configuration.
        let twilio_sid = std::env::var("TWILIO_ACCOUNT_SID").ok();
        let twilio_token = std::env::var("TWILIO_AUTH_TOKEN").ok();
        let from_number = std::env::var("TWILIO_FROM_NUMBER").ok();

        if twilio_sid.is_none() || twilio_token.is_none() || from_number.is_none() {
            return Err(
                "SMS provider not configured; set TWILIO_ACCOUNT_SID, TWILIO_AUTH_TOKEN, TWILIO_FROM_NUMBER to enable SMS notifications".into()
            );
        }

        // Provider credentials are present but the actual Twilio/Africa's Talking
        // HTTP integration is not implemented yet. Fail loudly rather than pretend.
        Err("SMS provider integration not yet implemented (Twilio credentials present)".into())
    }
}
</file>

<file path="crates/infra/src/services/telegram_notification_service.rs">
use std::time::Duration;

use application::ports::{NotificationService, NotifyResult};
use async_trait::async_trait;
use domain::{
    entities::NotificationChannel, enums::NotificationChannelKind, notification::NotificationEvent,
};
use serde::Serialize;
use tracing::warn;

const TELEGRAM_TIMEOUT: Duration = Duration::from_secs(5);

pub struct TelegramNotificationService {
    cipher: std::sync::Arc<dyn application::ports::SecretCipher>,
}

impl TelegramNotificationService {
    pub fn new(cipher: std::sync::Arc<dyn application::ports::SecretCipher>) -> Self {
        Self { cipher }
    }
}

#[derive(Debug, Serialize)]
struct TelegramPayload<'a> {
    chat_id: &'a str,
    text: String,
}

#[async_trait]
impl NotificationService for TelegramNotificationService {
    async fn notify(
        &self,
        channel: &NotificationChannel,
        event: &NotificationEvent,
    ) -> NotifyResult {
        if channel.kind != NotificationChannelKind::Telegram {
            return Err(format!(
                "TelegramNotificationService received non-telegram channel (kind: {})",
                channel.kind
            )
            .into());
        }

        if channel.target.trim().is_empty() {
            return Err("telegram channel is missing a chat id".into());
        }
        let chat_id = &channel.target;

        let text = match event {
            NotificationEvent::MonitorDown(m) => format!("🔴 {} is DOWN", m.name.as_str()),
            NotificationEvent::MonitorRecovered(m) => {
                format!("✅ {} has recovered", m.name.as_str())
            }
            NotificationEvent::Test(m) => format!("🔔 Test notification for {}", m.name.as_str()),
        };

        let payload = TelegramPayload { chat_id, text };
        let body = serde_json::to_vec(&payload)?;

        let encrypted_token = channel
            .encrypted_secret
            .as_ref()
            .ok_or("telegram channel is missing encrypted bot token")?;
        let token_bytes = self.cipher.decrypt_bytes(encrypted_token)?;
        let token = std::str::from_utf8(&token_bytes)
            .map_err(|_| "decrypted telegram bot token is not valid UTF-8")?;
        let url = format!("https://api.telegram.org/bot{}/sendMessage", token);
        let mut last_error: Option<Box<dyn std::error::Error + Send + Sync>> = None;
        for attempt in 0..3 {
            if attempt > 0 {
                tokio::time::sleep(Duration::from_millis(500 * 2u64.pow(attempt - 1))).await;
            }
            match send_once(&url, &body).await {
                Ok(()) => return Ok(()),
                Err(err) => {
                    warn!(attempt = attempt + 1, error = %err, "telegram notification attempt failed");
                    last_error = Some(err);
                }
            }
        }
        Err(last_error.unwrap_or_else(|| "telegram notification failed".into()))
    }
}

async fn send_once(url: &str, body: &[u8]) -> Result<(), Box<dyn std::error::Error + Send + Sync>> {
    let destination = shared::ssrf::resolve_and_validate_destination(url).await?;
    let client = reqwest::Client::builder()
        .redirect(reqwest::redirect::Policy::none())
        .resolve(&destination.host, destination.socket_addr)
        .timeout(TELEGRAM_TIMEOUT)
        .build()?;
    let response = client
        .post(destination.url)
        .header("Content-Type", "application/json")
        .body(body.to_vec())
        .send()
        .await?;
    if !response.status().is_success() {
        return Err(format!(
            "telegram endpoint responded with status {}",
            response.status()
        )
        .into());
    }
    Ok(())
}
