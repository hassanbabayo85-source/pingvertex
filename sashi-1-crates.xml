<file path="crates/application/src/use_cases/acknowledge_incident.rs">
use std::{error::Error, fmt, sync::Arc};

use chrono::Utc;
use domain::shared::types::AuthenticatedUser;
use domain::{AuditAction, AuditLogEntry, AuditLogEntryId, Incident};
use serde_json::json;

use crate::{
    commands::AcknowledgeIncident,
    ports::{AuditLogEntryRepository, IncidentRepository, MonitorRepository},
};

/// Error returned by `AcknowledgeIncidentUseCase`.
#[derive(Debug)]
pub enum AcknowledgeIncidentError {
    /// Incident doesn't exist, or exists but belongs to a monitor the user
    /// doesn't own. Deliberately the same outward result either way.
    NotFound,
    /// Incident is already resolved — acknowledgement only makes sense for
    /// open incidents.
    AlreadyResolved,
    Other(Box<dyn Error + Send + Sync>),
}

impl fmt::Display for AcknowledgeIncidentError {
    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
        match self {
            Self::NotFound => write!(f, "incident not found or access denied"),
            Self::AlreadyResolved => write!(f, "incident is already resolved"),
            Self::Other(err) => write!(f, "{err}"),
        }
    }
}

impl Error for AcknowledgeIncidentError {}

/// Acknowledges an incident, verifying that the user owns the monitor
/// associated with that incident.
pub struct AcknowledgeIncidentUseCase {
    monitor_repository: Arc<dyn MonitorRepository>,
    incident_repository: Arc<dyn IncidentRepository>,
    audit_log_entry_repository: Arc<dyn AuditLogEntryRepository>,
}

impl AcknowledgeIncidentUseCase {
    pub fn new(
        monitor_repository: Arc<dyn MonitorRepository>,
        incident_repository: Arc<dyn IncidentRepository>,
        audit_log_entry_repository: Arc<dyn AuditLogEntryRepository>,
    ) -> Self {
        Self {
            monitor_repository,
            incident_repository,
            audit_log_entry_repository,
        }
    }

    pub async fn execute(
        &self,
        command: AcknowledgeIncident,
        authenticated_user: AuthenticatedUser,
    ) -> Result<Incident, AcknowledgeIncidentError> {
        let user_id = authenticated_user.user_id();
        let tenant_id = authenticated_user.tenant_context().tenant_id();

        let mut incident = self
            .incident_repository
            .find_by_id(command.incident_id)
            .await
            .map_err(AcknowledgeIncidentError::Other)?
            .ok_or(AcknowledgeIncidentError::NotFound)?;

        // Verify ownership via the monitor repository.
        // If the monitor doesn't exist or isn't owned by this user,
        // we return NotFound (same outward result as incident not found).
        self.monitor_repository
            .find_by_id_for_user(incident.monitor_id, user_id)
            .await
            .map_err(AcknowledgeIncidentError::Other)?
            .ok_or(AcknowledgeIncidentError::NotFound)?;

        if incident.resolved_at.is_some() {
            return Err(AcknowledgeIncidentError::AlreadyResolved);
        }

        let now = Utc::now();
        incident.acknowledge(user_id, now);

        self.incident_repository
            .update(&incident)
            .await
            .map_err(AcknowledgeIncidentError::Other)?;

        let entry = AuditLogEntry {
            id: AuditLogEntryId::new(),
            actor_user_id: user_id,
            tenant_id: Some(tenant_id),
            action: AuditAction::IncidentAcknowledged,
            target_id: incident.id.0.to_string(),
            metadata: json!({
                "monitor_id": incident.monitor_id.0.to_string(),
            }),
            created_at: Utc::now(),
        };
        self.audit_log_entry_repository
            .create(&entry)
            .await
            .map_err(AcknowledgeIncidentError::Other)?;

        Ok(incident)
    }
}
</file>

<file path="crates/application/src/use_cases/create_api_flow.rs">
use std::{error::Error, fmt, sync::Arc};

use chrono::Utc;
use serde_json::json;

use crate::{
    dto::{CreateApiFlowRequest, ExtractSourceInput},
    ports::{ApiFlowRepository, AuditLogEntryRepository, IdGenerator},
};
use domain::{
    AuditAction, AuditLogEntry, AuditLogEntryId, ExtractSource,
    entities::{ApiFlow, ApiFlowStep, Assertion},
    shared::types::AuthenticatedUser,
    value_objects::{FlowStepName, VariableExtraction},
};

pub type UseCaseResult<T> = Result<T, Box<dyn Error + Send + Sync>>;

#[derive(Debug)]
pub enum CreateApiFlowError {
    FlowAlreadyExists,
    Other(Box<dyn Error + Send + Sync>),
}

impl fmt::Display for CreateApiFlowError {
    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
        match self {
            Self::FlowAlreadyExists => write!(f, "an api flow already exists for this monitor"),
            Self::Other(err) => write!(f, "{err}"),
        }
    }
}

impl Error for CreateApiFlowError {
    fn source(&self) -> Option<&(dyn Error + 'static)> {
        match self {
            Self::FlowAlreadyExists => None,
            Self::Other(err) => Some(err.as_ref()),
        }
    }
}

pub struct CreateApiFlowUseCase<R, G> {
    repository: R,
    id_generator: G,
    audit_log_entry_repository: Arc<dyn AuditLogEntryRepository>,
}

impl<R, G> CreateApiFlowUseCase<R, G>
where
    R: ApiFlowRepository,
    G: IdGenerator,
{
    pub fn new(
        repository: R,
        id_generator: G,
        audit_log_entry_repository: Arc<dyn AuditLogEntryRepository>,
    ) -> Self {
        Self {
            repository,
            id_generator,
            audit_log_entry_repository,
        }
    }

    pub async fn execute(
        &self,
        request: CreateApiFlowRequest,
        authenticated_user: AuthenticatedUser,
    ) -> Result<ApiFlow, CreateApiFlowError> {
        let existing = self
            .repository
            .find_by_monitor_id(request.monitor_id)
            .await
            .map_err(CreateApiFlowError::Other)?;

        if existing.is_some() {
            return Err(CreateApiFlowError::FlowAlreadyExists);
        }

        self.build_and_save(request, authenticated_user)
            .await
            .map_err(CreateApiFlowError::Other)
    }

    async fn build_and_save(
        &self,
        request: CreateApiFlowRequest,
        authenticated_user: AuthenticatedUser,
    ) -> UseCaseResult<ApiFlow> {
        let user_id = authenticated_user.user_id();
        let tenant_id = authenticated_user.tenant_context().tenant_id();

        let mut steps = Vec::with_capacity(request.steps.len());

        for step_input in request.steps {
            let name =
                FlowStepName::new(step_input.name).map_err(Box::<dyn Error + Send + Sync>::from)?;

            let mut extract = Vec::with_capacity(step_input.extract.len());
            for extraction_input in step_input.extract {
                let source = match extraction_input.source {
                    ExtractSourceInput::StatusCode => ExtractSource::StatusCode,
                    ExtractSourceInput::Header(name) => ExtractSource::Header(name),
                    ExtractSourceInput::JsonPath(path) => ExtractSource::JsonPath(path),
                    ExtractSourceInput::Body => ExtractSource::Body,
                };

                let extraction = VariableExtraction::new(extraction_input.name, source)
                    .map_err(Box::<dyn Error + Send + Sync>::from)?;

                extract.push(extraction);
            }

            let mut assertions = Vec::with_capacity(step_input.assertions.len());
            for input in &step_input.assertions {
                let assertion = Assertion::new(
                    input.response_part.clone(),
                    input.operator.clone(),
                    input.target.clone(),
                    input.expected_value.clone(),
                )
                .map_err(Box::<dyn Error + Send + Sync>::from)?;

                assertions.push(assertion);
            }

            let step = ApiFlowStep::new(
                step_input.order,
                name,
                step_input.method,
                step_input.url_template,
                step_input.headers,
                step_input.body,
                extract,
                assertions,
            )
            .map_err(Box::<dyn Error + Send + Sync>::from)?;

            steps.push(step);
        }

        let id = self.id_generator.next_api_flow_id().await;

        let flow = ApiFlow::new(id, request.monitor_id, tenant_id, steps)
            .map_err(Box::<dyn Error + Send + Sync>::from)?;

        self.repository.save(&flow).await?;

        let entry = AuditLogEntry {
            id: AuditLogEntryId::new(),
            actor_user_id: user_id,
            tenant_id: Some(tenant_id),
            action: AuditAction::ApiFlowCreated,
            target_id: flow.id.0.to_string(),
            metadata: json!({
                "monitor_id": flow.monitor_id.0.to_string(),
                "steps": flow.steps.len(),
            }),
            created_at: Utc::now(),
        };
        self.audit_log_entry_repository.create(&entry).await?;

        Ok(flow)
    }
}
</file>

