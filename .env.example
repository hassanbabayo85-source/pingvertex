# KWAFI wannan fayil zuwa .env sannan a cika ainihin darajoji.
# KADA A TAɓA turo .env na gaske zuwa git/zip/backup.

# Database
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/uptime_monitor

# JWT Secret — ƙirƙira sabon sirri mai ƙarfi da:
#   openssl rand -hex 64
# Dole ya kai akalla haruffa 32, kada ya zama placeholder kamar
# "changeme" ko "secret" — Config::try_from_env() zai ƙi tashi (fail
# closed) idan ya gano irin waɗannan darajoji.
JWT_SECRET=

# Server
PORT=3000

# Metrics — sirrin da Prometheus (ko wani mai scrape) zai turo a header
# "Authorization: Bearer <METRICS_TOKEN>". Idan babu wannan, /metrics
# endpoint zai koma 404 ga kowa (fail-closed). Ƙirƙira: openssl rand -hex 32
METRICS_TOKEN=

# Logging
RUST_LOG=info,tower_http=debug

# --- Notifications (email/webhook alerting) ---
#
# SMTP is OPTIONAL: if you leave SMTP_HOST unset, the app still starts and
# webhook notification channels still work fully — only email channels will
# return an error when triggered (see infra::NotificationDispatcher::from_env
# / infra::DisabledEmailNotificationService). Webhook channels need no
# global config here at all: each one carries its own target URL and a
# signing secret generated for you when you create it.
#
# Any SMTP relay works (Mailgun, Postmark, SES, Gmail App Password, your
# own Postfix, ...) as long as it speaks standard SMTP+STARTTLS.

# SMTP_HOST=smtp.mailgun.org
# SMTP_PORT=587
# SMTP_USERNAME=postmaster@your-domain.mailgun.org
#
# SMTP_PASSWORD must be a real credential from your provider — it is
# checked against a small blocklist of known placeholder values
# (SmtpConfig::try_from_env in crates/infra/src/config.rs), same idea as
# JWT_SECRET's blocklist above.
# SMTP_PASSWORD=
#
# SMTP_FROM_ADDRESS=alerts@your-domain.com
# SMTP_FROM_NAME=Uptime Monitor
#
# Use STARTTLS (port 587, the default/typical case) or implicit TLS
# (port 465, set this to false).
# SMTP_STARTTLS=true
