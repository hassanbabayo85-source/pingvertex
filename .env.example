# KWAFI wannan fayil zuwa .env sannan a cika ainihin darajoji.
# KADA A TAɓA turo .env na gaske zuwa git/zip/backup.

# Database
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/uptime_monitor

# JWT Secret — ƙirƙira sabon sirri mai ƙarfi da:
#   openssl rand -hex 64
# Dole ya kai akalla haruffa 32, kada ya zama placeholder kamar
# "changeme" ko "secret" — Config::try_from_env() zai ƙi tashi (fail
# closed) idan ya gano irin waɗannan darajoji.
JWT_SECRET=

# Server
PORT=3000

# CORS — browser origin (misali dashboard ɗin) da za a ba izinin turo
# credentialed (cookie-carrying) requests zuwa wannan API. Idan babu shi,
# an saita default "http://localhost:3000" (dacewa da local dev). Ba
# sirri ba ne, amma Config::try_from_env() yana tantance shi tun farko
# (fail-closed message mai kyau) kafin a fara startup.
# CORS_ALLOWED_ORIGIN=http://localhost:3000

# Metrics — sirrin da Prometheus (ko wani mai scrape) zai turo a header
# "Authorization: Bearer <METRICS_TOKEN>". Idan babu wannan, /metrics
# endpoint zai koma 404 ga kowa (fail-closed). Ƙirƙira: openssl rand -hex 32
METRICS_TOKEN=

# Logging
RUST_LOG=info,tower_http=debug

# --- Status-page response cache & TOTP pending-auth cache (OPTIONAL) ---
#
# REDIS_URL is OPTIONAL: if unset, the API still starts — status-page
# responses simply always hit Postgres directly instead of a cache
# (see NoopStatusPageCache), and TOTP 2FA enrollment/login will not work
# (see NoopPendingAuthCache in main.rs) since pending secrets/tokens have
# nowhere to be stored.
# REDIS_URL=redis://localhost:6379

# --- Internal-agent mTLS listener (OPTIONAL — has safe defaults) ---
#
# MTLS_PORT: TCP port for the internal-agent mTLS listener. Defaults to
# 3443 if unset.
# MTLS_PORT=3443
#
# MTLS_CA_CERT_PATH / MTLS_SERVER_CERT_PATH / MTLS_SERVER_KEY_PATH:
# filesystem paths to the internal CA cert and this server's own mTLS
# identity, relative to the process's working directory. Default to
# certs/ca/ca-cert.pem, certs/api/server-cert.pem, certs/api/server-key.pem
# respectively — matching what Dockerfile.api COPYs into the image.
# MTLS_CA_CERT_PATH=certs/ca/ca-cert.pem
# MTLS_SERVER_CERT_PATH=certs/api/server-cert.pem
# MTLS_SERVER_KEY_PATH=certs/api/server-key.pem

# --- Notifications (email/webhook alerting) ---
#
# SMTP is OPTIONAL: if you leave SMTP_HOST unset, the app still starts and
# webhook notification channels still work fully — only email channels will
# return an error when triggered (see infra::NotificationDispatcher::from_env
# / infra::DisabledEmailNotificationService). Webhook channels need no
# global config here at all: each one carries its own target URL and a
# signing secret generated for you when you create it.
#
# Any SMTP relay works (Mailgun, Postmark, SES, Gmail App Password, your
# own Postfix, ...) as long as it speaks standard SMTP+STARTTLS.

# SMTP_HOST=smtp.mailgun.org
# SMTP_PORT=587
# SMTP_USERNAME=postmaster@your-domain.mailgun.org
#
# SMTP_PASSWORD must be a real credential from your provider — it is
# checked against a small blocklist of known placeholder values
# (SmtpConfig::try_from_env in crates/infra/src/config.rs), same idea as
# JWT_SECRET's blocklist above.
# SMTP_PASSWORD=
#
# SMTP_FROM_ADDRESS=alerts@your-domain.com
# SMTP_FROM_NAME=Uptime Monitor
#
# Use STARTTLS (port 587, the default/typical case) or implicit TLS
# (port 465, set this to false).
# SMTP_STARTTLS=true

# --- Notifications: SMS (Twilio) (OPTIONAL — integration not yet live) ---
#
# TWILIO_* is OPTIONAL, same reasoning as SMTP_*: leaving it unset just
# means SMS notification channels return an error when triggered. Even
# when set, note that the actual Twilio HTTP send integration is not
# implemented yet (SmsNotificationService always returns an error at
# send time) — this only controls the "is a provider configured at all"
# check. TWILIO_AUTH_TOKEN is checked against a small blocklist of known
# placeholder values (TwilioConfig::try_from_env in
# crates/infra/src/twilio_config.rs), same idea as JWT_SECRET/SMTP_PASSWORD.
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=

# --- Agent (Multi-Region Monitoring) ---
#
# Secret shared by all agents and the central API for /internal/v1.
# Use a strong random value: openssl rand -hex 32
AGENT_SECRET=

# Each agent deployment must set these to identify itself and its region.
# AGENT_REGION must be one of the hard-coded RegionCode values:
#   us-east, eu-west, af-west, ap-southeast
AGENT_ID=agent-us-east-1
AGENT_REGION=us-east

# Base URL of the central API's internal agent endpoints.
# Inside Docker Compose, the API service is reachable at hostname "api".
AGENT_API_BASE_URL=http://api:3000/internal/v1

# mTLS client identity presented by the agent binary when calling
# /internal/v1 (see crates/agent/src/config.rs). OPTIONAL — defaults to
# the sample agent-us-east-1 identity checked into
# certs/agents/agent-us-east-1/, matching what Dockerfile.agent COPYs
# into the image. Override for any agent deployment using a different
# identity/region.
# AGENT_CLIENT_CERT_PATH=certs/agents/agent-us-east-1/client-cert.pem
# AGENT_CLIENT_KEY_PATH=certs/agents/agent-us-east-1/client-key.pem
# AGENT_CA_CERT_PATH=certs/ca/ca-cert.pem

# Path to the MaxMind GeoLite2-Country database the agent uses to tag
# check results with the target's country. OPTIONAL — defaults to
# data/geoip/GeoLite2-Country.mmdb, matching what Dockerfile.agent COPYs
# into the image.
# GEOIP_DB_PATH=data/geoip/GeoLite2-Country.mmdb

# Proxy credential encryption key — 32-byte hex required by
# AesGcmProxyCredentialCipher::try_from_env. Generate: openssl rand -hex 32
PROXY_CREDENTIAL_ENCRYPTION_KEY=

# --- Status-page logo upload (OPTIONAL) ---
#
# If these are not set, the API still starts and status-page logo upload
# will return an error at request time. Set them only if you need logo
# uploads to an S3-compatible service.
# S3_BUCKET=your-bucket
# S3_PUBLIC_BASE_URL=https://your-bucket.s3.amazonaws.com
# S3_ACCESS_KEY_ID=your-access-key
# S3_SECRET_ACCESS_KEY=your-secret-key
# S3_REGION=us-east-1
#
# S3_ENDPOINT: only needed for self-hosted S3-compatible providers
# (MinIO, Garage, ...) — omit for real AWS S3.
# S3_ENDPOINT=https://s3.your-provider.com
#
# S3_PATH_STYLE: path-style addressing (https://endpoint/bucket/key)
# instead of virtual-hosted style. Defaults to true, which is correct
# for most self-hosted S3-compatible providers; set to false for real
# AWS S3 if you rely on virtual-hosted-style URLs.
# S3_PATH_STYLE=true
