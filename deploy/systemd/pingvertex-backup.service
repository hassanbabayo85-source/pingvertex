[Unit]
Description=PingVertex Postgres backup
Wants=network-online.target
After=network-online.target docker.service

[Service]
Type=oneshot
# EDIT WorkingDirectory to your actual deploy path before installing.
WorkingDirectory=/opt/pingvertex/uptime-monitor
ExecStart=/opt/pingvertex/uptime-monitor/scripts/backup.sh /var/backups/pingvertex
User=deploy
